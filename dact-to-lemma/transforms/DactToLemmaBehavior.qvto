query DACT::ParameterMappingType::getCorrespondingParameterMappingType(): BEHA::ParameterMappingType{
	return switch{
		case (self = DACT::ParameterMappingType::ACTION_IN)  BEHA::ParameterMappingType::ACTION_IN;
		case (self = DACT::ParameterMappingType::ACTION_OUT)  BEHA::ParameterMappingType::ACTION_OUT;
		case (self = DACT::ParameterMappingType::ACTIVITY_IN)  BEHA::ParameterMappingType::ACTIVITY_IN;
		case (self = DACT::ParameterMappingType::ACTIVITY_OUT)  BEHA::ParameterMappingType::ACTIVITY_OUT;
	}
}

helper DACT::ActivityGroup::introduceMessageHandlerToRoot(){}

