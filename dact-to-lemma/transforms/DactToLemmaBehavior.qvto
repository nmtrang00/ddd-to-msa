	};
}

helper BEHA::ActivityModel::generateRootControllerActivities(inout model: BEHA::ActivityModel){
	var newActivities: Sequence(BEHA::Activity);	
	model.activities -> forEach(activity){
		activity.printInfo(0);
		newActivities += activity.createActivityForDefaultControllerOperation();
	};
	model.activities += newActivities;
}

query BEHA::Activity::createActivityForDefaultControllerOperation(): BEHA::Activity{
	if (not self.toTransform){
		return null;
	};
	// Get the corresponding Controller and Operation
	var spec := self.specification.oclAsType(BEHA::ImportedInterfaceOperation).operation;
	var serviceInterface := spec.interface;
	var ms := serviceInterface.microservice;
	
	var controller := ms.interfaces 
							-> selectOne(i|i.interfaceType = SERV::InterfaceType::CONTROLLER and (i.name = serviceInterface.name or i.name = serviceInterface.name.replace("Service","Controller")));
	var controllerOp := controller.operations -> selectOne(o|o.name=spec.name);
	
	assert warning (controllerOp <> null)
		with log("Compile Error: Cannot find the matching Controller Operation to process specification!");
	
	log(indent(1)+"Create a new activity for Controller Operation '"+controllerOp.name+"': " );
	serviceInterface.printInfo(1);
	spec.printInfo(2);
	
	controller.printInfo(1);
	controllerOp.printInfo(2);
	
	var newActivity := object BEHA::Activity{
		name := self.name + "Controller";
		specification := object BEHA::ImportedInterfaceOperation{
			_import := SERV_IMPORT;
			operation := controllerOp;
		};
		root := object BEHA::ActivityGroup{scope:=object BEHA::Scope{}};
	};
	
	// New activity params + mappings -> return mapping from new input to the service
	var newActivityMp := controllerOp.createParamsAndMappingsForActivity();
	newActivity.ownedParameters := newActivityMp.activityParameters;
	newActivity.parameterMappings := newActivityMp.mappings;
	
	// Create a new Node to declare response
	var responseParam := controllerOp.parameters -> selectOne(p|p.exchangePattern = TECH::ExchangePattern::OUT);
	var newResponseVariable := object BEHA::Variable {
			name := "responseParam";
			lowerBound := 1;
			upperBound := 1;
	};
	
	newActivity.root.scope.ownedVariables+=newResponseVariable;
	
	var newVariableDeclaration := object BEHA::VariableDeclarationAction{
		name := "declareResponseVariable";
		lowerBound :=1;
		upperBound :=1;
		declaration := object BEHA::VariableAssignment{
			identifier := object BEHA::Identifier {name := "responseParam"};
		};
	};
	
	if (responseParam.primitiveType <> null){
		newResponseVariable.primitiveType := responseParam.primitiveType.deepclone();
		newVariableDeclaration.primitiveType := responseParam.primitiveType.deepclone();	
	}else{
		newResponseVariable.importedType := object SERV::ImportedType{
			_import := DATA_IMPORT;
			type := responseParam.importedType.type;
		};
		newVariableDeclaration.importedType := object SERV::ImportedType{
			_import := DATA_IMPORT;
			type := responseParam.importedType.type;
		}
	};
	
	// Create a new CallOperationAction for the ServiceOperation
	var newCallServiceOpAction := spec.createNewCallOperationAction(newActivityMp.csParamMappings);
	newCallServiceOpAction.domainToDeclareResult := false;
	
	// TODO : Create init node -> call node -> final node : Later add ACL 
	var rootGroup := newActivity.root;
	var initNode := object BEHA::InitialNode{
		name := newActivity.name+"-InitNode";
	};
	var finalNode := object BEHA::ActivityFinalNode{
		name := newActivity.name+"-ActivityFinalNode";
	};
	newActivity.ownedParameters
		->select(p|p.exchangePattern=TECH::ExchangePattern::OUT)
		->forEach(p){
			finalNode.variablesToReturn += object BEHA::Identifier{name:=p.name};
		};
	rootGroup.ownedNodes := Sequence{initNode, newVariableDeclaration, newCallServiceOpAction, finalNode};
	
	Sequence{2..rootGroup.ownedNodes->size()-1} -> forEach(i){		
		rootGroup.ownedEdges+= Sequence{
			object BEHA::ActivityEdge{
				source := rootGroup.ownedNodes -> at(i-1);
				target := rootGroup.ownedNodes -> at(i);	
			},
			object BEHA::ActivityEdge{
				source := rootGroup.ownedNodes -> at(i);
				target := rootGroup.ownedNodes -> at(i+1);	
			}
		};	
	};	
	return newActivity;
}

query SERV::Operation::createParamsAndMappingsForActivity(): Tuple(activityParameters: Sequence(SERV::Parameter), mappings:Sequence(BEHA::ParameterMapping), csParamMappings: Dict(String, String)){
	var activityParameters : Sequence(SERV::Parameter);
	var mappings : Sequence(BEHA::ParameterMapping);
	var csParamMappings: Dict(String, String) := Dict{};
	
	self.parameters -> forEach(p){
		var newOpParameter := object BEHA::ImportedInterfaceParameter{
			_import := SERV_IMPORT;
			parameter := p;
		};
		var newAcParameter := p.deepclone();
		
		activityParameters += newAcParameter;
		
		var newMapping := object BEHA::ParameterMapping{
			operationParameter := newOpParameter;
			activityParameter := newAcParameter;
			type := p.exchangePattern.getCorrespondingParameterMappingType(MAPPING_ACTIVITY);
		};
		
		mappings += newMapping;	
		
		if (p.adapterParameterType = SERV::AdapterParameterType::REQUEST_BODY){
			p.importedType.type.oclAsType(DATA::DataStructure).dataFields->forEach(f){
				csParamMappings -> put(f.name,"requestParam."+f.name);
			}
		}else if (p.adapterParameterType = SERV::AdapterParameterType::RESPONSE_BODY){
			p.importedType.type.oclAsType(DATA::DataStructure).dataFields->forEach(f){
				csParamMappings -> put(f.name,"responseParam."+f.name);
			}
		}else{
			csParamMappings -> put(p.name,p.name);
		}
		;
	};
	
	return Tuple{activityParameters=activityParameters, mappings=mappings, csParamMappings=csParamMappings};
}

query SERV::Operation::createNewCallOperationAction(csParamMapping:Dict(String, String)): BEHA::CallOperationAction{
	return self.createNewCallOperationAction(csParamMapping,SERV_IMPORT); 
}

query SERV::Operation::createNewCallOperationAction(csParamMapping:Dict(String, String),servImport: SERV::Import): BEHA::CallOperationAction{
	var newAction : BEHA::CallOperationAction;
	
	var newParameterMappings : Sequence(BEHA::ParameterMapping);
	self.parameters -> forEach(p){
		var newMapping := object BEHA::ParameterMapping{
			type := p.exchangePattern.getCorrespondingParameterMappingType(MAPPING_ACTION);
			operationParameter := object BEHA::ImportedInterfaceParameter{
				_import := servImport;
				parameter := p;
			};
			identifier := object BEHA::Identifier{
				name:= if csParamMapping -> hasKey(p.name) then csParamMapping->get(p.name) else p.name endif
			};
		};
		newParameterMappings += newMapping;
	};
	var newCallServiceOpAction := object BEHA::CallOperationAction{
		name := self.name;
		importedOperation := object ImportedInterfaceOperation{
			_import := SERV_IMPORT;
			operation := self;
		};
		parameterMappings := newParameterMappings
	};
	return newCallServiceOpAction;
}

query TECH::ExchangePattern::getCorrespondingParameterMappingType(target: String): BEHA::ParameterMappingType{
	return switch{
		case (target = MAPPING_ACTIVITY and self = TECH::ExchangePattern::IN) BEHA::ParameterMappingType::ACTIVITY_IN;
		case (target = MAPPING_ACTIVITY and self = TECH::ExchangePattern::OUT) BEHA::ParameterMappingType::ACTIVITY_OUT;
		case (target = MAPPING_ACTION and self = TECH::ExchangePattern::IN) BEHA::ParameterMappingType::ACTION_IN;
		case (target = MAPPING_ACTION and self = TECH::ExchangePattern::OUT) BEHA::ParameterMappingType::ACTION_OUT;
	}
}