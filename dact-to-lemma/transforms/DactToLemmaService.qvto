import DactUtils;
import StringUtils;
import DactToLemmaUtils;
import DactToLemmaData;

modeltype DACT uses 'http://www.example.org/xcore/dact';
modeltype DATA uses 'http://www.example.org/xcore/data';
modeltype SERV uses 'http://www.example.org/xcore/service';
modeltype TECH uses 'http://www.example.org/xcore/technology';

modeltype ECORE "strict" uses ecore('http://www.eclipse.org/emf/2002/Ecore');

transformation DactToLemmaService(in dact: DACT, in data: DATA, out SERV: SERV);

property PROJECT_NAME : String = "DefaultProject";
property DATA_IMPORT_NAME : String = "DomainData";
property DATA_IMPORT : SERV::Import = null;
property ENDPOINT_CACHE: Sequence(String);

main() {
	
	log("");
	log("----------------------------------------");
	log("3.TRANSFORMING DACT TO LEMMA SERV");
	log("-------------------------------------");
	
	// Generate LEMMA model from DACT and DATA
	log("3.1. Generating LEMMA PIM from preprocessed DACT and generated DATA: Start parsing");
	dact.rootObjects()[DACT::Root].ddd -> map DddModelToServiceModel();
	log("3.1. Generating LEMMA PIM from preprocessed DACT and generated DATA: End parsing");
	log("************************************************");
		
	log("----------------------------------------");
	log("");
}

mapping DACT::DddModel::DddModelToServiceModel() : SERV::ServiceModel {
    var relativePath := "./" + PROJECT_NAME + ".data";
    DATA_IMPORT := object SERV::Import {
        name := DATA_IMPORT_NAME;
        importURI := relativePath; 
        importType := SERV::ImportType::DATATYPES;
    };
	log("New Import created with URI: "+DATA_IMPORT.importURI);
    t_modelUri := PROJECT_NAME;
    imports := Sequence{DATA_IMPORT};
    microservices := self.boundedContexts ->map BoundedContextToMicroservice();
}

mapping DACT::BoundedContext::BoundedContextToMicroservice() : SERV::Microservice {
	self.printInfo(1);
	
	name := self.name;
	if (self.isExternal){
		type := SERV::MicroserviceType::EXTERNAL;
	}else{
		type := SERV::MicroserviceType::FUNCTIONAL;
	};
	visibility := SERV::Visibility::PUBLIC;
	endpoints := object Endpoint{ addresses := "/"+self.name+"-ms"};
	interfaces := self.ownedElements[DACT::Interface] -> map InterfaceToInterface();
	// Reset cache
	ENDPOINT_CACHE := Sequence{};
	interfaces += self.ownedElements[DACT::Service] 
		-> select(s | s.ownedOperations -> exists(o|o.toExpose))
		-> map ServiceToDefaultController();
	// Reset cache
	ENDPOINT_CACHE := Sequence{};
	self.ownedElements[DACT::Repository] -> RepositoryToDefaultController();
}

mapping DACT::Interface::InterfaceToInterface(): SERV::Interface {
	self.printInfo(2);
	
	name := self.name;
	visibility := SERV::Visibility::INTERNAL;
	interfaceType := self.getCorrepsondingInterfaceType();
	operations := self.ownedOperations->map InterfaceOperationToOperation();
}

mapping DACT::Operation::InterfaceOperationToOperation(): SERV::Operation{
	self.printInfo(3);
	
	name := self.name;
	visibility := SERV::Visibility::INTERNAL;
	operationType := self.type.getCorrespondingServiceOperationType();
	parameters := self.ownedParameters -> map ParameterToParameter();
	protocols := object SERV::ProtocolSpecification {
		communicationType := TECH::CommunicationType::SYNCHRONOUS;
		-- TODO: protocol -> Map with the ImportedProtocolAndDataFormat 
	};
	
	if (self.behavior <> null){
		notImplemented := false;
	}else{
		notImplemented := true;
	}
}

mapping DACT::Parameter::ParameterToParameter(): SERV::Parameter{
	self.printInfo(4);
	
	name := self.name;
	exchangePattern := self.direction.getCorrespondingServiceExchangePattern();
	communicationType := TECH::CommunicationType::SYNCHRONOUS;
	if (self.lowerBound = 0 or not self._default.oclIsUndefined()){
		optional := true;
	};
	lowerBound := self.lowerBound;
	upperBound := self.upperBound;
	
	if (self.upperBound = -1 or self.upperBound > 1){
		importedType := self.type.typesToImportedTypeCollection();
	}else{
		if (self.type.oclIsKindOf(DACT::PrimitiveType)){
			primitiveType := self.type.oclAsType(DACT::PrimitiveType).PrimitiveTypetoDataPrimitive();
			if (not self._default.oclIsUndefined() and not self._default.oclIsKindOf(DACT::LiteralNull)){
				initializationValue := self._default.map ValueSpecificationToValueSpecification().oclAsType(DATA::PrimitiveValue);
			}
		}else if (self.type.oclIsKindOf(DACT::DomainObject)){
			importedType := self.type.oclAsType(DACT::DomainObject).domainElementToImportedType();
			-- TODO: Default value for Data Structure
		}else if (self.type.oclIsKindOf(DACT::Enumeration)){
			importedType := self.type.oclAsType(DACT::Enumeration).domainElementToImportedType();
			if (not self._default.oclIsUndefined() and not self._default.oclIsKindOf(DACT::LiteralNull)){
				initializationValue := self._default.map ValueSpecificationToValueSpecification().oclAsType(DATA::PrimitiveValue);
			}
		}
	};
}

mapping DACT::Service::ServiceToDefaultController(): SERV::Interface{
	self.printInfo(2,"Default Controller for Service Operations");
	
	// Create default Controller to expose Domain Service. Support the derivation of sync/async later
	name := if self.name.indexOf("Service") <> -1 then 
            self.name.replace("Service", "Controller") 
        else 
            self.name 
        endif;
    visibility := SERV::Visibility::PUBLIC;
    interfaceType := SERV::InterfaceType::CONTROLLER;
    
    var path := name.toControllerPath();
    
	endpoints := object Endpoint{addresses:=path};
	log(indent(3)+"Endpoint: "+path);
	
	operations := self.ownedOperations 
		->sortedBy(op | op.ownedParameters->size())
		-> map ServiceOperationsToDefaultControllerOperations();
}

helper DACT::Repository::RepositoryToDefaultController(){
	self.printInfo(2,"Default Service for Repository Operations");
	
	var microservice := self.context.resolveoneIn(DACT::BoundedContext::BoundedContextToMicroservice, SERV::Microservice);
	// Service
	var service := microservice.interfaces
							-> selectOne(i|i.interfaceType = SERV::InterfaceType::DOMAIN_SERVICE and (i.name = self.name or i.name = self.name.replace("Repository","Service")));
		
	if (service = null){
		service := object SERV::Interface {
			name := self.name.replace("Repository","Service");
			visibility := SERV::Visibility::INTERNAL;
			interfaceType := SERV::InterfaceType::DOMAIN_SERVICE;
		};
		microservice.interfaces += service;
		log(indent(3) + "[NEW] Create a new service interface:" + service.buildQualifiedName("::"));
	};
	
	// Controller
	var controller := microservice.interfaces
							-> selectOne(i|i.interfaceType = SERV::InterfaceType::CONTROLLER and (i.name = self.name or i.name = self.name.replace("Repository","Controller")));
	if (controller = null){
		controller := object SERV::Interface {
			name := service.name.replace("Service","Controller");
			visibility := SERV::Visibility::PUBLIC;
			interfaceType := SERV::InterfaceType::CONTROLLER;
		};
		microservice.interfaces += controller;
		log(indent(3) + "[NEW] Create a new controller interface:" + controller.buildQualifiedName("::"));
	};
	
	// Map operation
	self.ownedOperations
	 ->sortedBy(op | op.ownedParameters->size())
	 -> forEach(repoOp){
		repoOp.printInfo(3);
		if (not repoOp.isUsedByExternalContext()){
			log(indent(4) + "Repo Operation is not required by external contexts. No further process... ");
			continue;
		};
	
		var serviceOp := service.operations -> selectOne(o|o.name=self.name);
		// Currently bypass name check
		
		if (serviceOp = null){
			var serviceOpParams : Sequence(SERV::Parameter);
			repoOp.ownedParameters -> forEach(p){
				var matchedParam := p.resolveoneIn(DACT::Parameter::ParameterToParameter, SERV::Parameter);
				serviceOpParams += matchedParam.deepclone();
			};
			
			serviceOp := object SERV::Operation {
				name := repoOp.name;
				notImplemented := false;
				operationType := SERV::OperationType::S0_DOMAIN_SERVICE;
				parameters := serviceOpParams;
			};
			service.operations += serviceOp;
			log(indent(4) + "[NEW] Create a new service operation:" + serviceOp.buildQualifiedName("::"));
		};
		
	
		var controllerOp := controller.operations -> selectOne(o|o.name=self.name);
		// Currently bypass name check
		
		if (controllerOp = null){
			var rel := repoOp.deriveOperationTypeAndEndpoint();
			controllerOp := object SERV::Operation {
				name := serviceOp.name;
				notImplemented := false;
				operationType := rel.operationType;
				endpoints := object Endpoint{addresses:=rel.path};
				parameters := repoOp.deriveParameters(rel.pathParams, rel.operationType);
			};
			
			controller.operations += controllerOp;
			log(indent(4) + "[NEW] Create a new controller operation:" + controllerOp.buildQualifiedName("::"));
			log(indent(4)+"Endpoint: "+controllerOp.operationType.toString() + " " +rel.path);
		}
	};
	
}
mapping DACT::Operation::ServiceOperationsToDefaultControllerOperations(): SERV::Operation{
	self.printInfo(3);
	
	name := self.name;
	visibility := SERV::Visibility::PUBLIC;
	
	var rel := self.deriveOperationTypeAndEndpoint();
	
	operationType := rel.operationType;
	endpoints := object Endpoint{addresses:=rel.path};
	log(indent(4)+"Endpoint: "+operationType.toString() + " " +rel.path);
	
	// Create the proper input and output payload here
	parameters := self.deriveParameters(rel.pathParams, rel.operationType);
}

query DACT::Operation::deriveParameters(pathParams: Sequence(String),operationType: SERV::OperationType): Sequence(SERV::Parameter){
	var fParams: Sequence(SERV::Parameter);
	var extraParams : Sequence(SERV::Parameter); // Either query params or to be in the request/response body
	
	// In param
	self.ownedParameters
		-> select(p|p.direction = DACT::ParameterDirection::IN)
		-> forEach(p){
		var mappedServParam := p.resolveoneIn(DACT::Parameter::ParameterToParameter, SERV::Parameter);
		if (pathParams->includes(mappedServParam.name)){
			var controllerParam := mappedServParam.deepclone();
			controllerParam.adapterParameterType := SERV::AdapterParameterType::PATH_PARAM;
			fParams += controllerParam;
		} else{
			extraParams += mappedServParam;
		};
	};
	if (extraParams->size()>0){
		if (operationType = SERV::OperationType::I0_INBOUND_GET){
			// Mark as query param
			extraParams -> forEach(p){
				var controllerParam := p.deepclone();
				controllerParam.adapterParameterType := SERV::AdapterParameterType::QUERY_PARAM;
				fParams += controllerParam;
			};
		}else{
			// Create a new data structure for the request -> Put it in the context of the corresponding context
			var newDataFields : Sequence(DATA::DataField);
			
			extraParams -> forEach(p){
				var newDatafield := object DATA::DataField{
					name := p.name;
					lowerBound := p.lowerBound;
					upperBound := p.upperBound;
				};
				if (p.importedType <> null){
					newDatafield.complexType := p.importedType.type.oclAsType(DATA::ComplexType);
				}else if (p.primitiveType <> null){
					newDatafield.primitiveType := p.primitiveType.deepclone();
				};
				newDataFields += newDatafield;
			};
			
			var newRequestStructure := object DATA::DataStructure{
				name := self.name.toUpperCamel()+"Request";
				dataFields := newDataFields;
				features := DATA::ComplexTypeFeature::REQUEST_PAYLOAD;
			};
			var contextToAdd := self.interface.context.resolveoneIn(DACT::BoundedContext::BoundedContextToContext, DATA::Context);
			contextToAdd.complexTypes += newRequestStructure;
			
			fParams += object SERV::Parameter{
				name := "requestParam";
				exchangePattern := TECH::ExchangePattern::IN;
				communicationType := TECH::CommunicationType::SYNCHRONOUS;
				adapterParameterType := SERV::AdapterParameterType::REQUEST_BODY;
				optional := false;
				lowerBound := 1;
				upperBound := 1;
				importedType := object ImportedType{
					_import := DATA_IMPORT;
					type := newRequestStructure;
				};
			}
		}
	};
	
	// Out param
	var newOutDataFields : Sequence(DATA::DataField);
	self.ownedParameters
		-> select(p|p.direction = DACT::ParameterDirection::OUT)
		-> forEach(p){
			var mappedServParam := p.resolveoneIn(DACT::Parameter::ParameterToParameter, SERV::Parameter);
			var newDatafield := object DATA::DataField{
				name := mappedServParam.name;
				lowerBound := mappedServParam.lowerBound;
				upperBound := mappedServParam.upperBound;
			};
			if (mappedServParam.importedType <> null){
				newDatafield.complexType := mappedServParam.importedType.type.oclAsType(DATA::ComplexType);
			}else if (mappedServParam.primitiveType <> null){
				newDatafield.primitiveType := mappedServParam.primitiveType.deepclone();
			};
			newOutDataFields += newDatafield;
		};
		
	var newResponseStructure := object DATA::DataStructure{
		name := self.name.toUpperCamel()+"Response";
		dataFields := newOutDataFields;
		features := DATA::ComplexTypeFeature::RESPONSE_PAYLOAD;
	};
	var contextToAdd := self.interface.context.resolveoneIn(DACT::BoundedContext::BoundedContextToContext, DATA::Context);
	contextToAdd.complexTypes += newResponseStructure;
			
	fParams += object SERV::Parameter{
			name := "responseParam";
			exchangePattern := TECH::ExchangePattern::OUT;
			communicationType := TECH::CommunicationType::SYNCHRONOUS;
			adapterParameterType := SERV::AdapterParameterType::RESPONSE_BODY;
			optional := false;
			lowerBound := 1;
			upperBound := 1;
			importedType := object ImportedType{
				_import := DATA_IMPORT;
				type := newResponseStructure;
			};
		};
		
	return fParams;
}

query DACT::Operation::deriveOperationTypeAndEndpoint(): Tuple(operationType: SERV::OperationType, path: String, pathParams : Sequence(String)) {
	var domainNode : DACT::DomainNode;
	var defaultResult := Tuple{
		operationType = SERV::OperationType::I2_INBOUND_POST,
		path = "/"+self.name,
		pathParams = Sequence{}
	};
	
	var interface := self.interface;
	
	if (interface.oclIsKindOf(DACT::Service)) {
		var activity := self.behavior.oclAsType(DACT::Activity);
		
		-- Null guard on activity
		if (activity = null) {
			return defaultResult;
		};
	
		-- Retrieve the node using your global/collection query
		domainNode := activity.getMostInfluentialDomainNode();
	} else if (interface.oclIsKindOf(DACT::Repository)){
		domainNode := self.getDomainNode();
	};	
	
	-- Null guard on domainNode
	if (domainNode = null) {
		return defaultResult;
	};
	
	-- Dispatch by Node Type
	var operationType  := SERV::OperationType::I2_INBOUND_POST;
	if (domainNode.oclIsKindOf(DACT::DomainFindAction)) {
		operationType := SERV::OperationType::I0_INBOUND_GET;
	} else if (domainNode.oclIsKindOf(DACT::DomainDeleteAction)) {
		operationType :=  SERV::OperationType::I3_INBOUND_DELETE;
	} else if (domainNode.oclIsKindOf(DACT::DomainCreateAction)) {
		-- TODO: Derive the difference between POST and PUT later
		operationType := SERV::OperationType::I2_INBOUND_POST;
	};

	-- Derive path
	var pp := domainNode.deriveEndpointPath();
	var path := pp.path;
	if (ENDPOINT_CACHE -> includes(operationType.toString()+path)){
		path := "/" + self.name;
	}else{
		ENDPOINT_CACHE += (operationType.toString()+path);
	};
	
	-- Default fallback for any remaining cases
	return Tuple{operationType = operationType, path = path, pathParams = pp.pathParams};
}

query DACT::DomainNode::deriveEndpointPath(): Tuple(path:String,pathParams:Sequence(String)){
	
	var path : String;
	var propertyChain := self.propertyChain -> asSequence();
	var pathParts : Sequence(String);
	var pathParams : Sequence(String);
	
	
	if (propertyChain -> size() > 0){
		// Add the Aggregate Id first if not Aggregate query
		var aggregateId := self.aggregate.ownedProperties -> selectOne(p | p.definesIdentity);
		pathParts += "{" + aggregateId.name + "}";
		pathParams += aggregateId.name;
		
		// Process main
		propertyChain 
			-> subSequence(1, propertyChain->size()-1)
			-> forEach(p){
				p.printInfo(0);
				pathParts += p.name;
				if (p.isCollection()){
					var currentEntity := p.type.oclAsType(DACT::Entity);
					var currentEntityId := currentEntity.ownedProperties -> selectOne(ep | ep.definesIdentity);
					pathParts += "{" + currentEntityId.name + "}";
					pathParams += currentEntityId.name ;
				}
			};
		
		// Add the last property
		pathParts += propertyChain->at(propertyChain->size()).name;
	};
	
	// Add supporting Id if needed for the last property	
	var targetEntity : DACT::DomainObject := if self.entity <> null then self.entity else self.aggregate endif;
	var targetEntityId := targetEntity.ownedProperties -> selectOne(ep | ep.definesIdentity);
	
	if (self.oclIsKindOf(DACT::DomainFindAction)){
		if (self.mainExpr->size()=1){
			var mainExpr := self.mainExpr -> at(1);
			var leftExpr := mainExpr.oclAsType(DACT::BinaryExpression).leftExpr;
			var identifierName := leftExpr.oclAsType(DACT::UnaryExpression).identifier.name.replace("self.","");
			if (identifierName = targetEntityId.name){
				pathParts += "{" + targetEntityId.name + "}";
				pathParams += targetEntityId.name;
			};
		};
		if (self.oclIsKindOf(DACT::DomainExistAction)){
			pathParts += "exists";
		}
	}else if (self.oclIsKindOf(DACT::DomainUpdateAction) or self.oclIsKindOf(DACT::DomainDeleteAction)){
		pathParts += "{" + targetEntityId.name + "}";
		pathParams += targetEntityId.name;
	};
	
	
	if (pathParts -> size() = 0){
		path := "";
	} else {
		pathParts -> forEach(p){
			path := path + "/" + p;
		};
	};
	
	return Tuple{path=path,pathParams=pathParams};
}

//query DACT::DomainNode

query DACT::OperationType::getCorrespondingServiceOperationType(): SERV::OperationType{
    var literalName : String = self.toString();
    
    return SERV::OperationType.oclAsType(ecore::EEnum).getEEnumLiteral(literalName).instance
        .oclAsType(SERV::OperationType);
}

query DACT::ParameterDirection::getCorrespondingServiceExchangePattern(): TECH::ExchangePattern{
	return switch{
		case (self = DACT::ParameterDirection::IN) TECH::ExchangePattern::IN;
		case (self = DACT::ParameterDirection::OUT) TECH::ExchangePattern::OUT;
	}
}


query DACT::Interface::getCorrepsondingInterfaceType():  SERV::InterfaceType {
	return switch {
		case (self.oclIsKindOf(DACT::Repository)) SERV::InterfaceType::REPOSITORY;
		case (self.oclIsKindOf(DACT::Service)) SERV::InterfaceType::DOMAIN_SERVICE;	
	}
}

helper DACT::DomainElement::domainElementToImportedType(): SERV::ImportedType{
	return object SERV::ImportedType{
		_import := DATA_IMPORT;
		type := self.map DomainElementToComplexType();
	};
}

helper DACT::Type::typesToImportedTypeCollection(): SERV::ImportedType{
	return null;
}

helper DACT::PrimitiveType::typesToImportedTypeCollection(): SERV::ImportedType{
	return object SERV::ImportedType{
		_import := DATA_IMPORT;
		type := self.map PrimitiveTypesToPrimitiveTypeCollection();
	};
}

helper DACT::DomainObject::typesToImportedTypeCollection(): SERV::ImportedType{
	return object SERV::ImportedType{
		_import := DATA_IMPORT;
		type := self.map DomainElementsToComplexTypeCollection();
	};
}

helper DACT::Enumeration::typesToImportedTypeCollection(): SERV::ImportedType{
	return object SERV::ImportedType{
		_import := DATA_IMPORT;
		type := self.map DomainElementsToComplexTypeCollection();
	};
}

-- Derive Controller Interface Endpoint Path
helper String::toControllerPath(): String {
    var cleanName := self.replace("DomainService", "")
                        .replace("Service", "")
                        .replace("Controller", "");
    
    -- Converts "CustomerOrder" to "customer-orders"
    return "/" + cleanName.toKebabCase(); 
}


