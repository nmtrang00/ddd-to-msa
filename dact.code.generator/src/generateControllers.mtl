[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateControllers(
	'http://www.example.org/xcore/data',
	'http://www.example.org/xcore/service',
	'http://www.example.org/xcore/behavior',
	'http://www.example.org/xcore/technology'
)/]

[import stringUtils/]
[import lemmaUtils/]
[import lemmaDataTypeTemplates/]
[import lemmaBehaviorTemplates/]

[comment @main/]
[template public generateControllers(behaviorModel : behavior::BehaviorModel)]
[let serviceModel = behaviorModel.getServiceModel().oclAsType(service::ServiceModel), dataModel = behaviorModel.getDataModel().oclAsType(data::DataModel)]
[for (microservice : service::Microservice | serviceModel.microservices)]
  	[let serviceName : String = microservice.name.toCamelCase(), 
  		interfaceDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/controller/']
    [for (interface: service::Interface | microservice.interfaces -> select(i|i.isController()))]
      	  [let filePath: String = interfaceDir + interface.name.toUpperFirst()+'.java']
		  [interface.generateController(behaviorModel.activityModel,filePath, serviceName)/]
		  [/let]
	[/for]
	[let filePath: String = interfaceDir + 'HealthController.java']
	[microservice.generateHealthController(filePath,serviceName)/]
	[/let]
	[/let]
[/for]
[/let]
[/template]


[template public generateController(
	interface : service::Interface, 
	activityModel : behavior::ActivityModel,
	filePath: String, 
	serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
[let typesToImport : Sequence(data::Type) = interface.getDomainObjectsToImport(),
	interfacesToImport: OrderedSet(service::Interface) = interface.getInterfacesToImport(activityModel)->asSet()
]
  package com.example.[serviceName/].controller;
  
  import com.example.[serviceName/].domain.*;
  import com.example.[serviceName/].payload.*;
  import com.example.[serviceName/].exception.*;
  
  [for (intefaceToImport | interfacesToImport)]
    import com.example.[serviceName/].[intefaceToImport.getImportDir()/].[intefaceToImport.name.toUpperFirst()/];
  [/for]
  [if (interface.hasCollectionTypeParameter())]
    import java.util.List;
  [/if]
  
  import org.springframework.http.HttpStatus;
  import org.springframework.http.ResponseEntity;

  import org.springframework.http.HttpStatus;
  import org.springframework.http.ResponseEntity;
  import org.springframework.web.bind.annotation.CrossOrigin;
  import org.springframework.web.bind.annotation.DeleteMapping;
  import org.springframework.web.bind.annotation.GetMapping;
  import org.springframework.web.bind.annotation.PathVariable;
  import org.springframework.web.bind.annotation.PostMapping;
  import org.springframework.web.bind.annotation.PutMapping;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RestController;
  import org.springframework.web.bind.annotation.RequestBody;

  import jakarta.validation.Valid;
  import lombok.RequiredArgsConstructor;
  import lombok.extern.slf4j.Slf4j;

  @CrossOrigin(origins = "*", maxAge = 3600)
  @RequestMapping("/[serviceName/]")
  @RestController
  @Slf4j
  @RequiredArgsConstructor
  public class [interface.name.toUpperFirst()/] {
[for (interfaceToImport | interfacesToImport)]
     private final [interfaceToImport.name.toUpperFirst()/] [interfaceToImport.name.toLowerFirst()/];
[/for]

[for (op : service::Operation | interface.operations)]
      [op.generateOperationAnnotation()/]
      [op.generateControllerOperation().toSingleLine()/]{
	  [let activity : behavior::Activity = op.getActivity(activityModel)]
      [if (activity != null)]
          // Activity: [activity.name/]      
          [ activity.generateMethodBody()/]
	  [else]
          // WARNING: Activity for this service has not been specified!
          [op.generateDefaultMethodBody()/]
	  [/if]
	  [/let]
	      };
	  
[/for]
  }
[/let]
[/file]
[/template]

[query public generateOperationAnnotation(op: service::Operation):String = 
	if op.operationType = service::OperationType::I0_INBOUND_GET then '@GetMapping("'+op.getEndpoint()+'")'
	else if op.operationType = service::OperationType::I1_INBOUND_PUT then '@PutMapping("'+op.getEndpoint()+'")'
	else if op.operationType = service::OperationType::I2_INBOUND_POST then '@PostMapping("'+op.getEndpoint()+'")'
	else if op.operationType = service::OperationType::I3_INBOUND_DELETE  then '@DeleteMapping("'+op.getEndpoint()+'")'
	else ''
	endif endif endif endif
/]

[query public generateControllerOperation(op: service::Operation): String = 
  'public ' + op.generateOperationOutParam() + ' ' + op.name + '(' +op.generateControllerOperationInputParams() + ')'
/]

[query public generateControllerOperationInputParams(op : service::Operation) : String =
  op.getInParams()
    ->collect(p | p.generateParameterAnnotation() + ' ' + p.generateParameterType() + ' ' + p.name)
    ->sep(', ')
    ->toString()
/]
[query public generateParameterAnnotation(p:service::Parameter): String =
	if p.adapterParameterType = service::AdapterParameterType::PATH_PARAM then '@PathVariable'
	else if p.adapterParameterType = service::AdapterParameterType::REQUEST_BODY then '@Valid @RequestBody'
	else ''
	endif endif
/]

[template public generateHealthController(
	service: service::Microservice,
	filePath: String, 
	serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].controller;

  import java.util.HashMap;
  import java.util.Map;

  import org.springframework.http.ResponseEntity;
  import org.springframework.web.bind.annotation.GetMapping;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RestController;

  @RestController
  @RequestMapping("/health")
  public class HealthController {

      @GetMapping
      public ResponseEntity<?> healthCheck() {
          Map<String, Object> response = new HashMap<>();
          response.put("status", "UP");
          response.put("service", "[serviceName.toUpperFirst()/] Service");
          response.put("timestamp", System.currentTimeMillis());
          
          return ResponseEntity.ok(response);
      }
  }
[/file]
[/template]
