[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateDomainObjects('http://www.example.org/xcore/data',
'http://www.example.org/xcore/service',
'http://www.example.org/xcore/behavior')/]

[import stringUtils/]
[import lemmaUtils/]
[import lemmaExprTemplates/]

[comment @main/]
[template public generateDomainObjects(dataModel: data::DataModel,serviceModel: service::ServiceModel)]
[for (context : data::Context | dataModel.getInternalFunctionalContexts(serviceModel))]
  	[let serviceName : String = context.name.toCamelCase(), 
  		domainDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/domain/']
    [for (complexType: data::ComplexType | context.complexTypes -> select(t|t.isDomainObject()))]
      	  [let filePath: String = domainDir + complexType.name.toUpperFirst()+'.java']
		  [if (complexType.oclIsTypeOf(data::Enumeration))]
		    	[complexType.oclAsType(data::Enumeration).generateEnumeration(filePath, serviceName)/]
		  [elseif (complexType.oclIsTypeOf(data::DataStructure))]
      			[if (complexType.oclAsType(data::DataStructure).isEntity())]
		 			[complexType.oclAsType(data::DataStructure).generateEntity(filePath, serviceName)/]
		 		[else]
       				[complexType.oclAsType(data::DataStructure).generateDataObject(filePath, serviceName)/]
		 		[/if]
		  [else]
		        [comment Default fallback /]
		  [/if]
		  [/let]
	[/for]
	[/let]
[/for]
[/template]

[comment -- Specific template for Enumeration --/]
[template public generateEnumeration(e : data::Enumeration,filePath: String,serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].domain;
  //Autogenerated code for Enumeration: [e.name/]
  
  public enum [e.name/] {
  [for (eLiteral : data::EnumerationField | e.fields)]
      [eLiteral.name/],
  [/for]
  }
[/file]
[/template]

[comment -- Specific template for DataStructure --/]
[template public generateEntity(d : data::DataStructure,filePath: String, serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].domain;
  //Autogenerated code for Entity: [d.name.toUpperFirst()/]
  
  import jakarta.persistence.Entity;
  import jakarta.persistence.Column;
  import jakarta.persistence.Table;
  import jakarta.persistence.GeneratedValue;
  import jakarta.persistence.GenerationType;
  import jakarta.persistence.Id;
[if (d.hasCollectionField() or d.hasEntityField())]
  import jakarta.persistence.JoinColumn;
[/if]
[if (d.hasCollectionField())]
  import jakarta.validation.constraints.Size;
[/if]
[if (d.hasEnumCollectionField() or d.hasPrimitiveCollectionField())]
  import jakarta.persistence.ElementCollection;
  import jakarta.persistence.CollectionTable;
[/if]
[if (d.hasEntityCollectionField())]
  import jakarta.persistence.OneToMany;
[/if]
[if (d.hasEntityField())]
  import jakarta.persistence.ManyToOne;
[/if]
[if (d.hasEntityCollectionField() or d.hasEntityField())]
  import jakarta.persistence.CascadeType;
[/if]
[if (d.hasEnumerationField())]
  import jakarta.persistence.Enumerated;
  import jakarta.persistence.EnumType;
[/if]
[if (d.hasDataObjectField())]
  import jakarta.persistence.Embedded;
  import jakarta.persistence.AttributeOverrides;
  import jakarta.persistence.AttributeOverride;
[/if]
  import jakarta.persistence.PrePersist;
  import jakarta.persistence.PreUpdate;
  import lombok.AllArgsConstructor;
  import lombok.Builder;
  import lombok.Data;
  import lombok.NoArgsConstructor;
[if (d.hasUUIDId())]
  import java.util.UUID;
[/if]
[if (d.hasCollectionField())]
  import java.util.Set;
[/if]
  
  @Entity
  @Table(name = "[d.name.toUpperFirst()/]")
  @Data
  @Builder
  @NoArgsConstructor
[if (d.dataFields -> size() > 0)]
  @AllArgsConstructor
[/if]
  public class [d.name.toUpperFirst()/] {
[let idField : data::DataField = d.getIdField()]
[for (field: data::DataField | d.dataFields->sortedBy(f | 
    if f.features->includes(data::DataFieldFeature::IDENTIFIER) then 0 else 1 endif
))]
[if (field.features -> includes(data::DataFieldFeature::IDENTIFIER)) ]
[comment ID Datafield/]
    @Id
[if (field.primitiveType.oclIsKindOf(data::PrimitiveInteger))]
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(nullable = false)
    private Long [field.name/];
[else]
    @GeneratedValue(strategy = GenerationType.AUTO)
    @Column(columnDefinition = "BINARY(16)", nullable = false)
    private UUID [field.name/];
[/if]
[elseif (field.primitiveType <> null)]
[comment Primitive Datafield/]
[field.generateNullable()/]
    private [field.primitiveType.toJavaType()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::Enumeration))]
[comment Enumeration Datafield/]
    @Enumerated(EnumType.STRING)
[field.generateNullable()/]
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::CollectionType))]
[comment Collection Datafield/]
[let col : data::CollectionType = field.complexType.oclAsType(data::CollectionType)]
[if (col.primitiveType <> null)]
  [comment Collection of PrimitiveType/]
    @ElementCollection
    @CollectionTable(name = "[d.name/]_[field.name/]", joinColumns = @JoinColumn(name = "[idField.name/]"))
    @Column(name = "[field.name/]")
[field.generateSize()/]
    private Set<[col.primitiveType.toJavaType()/]> [field.name/];
[elseif (col.dataFields <> null)]
[let colField : data::DataField = col.dataFields -> first()]
[if (colField.complexType.oclIsKindOf(data::Enumeration))]
  [comment Collection of Enum/]
    @ElementCollection(targetClass = [field.complexType.name/].class)
    @CollectionTable(name = "[d.name/]_[field.name/]", joinColumns = @JoinColumn(name = "[idField.name/]"))
    @Column(name = "[field.name/]")
    @Enumerated(EnumType.STRING)
[field.generateSize()/]
    private Set<[field.complexType.name.toUpperFirst()/]> [field.name/];
[elseif (colField.complexType.oclIsKindOf(data::DataStructure))]
[if (colField.complexType.oclAsType(data::DataStructure).isEntity())]
  [comment Collection of Entity]]/]
    @OneToMany(cascade = CascadeType.ALL, orphanRemoval = true)
    @JoinColumn(name = "[colField.complexType.oclAsType(data::DataStructure).getIdField().name/]")
[field.generateSize()/]
    private Set<[field.complexType.name.toUpperFirst()/]> [field.name/];
[else]
  [comment Collection of DataObject/]
    @ElementCollection // Declares a collection of embeddables
    @CollectionTable(name = "[d.name/]_[field.name/]", joinColumns = @JoinColumn(name = "[idField.name/]"))
[field.generateSize()/]
    @AttributeOverrides({
    [for (prop : data::DataField | colField.complexType.oclAsType(data::DataStructure).dataFields)]
       @AttributeOverride(name = "[prop.name/]", column = @Column(name = "[field.name/]_[prop.name/]")),
    [/for]})
    private Set<[field.complexType.name.toUpperFirst()/]> [field.name/];
[/if]
[/if]
  [comment Collection of Collection -> NOT SUPPORTED/]
[/let]
[/if]
[/let]
[comment DataStructure Datafield/]
[elseif (field.complexType.oclIsKindOf(data::DataStructure))]
[if (field.complexType.oclAsType(data::DataStructure).isEntity())]
  [comment Entity: : Need to specify uniqueness in source model later if want to distinguish OneToOne and ManyToOne]/]
    @ManyToOne(cascade = CascadeType.ALL)
    @JoinColumn(name = "[field.complexType.oclAsType(data::DataStructure).getIdField().name/]")
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[else]
  [comment DataObject/]
    @Embedded
    @AttributeOverrides({
      [for (prop : data::DataField | field.complexType.oclAsType(data::DataStructure).dataFields)]
          @AttributeOverride(name = "[prop.name/]", column = @Column(name = "[field.name/]_[prop.name/]")),
      [/for]
    })
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[/if]
[/if]

[/for]
[/let]
[comment d.generateDefaultTrackingProperty()/]

[if (d.requiresValidation())]
  @PreUpdate
  @PrePersist
  [d.generateInvariantOperation() /]
 [/if]
  }
[/file]
[/template]


[template public generateDataObject(d : data::DataStructure,filePath: String, serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].domain;
  //Autogenerated code for DataObject: [d.name.toUpperFirst()/]
    
  import jakarta.persistence.Embeddable;
  import jakarta.persistence.Column;
[if (d.hasEnumerationField())]
  import jakarta.persistence.Enumerated;
  import jakarta.persistence.EnumType;
[/if]
[if (d.hasCollectionField() or d.hasEntityField())]
  import jakarta.persistence.JoinColumn;
[/if]
[if (d.hasEntityCollectionField())]
  import jakarta.persistence.OneToMany;
[/if]
[if (d.hasEntityField())]
  import jakarta.persistence.ManyToOne;
[/if]
[if (d.hasDataObjectField())]
  import jakarta.persistence.Embedded;
  import jakarta.persistence.AttributeOverrides;
  import jakarta.persistence.AttributeOverride;
[/if]
[if (d.hasEnumCollectionField() or d.hasPrimitiveCollectionField())]
  import jakarta.persistence.ElementCollection;
  import jakarta.persistence.CollectionTable;
[/if]
  import lombok.AllArgsConstructor;
  import lombok.Data;
  import lombok.NoArgsConstructor;
  import jakarta.persistence.PrePersist;
  import jakarta.persistence.PreUpdate;
  
  @Embeddable
  @Data
  @NoArgsConstructor
  @AllArgsConstructor
  public class [d.name.toUpperFirst()/] {
[for (field: data::DataField | d.dataFields)]
[if (field.primitiveType <> null)]
[comment Primitive Datafield/]
[field.generateNullable()/]
    private [field.primitiveType.toJavaType()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::Enumeration))]
[comment Enumeration Datafield/]
    @Enumerated(EnumType.STRING)
[field.generateNullable()/]
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::CollectionType))]
[comment Collection Datafield : NOT SUPPORTED NOW as it requries the conversion of DataObject to weak entity/]
[elseif (field.complexType.oclIsKindOf(data::DataStructure))]
[comment DataStructure Datafield/]
[if (field.complexType.oclAsType(data::DataStructure).isEntity())]
  [comment Entity: : Need to specify uniqueness in source model later if want to distinguish OneToOne and ManyToOne]/]
    @ManyToOne
    @JoinColumn(name = "[field.complexType.oclAsType(data::DataStructure).getIdField().name/]")
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[else]
  [comment DataObject/]
    @Embedded
    @AttributeOverrides({
      [for (prop : data::DataField | field.complexType.oclAsType(data::DataStructure).dataFields)]
          @AttributeOverride(name = "[prop.name/]", column = @Column(name = "[field.name/]_[prop.name/]")),
      [/for]
    })
    private [field.complexType.name.toUpperFirst()/] [field.name/];
[/if]
[/if]

[/for]
[comment d.generateDefaultTrackingProperty() /]
[if (d.requiresValidation())]
  @PreUpdate
  @PrePersist
  [d.generateInvariantOperation() /]
[/if]
    }
[/file]
[/template]

[template public generateNullable(f : data::DataField)]
  [if (f.lowerBound = 0)]
      @Column(nullable = true)
  [else]
      @Column(nullable = false)
  [/if]
[/template]

[template public generateSize(f : data::DataField)]
    @Size(min = [f.lowerBound/][if (f.upperBound>1)], max = [f.upperBound/][/if])
[/template]

[template public generateDefaultTrackingProperty(d : data::DataStructure)]
    @Column(name = "createdAt", updatable = false)
    private LocalDateTime createdAt;
    
    @Column(name = "updatedAt")
    private LocalDateTime updatedAt;
    
    @PrePersist
    protected void onCreate() {
[if (d.requiresValidation())]
        this.validate();   
[/if]
        createdAt = LocalDateTime.now();
        updatedAt = LocalDateTime.now();
    }
    
    @PreUpdate
    protected void onUpdate() {
[if (d.requiresValidation())]
        this.validate();   
[/if]
        updatedAt = LocalDateTime.now();
    }
[/template]

[template public generateInvariantOperation(d: data::DataStructure)]
    public void validate(){
[let inv : behavior::SpecDataOperation = d.getInvariantOperation()][if (inv <> null)]
[for (rule | inv.ownedRules)]
[let exprString: String = rule.expr.generateExpression().toSingleLine()]
        if (!([exprString/])) {
           throw new IllegalArgumentException("Violating rule '[rule.name/]'");
         }
[/let]
[/for]
[/if][/let]
[comment Validate the child DataObject /]
[for (f | d.dataFields)]
[if (f.requiresValidation())]
        if (this.[f.name/] != null) {
            this.[f.name/].validate();
        }
[/if]
[/for]
    }
[/template]
