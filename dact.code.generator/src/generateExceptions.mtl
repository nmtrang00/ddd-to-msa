[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateExceptions('http://www.example.org/xcore/data',
'http://www.example.org/xcore/service'
)/]

[import stringUtils/]
[import lemmaUtils/]

[comment @main/]
[template public generateExceptions(dataModel: data::DataModel, serviceModel: service::ServiceModel)]
[for (context : data::Context | dataModel.getInternalFunctionalContexts(serviceModel))]
  	[let serviceName : String = context.name.toCamelCase(), 
  		domainDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/exception/']
    [comment Generate Domain Exception /]
    [for (complexType: data::ComplexType | context.complexTypes -> select(t|t.isException()))]
      	  [let filePath: String = domainDir + complexType.name.toUpperFirst()+'.java']
          [if (complexType.isNotFoundException())]
          [complexType.oclAsType(data::DataStructure).generateNotFoundException(filePath, serviceName)/]
		  [else]
		  [complexType.oclAsType(data::DataStructure).generateDefaultException(filePath, serviceName)/]      
      	  [/if]
		  [/let]
	[/for]
	[comment Generate default message response template /]
	[let filePath: String = domainDir +'GlobalExceptionHandler.java']
		[context.generateGlobalExceptionHandler(filePath, serviceName)/]
	[/let]
	[/let]
[/for]
[/template]

[comment -- Specific template for General Runtime Exception --/]
[template public generateDefaultException(e : data::DataStructure,filePath: String,serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].exception;
  //Autogenerated code for Exception: [e.name.toUpperFirst()/]
  
  public class [e.name.toUpperFirst()/] extends RuntimeException {
      public [e.name.toUpperFirst()/]() {
          super("[e.getExceptionDescription()/]");
      }
  }
[/file]
[/template]

[comment -- Specific template for Entity Not Found Exception --/]
[template public generateNotFoundException(e : data::DataStructure,filePath: String,serviceName: String)]
[file (filePath, overwrite, 'UTF-8')][let entity : data::DataStructure = e.dataFields->select(f|f.name='entity')->first().complexType.oclAsType(data::DataStructure)] 
package com.example.[serviceName/].exception;
//Autogenerated code for Exception: [e.name/]
  
[if (entity.hasUUIDId())]import java.util.UUID;[/if]

import jakarta.persistence.EntityNotFoundException;
  
public class [e.name.toUpperFirst()/] extends EntityNotFoundException {
    public [e.name.toUpperFirst()/]() {
          super("[e.getExceptionDescription()/]");
    }
}
[/let][/file]
[/template]

[template public generateGlobalExceptionHandler(context: data::Context, filePath: String, serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].exception;

  import com.example.[serviceName/].payload.MessageResponse;
  
  import org.springframework.http.MediaType;
  import org.springframework.http.HttpStatus;
  import org.springframework.http.ResponseEntity;
  import org.springframework.web.bind.annotation.ControllerAdvice;
  import org.springframework.web.bind.annotation.ExceptionHandler;
  import org.springframework.web.client.HttpClientErrorException;
  import org.springframework.dao.InvalidDataAccessApiUsageException;
  
  @ControllerAdvice
  public class GlobalExceptionHandler {
[for (complexType: data::ComplexType | context.complexTypes -> select(t|t.isException()))]
[if (complexType.isNotFoundException())]
[complexType.oclAsType(data::DataStructure).generateEntityNotFoundExceptionHandler()/]
[else]
[complexType.oclAsType(data::DataStructure).generateDefaultExceptionHandler()/]
[/if]

[/for]
[context.generateHttpClientErrorException()/]
[context.generateBadRequestExceptionHandler()/]
  }
[/file]
[/template]

[template public generateDefaultExceptionHandler(e: data::DataStructure)]
    @ExceptionHandler([e.name.toUpperFirst()/].class)
        public ResponseEntity<MessageResponse> handleAdmissionRangeException([e.name.toUpperFirst()/] ex) {
            MessageResponse errorResponse = new MessageResponse(
                "BAD_REQUEST",
                false,
                ex.getMessage()
            );
            return new ResponseEntity<>(errorResponse, HttpStatus.BAD_REQUEST);
        }
[/template]

[template public generateEntityNotFoundExceptionHandler(e: data::DataStructure)]
    @ExceptionHandler([e.name.toUpperFirst()/].class)
        public ResponseEntity<MessageResponse> handleNotFoundException([e.name.toUpperFirst()/] ex) {
            MessageResponse errorResponse = new MessageResponse(
                "NOT_FOUND",
                false,
                ex.getMessage()
            );
            return new ResponseEntity<>(errorResponse, HttpStatus.NOT_FOUND);
        }
[/template]

[template public generateHttpClientErrorException(context: data::Context)]
    @ExceptionHandler(HttpClientErrorException.class)
    public ResponseEntity<String> handleHttpClientErrorException(HttpClientErrorException ex) {
            return ResponseEntity
                .status(ex.getStatusCode())
                .contentType(MediaType.APPLICATION_JSON)
                .body(ex.getResponseBodyAsString());
    }
[/template]

[template public generateBadRequestExceptionHandler(context: data::Context)]
    @ExceptionHandler(IllegalArgumentException.class)
    public ResponseEntity<MessageResponse> handleIllegalArgumentException(IllegalArgumentException ex) {
        MessageResponse errorResponse = new MessageResponse(
            "BAD_REQUEST",
            false,
            ex.getMessage()
        );
        return new ResponseEntity<>(errorResponse, HttpStatus.BAD_REQUEST);
    }

    @ExceptionHandler(InvalidDataAccessApiUsageException.class)
    public ResponseEntity<MessageResponse> handleInvalidDataAccessApiUsageException(InvalidDataAccessApiUsageException ex) {
         MessageResponse errorResponse = new MessageResponse(
             "BAD_REQUEST",
             false,
             ex.getMessage()
         );
         return new ResponseEntity<>(errorResponse, HttpStatus.BAD_REQUEST);
    }
[/template]
