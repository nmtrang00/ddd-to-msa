[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateOutboundAdapters(
	'http://www.example.org/xcore/data',
	'http://www.example.org/xcore/service',
	'http://www.example.org/xcore/behavior',
	'http://www.example.org/xcore/technology'
)/]

[import stringUtils/]
[import lemmaUtils/]
[import lemmaBehaviorTemplates/]

[comment @main/]
[template public generateOutboundAdapters(behaviorModel : behavior::BehaviorModel)]
[let serviceModel = behaviorModel.getServiceModel().oclAsType(service::ServiceModel), dataModel = behaviorModel.getDataModel().oclAsType(data::DataModel)]
[for (microservice : service::Microservice | serviceModel.microservices)]
  	[let serviceName : String = microservice.name.toCamelCase(), 
  		interfaceDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/outboundAdapter/']
    [for (interface: service::Interface | microservice.interfaces -> select(i|i.isOutboundAdapter()))]
      	  [let filePath: String = interfaceDir + interface.name.toUpperFirst()+'.java']
		  [interface.generateOutboundAdapter(behaviorModel.activityModel,filePath, serviceName)/]
		  [/let]
	[/for]
	[/let]
[/for]
[/let]
[/template]


[template public generateOutboundAdapter(
	interface : service::Interface, 
	activityModel : behavior::ActivityModel,
	filePath: String, 
	serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
[let remoteMs : String = interface.name.replace('OutboundAdapter','').toLower()]
  package com.example.[serviceName/].outboundAdapter;
  //Autogenerated code for OutboundAdapter: [interface.name/]
  
  [comment Fix to import only the used one later /]
  import com.example.[serviceName/].payload.*;
  import com.example.[serviceName/].domain.*;
  
  import lombok.extern.slf4j.Slf4j;
  import org.springframework.stereotype.Component;
  import org.springframework.beans.factory.annotation.Value;
  import org.springframework.web.client.RestTemplate;
  import org.springframework.web.client.HttpClientErrorException;
  
  @Component
  @Slf4j
  public class [interface.name.toUpperFirst()/] {
      
      private final RestTemplate restTemplate = new RestTemplate();
      @Value("${services.[remoteMs/].url}") private String [remoteMs/]Url;
      
[for (op : service::Operation | interface.operations)]
      [op.generateOperation().toSingleLine()/]{
	  [let activity : behavior::Activity = op.getActivity(activityModel)]
          // Activity: [activity.name/]      
          try {
            [activity.generateMethodBody()/]
          }catch (HttpClientErrorException ex) {
          log.error("'[remoteMs/]' service returned HTTP error {}: {}", ex.getStatusCode(), ex.getResponseBodyAsString());
          
          // Re-throw the exact same HttpClientErrorException with identical status and response body
          throw HttpClientErrorException.create(
              ex.getStatusCode(),
              ex.getStatusText(),
              ex.getResponseHeaders(),
              ex.getResponseBodyAsByteArray(),
              null
          );
      }
	      };
	  [/let]
[/for]
  }
[/let]
[/file]
[/template]

