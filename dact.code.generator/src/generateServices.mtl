[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateServices(
	'http://www.example.org/xcore/data',
	'http://www.example.org/xcore/service',
	'http://www.example.org/xcore/behavior',
	'http://www.example.org/xcore/technology'
)/]

[import stringUtils/]
[import lemmaUtils/]
[import lemmaDataTypeTemplates/]
[import lemmaBehaviorTemplates/]

[comment @main/]
[template public generateServices(behaviorModel : behavior::BehaviorModel)]
[let serviceModel = behaviorModel.getServiceModel().oclAsType(service::ServiceModel), dataModel = behaviorModel.getDataModel().oclAsType(data::DataModel)]
[for (microservice : service::Microservice | serviceModel.microservices->select(ms|ms.type = service::MicroserviceType::FUNCTIONAL))]
  	[let serviceName : String = microservice.name.toCamelCase(), 
  		interfaceDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/service/']
    [for (interface: service::Interface | microservice.interfaces -> select(i|i.isService()))]
      	  [let filePath: String = interfaceDir + interface.name.toUpperFirst()+'.java']
		  [interface.generateService(behaviorModel.activityModel, filePath, serviceName)/]
		  [/let]
	[/for]
	[/let]
[/for]
[/let]
[/template]


[template public generateService(
	interface : service::Interface, 
	activityModel: behavior::ActivityModel,
	filePath: String, 
	serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
[let typesToImport : Sequence(data::Type) = interface.getDomainObjectsToImport(),
	interfacesToImport: OrderedSet(service::Interface) = interface.getInterfacesToImport(activityModel)->asSet()
]
 
  package com.example.[serviceName/].service;
  //Autogenerated code for Service: [interface.name/]
  
  [comment TODO: Get the actually used classes to import /]
  import com.example.[serviceName/].domain.*;
  import com.example.[serviceName/].payload.*;
  import com.example.[serviceName/].exception.*;
  
  [for (intefaceToImport | interfacesToImport)]
    import com.example.[serviceName/].[intefaceToImport.getImportDir()/].[intefaceToImport.name.toUpperFirst()/];
  [/for]
  
  [if (interface.hasCollectionTypeParameter())]
    import java.util.List;
  [/if]

  import lombok.RequiredArgsConstructor;
  import lombok.extern.slf4j.Slf4j;
  import org.springframework.stereotype.Service;
  import jakarta.transaction.Transactional;
  
  @Service
  @Slf4j
  @RequiredArgsConstructor
  public class [interface.name.toUpperFirst()/] {
      
[for (interfaceToImport | interfacesToImport)]
     private final [interfaceToImport.name.toUpperFirst()/] [interfaceToImport.name.toLowerFirst()/];
[/for]
      
[for (op : service::Operation | interface.operations)]
      @Transactional
      [op.generateOperation().toSingleLine()/]{
	  [let activity : behavior::Activity = op.getActivity(activityModel)]
      [if (activity != null)]
          // Activity: [activity.name/]      
          [ activity.generateMethodBody()/]
	  [else]
          // WARNING: Activity for this service has not been specified!
          [op.generateDefaultMethodBody()/]
	  [/if]
	      };
	  [/let]
	  
[/for]
  }
[/let]
[/file]
[/template]

