[comment encoding = UTF-8 /]
[module lemmaUtils(
	'http://www.example.org/xcore/data',
	'http://www.example.org/xcore/service',
	'http://www.example.org/xcore/behavior',
	'http://www.example.org/xcore/technology'
	)/]

[import lemmaDataTypeTemplates/]
[import dact::code::generator::utils::ResourceUtils /]

[query public getOperatorPresentation(op : behavior::Operator) : String = 'UNKNOWN' /]

[query public getOperatorPresentation(op : behavior::Divide) : String = ':' /]
[query public getOperatorPresentation(op : behavior::Times) : String = '*' /]
[query public getOperatorPresentation(op : behavior::Plus) : String = '+' /]
[query public getOperatorPresentation(op : behavior::Minus) : String = '-' /]

[query public getOperatorPresentation(op : behavior::Gt) : String = '>' /]
[query public getOperatorPresentation(op : behavior::Lt) : String = '<' /]
[query public getOperatorPresentation(op : behavior::Ge) : String = '>=' /]
[query public getOperatorPresentation(op : behavior::Le) : String = '<=' /]
[query public getOperatorPresentation(op : behavior::Eq) : String = '==' /]
[query public getOperatorPresentation(op : behavior::Ne) : String = '!=' /]
[query public getOperatorPresentation(op : behavior::And) : String = '&&' /]
[query public getOperatorPresentation(op : behavior::Or) : String = '||' /]
  
[comment -- Retrieve Service Model safely --/]
[query public getServiceModel(behaviorModel : behavior::BehaviorModel) : ecore::EObject = 
  behaviorModel.getAllResourceSetRoots()
    ->filter(service::ServiceModel)
    ->first()
/]

[comment -- Retrieve Data Model safely --/]
[query public getDataModel(behaviorModel : behavior::BehaviorModel) : ecore::EObject = 
  behaviorModel.getAllResourceSetRoots()
    ->filter(data::DataModel)
    ->first()
/]

[query public getDataModel(serviceModel : service::ServiceModel) : ecore::EObject = 
  serviceModel.getAllResourceSetRoots()
    ->filter(data::DataModel)
    ->first()
/]

[query public requiresValidation(d : data::DataStructure) : Boolean = 
	d.getInvariantOperation() <> null or d.dataFields -> exists(f|f.requiresValidation())
/]

[query public requiresValidation(f : data::DataField): Boolean =
	f.complexType <> null 
	and f.complexType.oclIsKindOf(data::DataStructure)
	and not f.complexType.oclAsType(data::DataStructure).isEntity()
	and f.complexType.oclAsType(data::DataStructure).getInvariantOperation() <> null
/]

[query public getInvariantOperation(d : data::DataStructure) : behavior::SpecDataOperation =
	d.operations -> select(o|o.oclIsTypeOf(behavior::SpecDataOperation) and o.isInvariant)
		->asSequence()->first()
/]
[query public hasCollectionField(d : data::DataStructure) : Boolean = 
	d.dataFields->select(f | f.complexType <> null and f.complexType.oclIsKindOf(data::CollectionType)) -> size() >0
/]

[query public hasPrimitiveCollectionField(d : data::DataStructure) : Boolean = 
    d.dataFields->exists(f | 
        f.complexType <> null 
        and f.complexType.oclIsKindOf(data::CollectionType) 
        and f.complexType.oclAsType(data::CollectionType).primitiveType <> null
    )
/]

[query public hasEnumCollectionField(d : data::DataStructure) : Boolean = 
    d.dataFields->exists(f | 
        f.complexType <> null 
        and f.complexType.oclIsKindOf(data::CollectionType) 
        and f.complexType.oclAsType(data::CollectionType).dataFields->first() <> null
        and f.complexType.oclAsType(data::CollectionType).dataFields->first().complexType <> null
        and f.complexType.oclAsType(data::CollectionType).dataFields->first().complexType.oclIsKindOf(data::Enumeration)
    )
/]

[query public hasEntityCollectionField(d : data::DataStructure) : Boolean = 
    d.dataFields->exists(f | 
        f.complexType <> null 
        and f.complexType.oclIsKindOf(data::CollectionType) 
        and f.complexType.oclAsType(data::CollectionType).dataFields->first() <> null
        and f.complexType.oclAsType(data::CollectionType).dataFields->first().complexType <> null
        and f.complexType.oclAsType(data::CollectionType).dataFields->first().complexType.oclIsKindOf(data::DataStructure)
        and f.complexType.oclAsType(data::CollectionType).dataFields->first().complexType.oclAsType(data::DataStructure).isEntity()
    )
/]

[query public hasEntityField(d : data::DataStructure) : Boolean = 
	d.dataFields->exists(f | 
	        f.complexType <> null 
	        and f.complexType.oclIsKindOf(data::DataStructure)
	        and f.complexType.oclAsType(data::DataStructure).isEntity()
	)
/]

[query public hasDataObjectField(d : data::DataStructure) : Boolean = 
	d.dataFields->exists(f | 
	        f.complexType <> null 
	        and f.complexType.oclIsKindOf(data::DataStructure)
	        and not f.complexType.oclAsType(data::DataStructure).isEntity()
	)
/]

[query public hasEnumerationField(d : data::DataStructure) : Boolean = 
	d.dataFields->select(f | f.complexType <> null and f.complexType.oclIsKindOf(data::Enumeration)) -> size() >0
/]

[comment Currently works for single id field, NOT composite ids/]
[query public hasUUIDId(d : data::DataStructure) : Boolean = 
    let idFields : Sequence(data::DataField) = d.dataFields->select(f | f.features->includes(data::DataFieldFeature::IDENTIFIER)) in
    if idFields->notEmpty() then
        not idFields->asSequence()->first().primitiveType.oclIsKindOf(data::PrimitiveInteger)
    else
        false
    endif
/]

[query public getIdField(d : data::DataStructure) : data::DataField = 
    d.dataFields->select(f | f.features->includes(data::DataFieldFeature::IDENTIFIER))->asSequence()->first()
/]
[query public isEntity(d : data::DataStructure) : Boolean = 
	d.features->includes(data::ComplexTypeFeature::ENTITY)
/]

[query public getDomainTypeToImports(d : data::DataStructure) : Sequence(String) = 
    d.dataFields
        ->collect(f | 
            if (f.complexType <> null) then
                if (f.complexType.oclIsKindOf(data::DataStructure) or f.complexType.oclIsKindOf(data::Enumeration)) then 
                    f.complexType.name
                else if (f.complexType.oclIsKindOf(data::CollectionType) and f.complexType.oclAsType(data::CollectionType).dataFields <> null) then 
                    f.complexType.oclAsType(data::CollectionType).dataFields.complexType.name.toUpperFirst()
                else 
                    null
                endif endif
            else
                null
            endif
        )
        ->reject(name | name = null)
        ->asSet()
        ->asSequence()
/]

[query public toJavaType(type : data::PrimitiveType) : String = 
    if type.oclIsKindOf(data::PrimitiveBoolean) then 'Boolean'
    else if type.oclIsKindOf(data::PrimitiveByte) then 'Byte'
    else if type.oclIsKindOf(data::PrimitiveCharacter) then 'Character'
    else if type.oclIsKindOf(data::PrimitiveDouble) then 'Double'
    else if type.oclIsKindOf(data::PrimitiveFloat) then 'Float'
    else if type.oclIsKindOf(data::PrimitiveInteger) then 'Integer'
    else if type.oclIsKindOf(data::PrimitiveLong) then 'Long'
    else if type.oclIsKindOf(data::PrimitiveShort) then 'Short'
    else if type.oclIsKindOf(data::PrimitiveString) then 'String'
    else 'Object'
    endif endif endif endif endif endif endif endif endif
/]

[query public isDomainObject(t: data::ComplexType): Boolean =
	t.features -> includes(data::ComplexTypeFeature::AGGREGATE) or 
	t.features -> includes(data::ComplexTypeFeature::ENTITY) or
	t.features -> includes(data::ComplexTypeFeature::VALUE_OBJECT) or 
	t.features -> includes(data::ComplexTypeFeature::SHARED_VALUE_OBJECT) or 
	t.features -> includes(data::ComplexTypeFeature::DOMAIN_EVENT) or
	t.oclIsKindOf(data::CollectionType) or 
	t.oclIsKindOf(data::Enumeration)
/]

[query public isException(t: data::ComplexType): Boolean =
	t.features -> includes(data::ComplexTypeFeature::RUNTIME_EXCEPTION) or 
	t.features -> includes(data::ComplexTypeFeature::NOTFOUND_EXCEPTION)
/]

[query public isNotFoundException(t: data::ComplexType): Boolean =
	t.features -> includes(data::ComplexTypeFeature::NOTFOUND_EXCEPTION)
/]

[query public isPayload(t: data::ComplexType): Boolean =
	t.features -> includes(data::ComplexTypeFeature::REQUEST_PAYLOAD) or 
	t.features -> includes(data::ComplexTypeFeature::RESPONSE_PAYLOAD) or
	t.features -> includes(data::ComplexTypeFeature::EXTERNAL)
/]

[query public getIdType(t: data::DataStructure): String =
	let idField : data::DataField = t.getIdField() in
	if idField.primitiveType.oclIsKindOf(data::PrimitiveInteger) then
		'Long'
	else
		'UUID'
	endif
/]

[query public getExceptionDescription(e : data::DataStructure): String =
	let desc : String = e.dataFields -> first().initializationValue.valueAsString() in 
	if desc.endsWith('.') then 
		desc
	else
		desc+'.'
	endif
/]

[query public hasNotNullField(d : data::DataStructure): Boolean = 
	d.dataFields -> exists(f|f.lowerBound>0)
/]

[query public isRepository(i : service::Interface): Boolean = 
	i.interfaceType = service::InterfaceType::REPOSITORY
/]

[query public isService(i : service::Interface): Boolean = 
	i.interfaceType = service::InterfaceType::APPLICATION_SERVICE or
	i.interfaceType = service::InterfaceType::DOMAIN_SERVICE
/]

[query public isController(i : service::Interface): Boolean = 
	i.interfaceType = service::InterfaceType::CONTROLLER
/]

[query public isOutboundAdapter(i : service::Interface): Boolean = 
	i.interfaceType = service::InterfaceType::OUTBOUND_ADAPTER
/]


[query public getRepositoryAggregate(i: service::Interface): data::DataStructure =
	let repoName : String = i.name, 
		aggregateName : String = i.name.replace('Repository',''),
		msName : String = i.microservice.name,
		allAggregates : Sequence(data::ComplexType) = i.microservice.getAllAggregates()
	in allAggregates -> select(o|o.name = aggregateName) -> first().oclAsType(data::DataStructure)
/]


[query public getAllAggregates(ms : service::Microservice): Sequence(data::ComplexType)=
	let context : data::Context = ms.getCorrespondingContext() in
	context.complexTypes->select(t | t.hasFeature(data::ComplexTypeFeature::AGGREGATE))	
/]

[query public getCorrespondingContext(ms : service::Microservice): data::Context =
	let dataModel : data::DataModel = ms.serviceModel.getDataModel().oclAsType(data::DataModel) in
	dataModel.contexts->select(c|c.name = ms.name)->first()
/]


[query public hasCollectionTypeParameter(i : service::Interface) : Boolean =
  i.operations.parameters.importedType.type->filter(data::CollectionType)->notEmpty()
/]

[query public getOutParams(o : service::Operation) : Sequence(service::Parameter) =
  o.parameters -> select(p|p.exchangePattern = technology::ExchangePattern::OUT)
/]

[query public getInParams(o : service::Operation) : Sequence(service::Parameter) =
  o.parameters -> select(p|p.exchangePattern = technology::ExchangePattern::IN)
/]

[query public hasOptionalOutParam(i: service::Interface): Boolean = 
 i.operations.parameters -> exists(p|p.lowerBound=0)
/]

[query public generateOperation(op: service::Operation): String = 
  'public ' + op.generateOperationOutParam() + ' ' + op.name + '(' +op.generateOperationInputParams() + ')'
/]

[query public generateOperationInputParams(op : service::Operation) : String =
  op.getInParams()
    ->collect(p | p.generateParameterType() + ' ' + p.name)
    ->sep(', ')
    ->toString()
/]

[query public generateOperationOutParam(op: service::Operation): String = 
	let outParam : service::Parameter = op.getOutParams()->first() in
	if  outParam != null then 
		outParam.generateParameterType()
	else 
		'void'
endif/] 

[comment query public generateOperationOutParam(op: service::Operation): String = 
	let outParam : service::Parameter = op.getOutParams()->first() in
	if  outParam != null then 
		if outParam.lowerBound = 0 and outParam.importedType.type.oclIsKindOf(data::DataStructure) then
			'Optional<'+outParam.generateParameterType()+'>'
		else
			outParam.generateParameterType() 
		endif
	else 
		'void'
endif/] 

[query public generateParameterType(p : service::Parameter) : String =
  if (p.primitiveType != null) then 
    p.primitiveType.generateType() 
  else if (p.importedType != null and p.importedType.type != null) then
    p.importedType.type.generateType()
  else
    ''
  endif endif
/]

[query public getDomainObjectsToImport(i : service::Interface) : Sequence(data::ComplexType) = 
  let paramObjects : Sequence(data::ComplexType) = i.operations.parameters.importedType.type
    ->collect(t | 
      if (t.oclIsKindOf(data::CollectionType)) then
        t.oclAsType(data::CollectionType).dataFields -> first().complexType
      else
        t
      endif
    )
    ->filter(data::ComplexType)
    ->asSet()
    ->asSequence()
   in
   paramObjects->including(i.getRepositoryAggregate())->asSet()->asSequence()
/]

[query public getActivity(op : service::Operation, activityModel : behavior::ActivityModel): behavior::Activity = 
	activityModel.activities -> select(a|a.specification.oclAsType(behavior::ImportedInterfaceOperation).operation = op)->first()
/]

[query public getInterfacesToImport(i : service::Interface, activityModel : behavior::ActivityModel) : Sequence(service::Interface) = 
	i.operations -> collect(o|o.getInterfacesToImport(activityModel))
/]

[query public getInterfacesToImport(op : service::Operation,  activityModel : behavior::ActivityModel) : Sequence(service::Interface) = 
	let activity : behavior::Activity = op.getActivity(activityModel) in
	
	if activity = null then Sequence{} else
	activity.root.eAllContents()
		->filter(behavior::CallOperationAction)
		->collect(a|a.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation.interface)
		->asSet()
		->asSequence()
	endif
/]

[query public getImportDir(interfaceToImport: service::Interface): String =
	if interfaceToImport.isController() then 'controller'
	else if interfaceToImport.isService() then 'service'
	else if interfaceToImport.isRepository() then 'repository'
	else if interfaceToImport.isOutboundAdapter() then 'outboundAdapter'
	else ''
	endif endif endif endif
/]

[query public getType(p : service::Parameter): data::Type= 
	if (p.primitiveType != null) then
		p.primitiveType 
	else 
		p.importedType.type
	endif
/]


[query public getType(f : data::DataField): data::Type= 
	if (f.primitiveType != null) then
		f.primitiveType 
	else 
		f.complexType
	endif
/]

[comment Helper Query to look up a variable directly by its String name /]
[query public getMatchedVariableByName(varName: String, scope: behavior::Scope): behavior::Variable =
	let variable : behavior::Variable = scope.ownedVariables -> select(v | v.name = varName) -> first() in
	if variable != null then 
		variable
	else 
		scope.inheritedVariables -> select(v | v.name = varName) -> first()
	endif
/]

[comment Helper Query to extract the Type of a Variable /]
[query public getType(v: behavior::Variable): data::Type =
	if v == null then
		null
	else if v.primitiveType != null then
		v.primitiveType
	else if v.importedType != null then
		v.importedType.type
	else
		null
	endif endif endif
/]

[comment Core Query to get Root Type from path like "newCargo.goal.destination" /]
[query public getRootType(i: behavior::Identifier, scope: behavior::Scope): data::Type = 
	let rootPart : String = i.name.tokenize('.')->at(1) in
	rootPart.getMatchedVariableByName(scope).getType()
/]

[query public getInternalFunctionalContexts(dataModel: data::DataModel, serviceModel: service::ServiceModel): Sequence(data::Context) = 
	let internalFunctionalMicroservices : Sequence(String) = serviceModel.microservices
			->select(ms|ms.type = service::MicroserviceType::FUNCTIONAL)
			->collect(ms|ms.name)
	in dataModel.contexts -> select(context | internalFunctionalMicroservices -> includes(context.name))
/]


