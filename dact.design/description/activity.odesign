    <categories>
      <pages name="Activity Page" labelExpression="General" domainClass="dact::Activity" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.0 //@extensions.0/@categories.0/@groups.1"/>
      <pages name="ActivityGroup Page" labelExpression="General" domainClass="dact::ActivityGroup" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.4 //@extensions.0/@categories.0/@groups.5"/>
      <pages name="ActivityNode Page" labelExpression="General" domainClass="dact::ActivityNode" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.10 //@extensions.0/@categories.0/@groups.6 //@extensions.0/@categories.0/@groups.7 //@extensions.0/@categories.0/@groups.9 //@extensions.0/@categories.0/@groups.8 //@extensions.0/@categories.0/@groups.11 //@extensions.0/@categories.0/@groups.12 //@extensions.0/@categories.0/@groups.13 //@extensions.0/@categories.0/@groups.15 //@extensions.0/@categories.0/@groups.16 //@extensions.0/@categories.0/@groups.17 //@extensions.0/@categories.0/@groups.18"/>
      <pages name="ActivityEdge Page" labelExpression="General" domainClass="dact::ActivityEdge" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.3"/>
      <groups name="Activtiy General Group" labelExpression="Properties" domainClass="dact::Activity" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Activity" valueExpression="aql:self.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:SelectDescription" name="Specification" labelExpression="Specification" helpExpression="Operation whose behavior defined by activity" valueExpression="aql:self.specification" candidatesExpression="aql:self.getAvailableSpecOperations()" candidateDisplayExpression="aql:candidate.getFullQualifiedName()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="specification" valueExpression="var:newValue"/>
              <subModelOperations xsi:type="tool_1:SetValue" featureName="parameterMappings" valueExpression="aql:null"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:CheckboxDescription" name="ToTransform" labelExpression="To Transform" isEnabledExpression="aql:self.toTransform" valueExpression="aql:self.toTransform">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self"/>
          </initialOperation>
        </controls>
      </groups>
      <groups name="ActivityParameters Group" labelExpression="Parameters" domainClass="dact::Activity" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:DynamicMappingForDescription" name="Param Loop" iterator="param" iterableExpression="aql:self.ownedParameters" forceRefresh="true">
          <ifs name="Name" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Parameter" valueExpression="aql:param.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="Direction" predicateExpression="aql:true">
            <widget xsi:type="properties:SelectDescription" name="Direction" labelExpression="Direction" helpExpression="Direction of Parameter. IN = input, OUT = output. INOUT is currently not support" valueExpression="aql:param.direction.toString()" candidatesExpression="aql:dact::ParameterDirection.eLiterals->collect(e | e.name)" candidateDisplayExpression="aql:candidate">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="direction" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="Type" predicateExpression="aql:true">
            <widget xsi:type="properties:SelectDescription" name="Type" labelExpression="Type" helpExpression="Type of Parameter" valueExpression="aql:param.type" candidatesExpression="aql:param.getAllAvailableTypes()" candidateDisplayExpression="aql:'&lt;&lt;' + candidate.eClass().name + '>> ' + candidate.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="LowerBound" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="LowerBound" labelExpression="Lower Bound" helpExpression="Lower Bound of Parameter" valueExpression="aql:param.lowerBound">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="lowerBound" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="UpperBound" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="UpperBound" labelExpression="Upper Bound" helpExpression="Upper Bound of Parameter" valueExpression="aql:param.upperBound">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="upperBound" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="Mapped Op Param" predicateExpression="aql:true">
            <widget xsi:type="properties:SelectDescription" name="Mapped Op Param" labelExpression="Mapped Operation Parameter" helpExpression="Parameter Of Specification Operation that maps to Activity Parameter " valueExpression="aql:param.getMappedOpParamForActivity()" candidatesExpression="aql:param.getAvailableOpParamsToMapForActivitiy()" candidateDisplayExpression="aql:candidate.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:param.setOpParamForActivity(newValue)"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RemoveParam" predicateExpression="aql:true">
            <widget xsi:type="properties:ButtonDescription" name="RemoveParam" buttonLabelExpression="aql:'Remove &quot;' + param.name +'&quot;'">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:RemoveElement"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
        <controls xsi:type="properties:ButtonDescription" name="New Parameter" buttonLabelExpression="Add Parameter">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Parameter" referenceName="ownedParameters">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'parameter'+self.eContainer().ownedParameters->size()"/>
              </subModelOperations>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="ActivityNode Shared Info Group" labelExpression="Properties" domainClass="dact::ActivityNode" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Node" valueExpression="aql:self.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" name="Previous Node" labelExpression="Previous Node" helpExpression="Previous Node " isEnabledExpression="aql:false" referenceNameExpression="source" referenceOwnerExpression="aql:self.tEdge"/>
        <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" name="Next Node" labelExpression="Next Node" helpExpression="Next Node" isEnabledExpression="aql:false" referenceNameExpression="target" referenceOwnerExpression="aql:self.sEdge"/>
      </groups>
      <groups name="ActivityEdge Shared Info Group" labelExpression="Properties" domainClass="dact::ActivityEdge" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Edge" valueExpression="aql:self.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" name="Source Node" labelExpression="Source Node" isEnabledExpression="aql:false" referenceNameExpression="source" referenceOwnerExpression="aql:self"/>
        <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" name="Target Node" labelExpression="Target Node" isEnabledExpression="aql:false" referenceNameExpression="target" referenceOwnerExpression="aql:self"/>
      </groups>
      <groups name="ActivityGroup Shared Info Group" labelExpression="Properties" domainClass="dact::ActivityGroup" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of ActivityGroup" isEnabledExpression="aql:false" valueExpression="aql:self.name"/>
        <controls xsi:type="properties:TextDescription" name="Parent" labelExpression="Parent" helpExpression="Parent of the Activity Group" isEnabledExpression="aql:false" valueExpression="aql:'&lt;&lt;' + self.getParent().eClass().name + '>> ' + self.getParent().name"/>
      </groups>
      <groups name="Scope Group" labelExpression="Variables" domainClass="dact::ActivityGroup" semanticCandidateExpression="var:self"/>
      <groups name="FinalNode Variables To Return Group" labelExpression="Variables To Return" domainClass="dact::FinalNode" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:DynamicMappingForDescription" name="IdenfitierLoop" iterator="i" iterableExpression="aql:self.variablesToReturn" forceRefresh="true">
          <ifs name="Name" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Variable To Return" valueExpression="aql:i.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:i">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RemoveVariable" predicateExpression="aql:true">
            <widget xsi:type="properties:ButtonDescription" name="RemoveVar" buttonLabelExpression="aql:'Remove &quot;' + i.name +'&quot;'">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:i">
                  <subModelOperations xsi:type="tool_1:RemoveElement"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
        <controls xsi:type="properties:ButtonDescription" name="New Variable" buttonLabelExpression="Add Variable To Return">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Identifier" referenceName="variablesToReturn">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'NewVariableToReturn'+self.eContainer().variablesToReturn->size()"/>
              </subModelOperations>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="StructuredActivityNode Group" labelExpression="Condition" domainClass="dact::StructuredActivityNode" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Test Expression" labelExpression="Test Expression" helpExpression="Expression to test. True = execute Body. In case of Conditional Node, False = execute ElseBody" valueExpression="aql:self.test.read()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.updateTestExpr(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="CallOperationAction Params Group" labelExpression="Parameter Mappings" domainClass="dact::CallOperationAction" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:DynamicMappingForDescription" name="ParamLoop" iterator="param" iterableExpression="aql:self.operation.ownedParameters" forceRefresh="true">
          <ifs name="Parameter" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Parameter" labelExpression="aql:param.direction + ' ' + param.name + ' (' + param.readType()+ ')'" helpExpression="Parameter of the called Operation" valueExpression="aql:self.readMappedElement(param)">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.updateMapping(param,newValue)"/>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
      </groups>
      <groups name="CallOperationAction Properties Group" labelExpression="Properties" domainClass="dact::CallOperationAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:SelectDescription" name="Operation" labelExpression="Operation" helpExpression="Operation to call" valueExpression="aql:self.operation" candidatesExpression="aql:self.getAvailableOperations()" candidateDisplayExpression="aql:candidate.getFullQualifiedName()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="operation" valueExpression="var:newValue"/>
              <subModelOperations xsi:type="tool_1:SetValue" featureName="parameterMappings" valueExpression="aql:null"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="ActivityNode Default Properties Group" labelExpression="Properties" domainClass="dact::ActivityNode" semanticCandidateExpression="var:self" preconditionExpression="aql:not self.oclIsKindOf(dact::CallOperationAction) and not self.oclIsKindOf(dact::VariableDeclarationAction) and not self.oclIsKindOf(dact::VariableAssignmentAction) and not self.oclIsKindOf(dact::RaiseExceptionAction) and not self.oclIsKindOf(dact::DomainNode) and not self.oclIsKindOf(dact::SignalAction)" extends="//@extensions.0/@categories.0/@groups.2"/>
      <groups name="VariableDeclarationAction Group" labelExpression="Properties" domainClass="dact::VariableDeclarationAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:SelectDescription" name="Type" labelExpression="Type" helpExpression="Type of Parameter" valueExpression="aql:self.type" candidatesExpression="aql:self.getAllAvailableTypes()" candidateDisplayExpression="aql:'&lt;&lt;' + candidate.eClass().name + '>> ' + candidate.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="LowerBound" labelExpression="Lower Bound" helpExpression="Lower Bound of Parameter" valueExpression="aql:self.lowerBound">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="lowerBound" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="UpperBound" labelExpression="Upper Bound" helpExpression="Upper Bound of Parameter" valueExpression="aql:self.upperBound">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="upperBound" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="Variable" labelExpression="Variable" helpExpression="Variable name" valueExpression="aql:self.declaration.identifier.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.declaration.updateAssignmentIdentifier(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="Default" labelExpression="Default" helpExpression="Default" valueExpression="aql: if self.declaration.expr != null then self.declaration.expr.read() else '' endif">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.declaration.updateAssignmentExpr(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="VariableAssignmentAction Group" labelExpression="Properties" domainClass="dact::VariableAssignmentAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:TextDescription" name="Assignment" labelExpression="Assignment" helpExpression="Assignment" valueExpression="aql: if self.assignment != null then self.assignment.read() else '' endif">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.updateAssignment(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="RaiseExceptionAction Group" labelExpression="Properties" domainClass="dact::RaiseExceptionAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:TextDescription" name="Description" labelExpression="Description" helpExpression="Description of the Exception." valueExpression="aql:self.description">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="description" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="DomainNode Properties Group" labelExpression="General" domainClass="dact::DomainNode" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:SelectDescription" name="Aggregate" labelExpression="Aggregate" helpExpression="Aggregate that the Domain Action operates on" valueExpression="aql:self.aggregate" candidatesExpression="aql:self.getAllAvailableAggregates()" candidateDisplayExpression="aql:candidate.getFullQualifiedName()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="aggregate" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="Result" labelExpression="Result" helpExpression="Identifier to save result" valueExpression="aql:self.result.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.updateResultIdentifier(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="DomainCreateUpdateAction Properties Group" labelExpression="Properties" domainClass="dact::DomainCreateAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.14">
        <controls xsi:type="properties:TextDescription" name="Input" labelExpression="aql: 'Object to ' + if self.oclIsKindOf(dact::DomainUpdateAction) then 'Update' else 'Create' endif" helpExpression="Object to persist to database" valueExpression="aql:self.getInput()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.setInput(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="DomainFindDeleteAction Properties Group" labelExpression="Properties" domainClass="dact::DomainNode" semanticCandidateExpression="var:self" preconditionExpression="aql: self.oclIsKindOf(dact::DomainFindAction) or self.oclIsKindOf(dact::DomainDeleteAction)" extends="//@extensions.0/@categories.0/@groups.14"/>
      <groups name="DomainFindDeleteAction Expressions Group" labelExpression="Query Expressions" domainClass="dact::DomainNode" semanticCandidateExpression="var:self" preconditionExpression="aql: self.oclIsKindOf(dact::DomainFindAction) or self.oclIsKindOf(dact::DomainDeleteAction)">
        <controls xsi:type="properties:DynamicMappingForDescription" name="ExprLoop" iterator="e" iterableExpression="aql: self.mainExpr " forceRefresh="true">
          <ifs name="Expression" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Expression" labelExpression="aql: 'Expression ' + self.mainExpr ->indexOf(e)" helpExpression="Query expression of the Domain Node" valueExpression="aql: e.read()">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.updateExpr(e, newValue) "/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RemoveExpr" predicateExpression="aql:true">
            <widget xsi:type="properties:ButtonDescription" name="RemoveExpr" buttonLabelExpression="aql:'Remove &quot;Expression ' + self.mainExpr ->indexOf(e)  +'&quot;'">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:e">
                  <subModelOperations xsi:type="tool_1:RemoveElement"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
        <controls xsi:type="properties:ButtonDescription" name="New Expression" buttonLabelExpression="Add Expression">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.createExpr()"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="SignalAction Properties Group" labelExpression="General" domainClass="dact::SignalAction" semanticCandidateExpression="var:self" extends="//@extensions.0/@categories.0/@groups.2">
        <controls xsi:type="properties:SelectDescription" name="Domain Event" labelExpression="Event" helpExpression="Event Object that the action sends/recieves" valueExpression="aql:self.event" candidatesExpression="aql:self.getAllAvailableDomainEvents()" candidateDisplayExpression="aql:candidate.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="event" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:TextDescription" name="Value" labelExpression="Value" helpExpression="Identifier/value to send as event body" valueExpression="aql: self.getValue()">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.setValue(newValue)"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
    </categories>
  </extensions>
</description:Group>
