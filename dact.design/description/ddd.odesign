  <ownedViewpoints name="ddd" modelFileExtension="dact">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="DDD Diagram" domainClass="dact::DddModel" enablePopupBars="true">
      <metamodel href="http://www.example.org/xcore/dact#/"/>
      <validationSet name="EcoreOclValidation">
        <ownedRules xsi:type="validation:SemanticValidationRule" name="EcoreOclValidation" level="ERROR" targetClass="ecore.EObject">
          <audits auditExpression="aql:self.oclIsTypeOf(dact::DddModel) and self.validate()"/>
