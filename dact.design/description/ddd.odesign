              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="New SharedValueObject" forceRefresh="true" containerMappings="//@ownedViewpoints[name='ddd']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='SharedDomainObjectNode']">
