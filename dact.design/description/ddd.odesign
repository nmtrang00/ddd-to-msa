  <extensions xsi:type="properties:ViewExtensionDescription">
    <categories>
      <pages name="Operation Page" labelExpression="General" domainClass="dact::Operation" groups="//@extensions.0/@categories.0/@groups.0"/>
      <pages name="Default" labelExpression="General" semanticCandidateExpression="var:self" preconditionExpression="aql:not self.oclIsKindOf(dact::Operation)">
        <extends href="platform:/plugin/org.eclipse.sirius.properties.defaultrules/model/properties.odesign#//@extensions.0/@categories.0/@pages.0"/>
      </pages>
      <groups name="ParametersGroup" labelExpression="Properties" domainClass="dact::Operation">
        <controls xsi:type="properties:ListDescription" name="ParametersGroup" labelExpression="Parameters" valueExpression="aql:self.ownedParameters" displayExpression="aql:value.direction + ' ' + value.name + ' : ' + (if value.type &lt;> null and value.type.name &lt;> null then value.type.name else 'Undefined' endif) + (if value.lowerBound = 1 and value.upperBound = 1 then '' else ' [' + value.lowerBound.toString() + '..' + (if value.upperBound = -1 then '*' else value.upperBound.toString() endif) + ']' endif)">
          <onClickOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self"/>
          </onClickOperation>
          <actions labelExpression="New">
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Parameter" referenceName="ownedParameters" variableName="newParam">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:value"/>
                </subModelOperations>
                <subModelOperations xsi:type="properties:WizardModelOperation" windowTitleExpression="Create New Parameter">
                  <pages name="parameterWizardPage" groups="//@extensions.0/@categories.0/@groups.0/@controls.0/@actions.0/@initialOperation/@firstModelOperations/@subModelOperations.1/@groups.0"/>
                  <groups name="wizardInputGroup" domainClass="dact::Parameter" semanticCandidateExpression="aql:newParam">
                    <controls xsi:type="properties:TextDescription" name="paramNameInput" labelExpression="Name">
                      <initialOperation>
                        <firstModelOperations xsi:type="tool_1:Let" variableName="sasdfadf" valueExpression="nw">
                          <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                            <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:newName"/>
                          </subModelOperations>
                        </firstModelOperations>
                      </initialOperation>
                    </controls>
                    <style barStyle="NO_TITLE" expandedByDefault="true"/>
                  </groups>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </actions>
        </controls>
        <extends href="platform:/plugin/org.eclipse.sirius.properties.defaultrules/model/properties.odesign#//@extensions.0/@categories.0/@groups.0"/>
      </groups>
    </categories>
  </extensions>
</description:Group>
