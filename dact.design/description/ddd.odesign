        <toolSections>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="New BoundedContext" forceRefresh="true" containerMappings="//@ownedViewpoints[name='ddd']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::BoundedContext" referenceName="boundedContexts">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'Context'+container.boundedContexts->size()"/>
