      </validationSet>
      <defaultLayer name="Default">
        <edgeMappings name="CompositionEdge" preconditionExpression="aql:self.isComposite" synchronizationLock="true" sourceMapping="//@ownedViewpoints[name='ddd']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']" targetMapping="//@ownedViewpoints[name='ddd']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']" targetFinderExpression="aql:self.type" sourceFinderExpression="aql:self.domainObject" domainClass="dact::Property" useDomainElement="true">
          <style sourceArrow="FillDiamond" sizeComputationExpression="2" routingStyle="manhattan">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12" showIcon="false" labelExpression="aql:self.name + ' [' + self.lowerBound + '..'+ (if self.upperBound = -1 then '*' else self.upperBound endif) +']'">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
