grammar dact.dsl.ExprDsl with org.eclipse.xtext.common.Terminals

import "http://www.example.org/xcore/dact" as dact
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// Root entry point
Expression returns dact::Expression:
    AssignmentExpression;

// -----------------------------------------------------------
// Operator Precedence Cascade
// -----------------------------------------------------------

AssignmentExpression returns dact::Expression:
    {dact::VariableAssignment} identifier=Identifier '=' expr=AssignmentExpression
  | OrExpression;

OrExpression returns dact::Expression:
    AndExpression (
        {dact::BinaryExpression.leftExpr=current} 
        operator=OrOperator 
        rightExpr=AndExpression
    )*;

OrOperator returns dact::Operator:
    {dact::Or} ('OR' | '||' | 'or');

AndExpression returns dact::Expression:
    ComparisonExpression (
        {dact::BinaryExpression.leftExpr=current} 
        operator=AndOperator 
        rightExpr=ComparisonExpression
    )*;

AndOperator returns dact::Operator:
    {dact::And} ('AND' | '&&' | 'and');

ComparisonExpression returns dact::Expression:
    AdditiveExpression (
        {dact::BinaryExpression.leftExpr=current} 
        operator=ComparisonOperator 
        rightExpr=AdditiveExpression
    )*;

ComparisonOperator returns dact::Operator:
    {dact::Gt} '>'  |
    {dact::Ge} '>=' |
    {dact::Lt} '<'  |
    {dact::Le} '<=' |
    {dact::Eq} '==' |
    {dact::Ne} '!=';

AdditiveExpression returns dact::Expression:
    MultiplicativeExpression (
        {dact::BinaryExpression.leftExpr=current} 
        operator=AdditiveOperator 
        rightExpr=MultiplicativeExpression
    )*;

AdditiveOperator returns dact::Operator:
    {dact::Plus} '+' |
    {dact::Minus} '-';

MultiplicativeExpression returns dact::Expression:
    UnaryExpression (
        {dact::BinaryExpression.leftExpr=current} 
        operator=MultiplicativeOperator 
        rightExpr=UnaryExpression
    )*;

MultiplicativeOperator returns dact::Operator:
    {dact::Times} '*' |
    {dact::Divide} '/';

UnaryExpression returns dact::Expression:
    {dact::NotExpression} ('NOT' | '!' | 'not') expr=PrimaryExpression
  | PrimaryExpression;

// Level 7: Primary Expressions & Literals
PrimaryExpression returns dact::Expression:
    LiteralReal      // Must come before LiteralInteger so floats like 3.14 don't stop at '3'
  | LiteralInteger
  | LiteralString
  | LiteralBoolean
  | LiteralNull
  | PropertyAccess
  | '(' AssignmentExpression ')'
;

// -----------------------------------------------------------
// Leaf Terminals & Literals
// -----------------------------------------------------------

// REAL / FLOAT LITERAL (e.g., 3.14, -0.05, 10.0)
LiteralReal returns dact::UnaryExpression:
    value=RealSpecification;

RealSpecification returns dact::LiteralReal:
    value=EDoubleObject;

EDoubleObject returns ecore::EDoubleObject:
    '-'? INT '.' INT;

// INTEGER LITERAL (e.g., 42, -7)
LiteralInteger returns dact::UnaryExpression:
    value=IntegerSpecification;

IntegerSpecification returns dact::LiteralInteger:
    value=EIntegerObject;

EIntegerObject returns ecore::EIntegerObject:
    '-'? INT;

// STRING LITERAL (e.g., "hello world", 'test')
LiteralString returns dact::UnaryExpression:
    value=StringSpecification;

StringSpecification returns dact::LiteralString:
    value=STRING;

// BOOLEAN LITERAL (e.g., true, false)
LiteralBoolean returns dact::UnaryExpression:
    value=BooleanSpecification;

BooleanSpecification returns dact::LiteralBoolean:
    {dact::LiteralBoolean} (value?='true' | 'false');

// NULL LITERAL (e.g., null, NULL)
LiteralNull returns dact::UnaryExpression:
    value=NullSpecification;

NullSpecification returns dact::LiteralNull:
    {dact::LiteralNull} ('null' | 'NULL');

// PROPERTY / VARIABLE ACCESS
PropertyAccess returns dact::UnaryExpression:
    {dact::UnaryExpression} identifier=Identifier;

Identifier returns dact::Identifier:
	{dact::Identifier} name=QualifiedName;

QualifiedName:
    ID ('.' ID)*;

//    PrimaryIdentifier ({dact::NavigationExpression.target=current} '.' property=[dact::Property|ID])*;
//
//PrimaryIdentifier returns dact::Identifier:
//    {dact::SelfIdentifier} 'self'
//  | {dact::VariableIdentifier} name=ID;
  
//Example: self.age.value
//NavigationExpression (Outer)
// ├── property ──> 'value' (Cross-reference to dact::Property)
// └── target ────> NavigationExpression (Inner)
//                   ├── property ──> 'age' (Cross-reference to dact::Property)
//                   └── target ────> SelfIdentifier ('self')