@Ecore(nsURI="http://www.example.org/xcore/dact")
@GenModel(
    modelDirectory="/dact.metamodel/src-gen",
    editDirectory="/dact.metamodel.edit/src-gen",
    editorDirectory="/dact.metamodel.editor/src-gen",
    editPluginID="dact.metamodel.edit",
    editorPluginID="dact.metamodel.editor"
)
package dact
import org.eclipse.emf.common.util.BasicDiagnostic
import org.eclipse.emf.common.util.Diagnostic
import org.eclipse.emf.ecore.EDiagnosticChain
import org.eclipse.emf.ecore.EMap

abstract class DiagnosticSupported {
    op boolean report(EDiagnosticChain diagnostics, String message) {
    if (diagnostics !== null) {
        diagnostics.add(new BasicDiagnostic(Diagnostic.ERROR,
            "http://www.example.org/xcore/dact", 0, message, #[this]))
    }
    return false
    }
    
    op boolean warn(EDiagnosticChain diagnostics, String message) {
        if (diagnostics !== null) {
            diagnostics.add(new BasicDiagnostic(Diagnostic.WARNING,
                "http://www.example.org/xcore/dact", 0, message, #[this]))
        }
        return true
    }
} 

@Ecore(constraints="UniquePrimitiveType")
class Root extends  DiagnosticSupported {
    contains DddModel[0..1] ddd
    contains ActivityModel[0..1] activity
    contains PrimitiveType[] primitivesTypes
    
    op boolean UniquePrimitiveType(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
        val typesList = primitivesTypes.map[it?.eClass].filterNull.toList
        val isUnique = typesList.size === typesList.toSet.size
        
        if (!isUnique && diagnostics !== null) {
            report(diagnostics, "Duplicate primitive types detected.")
        }
        return isUnique
    }
}

abstract class NamedElement{
	String name
}

abstract class TypedMultiplicityElement {
	contains ValueSpecification[0..1] ^default
	refers Type ^type
	Integer upperBound = '1'
	Integer lowerBound = '0'
}

abstract class Model{}

@Ecore(constraints="UniqueBoundedContextNames UniqueSharedDomainObjectNames")
class DddModel extends Model, DiagnosticSupported {
    contains BoundedContext[] boundedContexts
    contains SharedDomainObject[] sharedDomainObjects

    op boolean UniqueBoundedContextNames(EDiagnosticChain diagnostics,
                                         EMap<Object, Object> context) {
        val names = boundedContexts.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Bounded context names must be unique; duplicated: " +
            duplicates + ".")
    }

    op boolean UniqueSharedDomainObjectNames(EDiagnosticChain diagnostics,
                                             EMap<Object, Object> context) {
        val names = sharedDomainObjects.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Shared domain object names must be unique; duplicated: " +
            duplicates + ".")
    }
}

@Ecore(constraints="UniqueActivityNames")
class ActivityModel extends Model, DiagnosticSupported {
    contains Activity[] activities

    op boolean UniqueActivityNames(EDiagnosticChain diagnostics,
                                   EMap<Object, Object> context) {
        val names = activities.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Activity names must be unique; duplicated: " + duplicates + ".")
    }
}

class DomainNodeOperationMapping{
	Boolean usedByExternalContext
	refers DomainNode domainNode
	refers Operation operation
}

class BoundedContext extends NamedElement{
	contains DomainElement[] ownedElements opposite context
}

abstract class DomainElement extends NamedElement
{
	container BoundedContext context opposite ownedElements
}

class Entity extends InternalDomainObject {
    refers Repository repository opposite entity
}

class ValueObject extends InternalDomainObject{}

class SharedValueObject extends SharedDomainObject{
	refers AggregateRoot abstractedRoot
}

class AggregateRoot extends Entity{
}

class Repository extends Interface{
	refers Entity entity opposite repository
}

class Service extends Interface{}

@Ecore(constraints="MandatoryType CompositeRequiresEntity AggregateIsNotComposed PrimitivePropertyRequiresName")
class Property extends NamedElement, DefinesIdentityObject, TypedMultiplicityElement,DiagnosticSupported{
	Boolean isComposite = 'false'
	
	container DomainObject domainObject opposite ownedProperties
	
	op boolean MandatoryType(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
        val hasType = this.^type !== null

        if (!hasType && diagnostics !== null) {
            report(diagnostics,
                "Property '" + name + "' of '" + domainObject?.name +
                "' must declare a type.")
        }
        return hasType
    }
    
    op boolean CompositeRequiresEntity(EDiagnosticChain diagnostics,
                                             EMap<Object, Object> context) {
        val isValid = (!isComposite || (this.domainObject instanceof Entity && this.^type instanceof Entity))

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
                "Property '" + name + "' cannot be composite: composition requires " +
					"both the owning element and the declared type to be entities."
            )
        }
        return isValid
    }
    
    op boolean AggregateIsNotComposed(EDiagnosticChain diagnostics,
                            EMap<Object, Object> context) {
	    val isValid = !isComposite || !(this.^type instanceof AggregateRoot)
	
	    if (!isValid && diagnostics !== null) {
	        report(diagnostics,
	            "Property '" + name + "' cannot compose the aggregate root '" +
					this.^type?.name + "': aggregate roots are referenced, not owned."
	         )
	    }
	    return isValid
	}
    
    op boolean PrimitivePropertyRequiresName(EDiagnosticChain diagnostics,
                                         EMap<Object, Object> context) {
	    val isValid = !(this.^type instanceof PrimitiveType) ||
	                  !(name === null || name.trim.empty)
	
	    if (!isValid && diagnostics !== null) {
	        report(diagnostics,
	            "A property of primitive type '" + this.^type?.name + "' in '" +
	            domainObject?.name + "' must declare a name, since no " +
	            "meaningful name can be derived from a primitive type.")
	    }
	    return isValid
	}
}

class Operation extends NamedElement, DefinesIdentityObject,DiagnosticSupported{
	OperationType ^type
	
	refers Behavior behavior opposite specification
	
	contains Parameter[] ownedParameters opposite operation
	container Interface ^interface opposite ownedOperations
	container DomainObject domainObject opposite ownedOperations
}

@Ecore(constraints="BehaviorXorSpecification NoInputParameters OwnedByDomainObjectOnly UniqueRuleNames SingleBoolOutParameter")
class SpecOperation extends Operation,DiagnosticSupported{
	Boolean isInvariant = 'false'
	
	contains SpecRule[0..*] ownedRules opposite operation // Multiple expression joined by AND
	
	
	op boolean BehaviorXorSpecification(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
	    val hasBehavior = behavior !== null
	    val hasSpec = !ownedRules.empty
	
	    if (hasBehavior && hasSpec) {
	        return report(diagnostics,
	            "Operation '" + name + "' defines both a behavior and a " +
	            "specification; only one is allowed.")
	    }
	
	    if (!hasBehavior && !hasSpec) {
	        return warn(diagnostics,
	            "Operation '" + name + "' defines neither a behavior nor a " +
	            "specification; a default body will be generated.")
	    }
	
	    return true
	}
	
	op boolean NoInputParameters(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        if (!isInvariant) return true
        
        val inputParameters = ownedParameters.filter(p|p.direction == ParameterDirection::IN)
    	if (inputParameters.size() == 0) return true
    	
    	return report(diagnostics,
	            "Specification Validation Operation '" + name + 
	            "' must not have extra parameters rather than self.")                                	
    }
    
    op boolean OwnedByDomainObjectOnly(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context){
        if (domainObject !== null && interface === null) return true
        
        return report(diagnostics,
	            "Specification Validation Operation '" + name + 
	            "' must only be defined within Domain Object.")  
    }
    
    op boolean UniqueRuleNames(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val names = ownedRules.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Rules of specification operation '" + name + "' must have unique " +
            "names; duplicated: " + duplicates + ".")
    }
    
    op boolean SingleBoolOutParameter(EDiagnosticChain diagnostics,
                                  EMap<Object, Object> context) {
	
	    val outParams = ownedParameters.filter[direction == ParameterDirection::OUT]
	    if (outParams.size !== 1) {
	        return report(diagnostics,
	            "Specification operation '" + name + "' must declare exactly " +
	            "one outgoing parameter of type Boolean, but declares " +
	            outParams.size + ".")
	    }
	
	    val outParam = outParams.head
	    if (!(outParam.^type instanceof BooleanType)) {
	        return report(diagnostics,
	            "The outgoing parameter of specification operation '" + name +
	            "' must be of type Boolean, but is of type '" +
	            outParam.^type?.name + "'.")
	    }
	
	    if (outParam.lowerBound !== 1 || outParam.upperBound !== 1) {
	        return report(diagnostics,
	            "The outgoing parameter of specification operation '" + name +
	            "' must be single-valued.")
	    }
	
	    return true
	}
}

class SpecRule extends NamedElement {
	String rawString
	contains Expression expr
	container SpecOperation operation opposite ownedRules
}

enum OperationType {
	I0_INBOUND_GET,
	I1_INBOUND_PUT,
	I2_INBOUND_POST,
	I3_INBOUND_DELETE,
	I4_MESSAGE_HANDLER,
	S0_DOMAIN_SERVICE,
	S1_APPLICATION_SERVICE,
	R0_REPOSITORY_CREATE,
	R1_REPOSITORY_READ,
	R2_REPOSITORY_UPDATE,
	R3_REPOSITORY_DELETE,
	R4_REPOSITORY_EXIST,
	O0_OUTBOUND_GET,
	O1_OUTBOUND_PUT,
	O2_OUTBOUND_POST,
	O3_OUTBOUND_DELETE,
	O4_MESSAGE_DISPATCHER,
	O5_OUTBOX_POLLER,
	D0_CONSTRUCTOR,
	D1_SIMPLE_MUTATOR,
	D2_COMPOUND_MUTATOR,
	D3_SIMPLE_ACCESSOR,
	D4_COMPOUND_ACCESSOR,
	D5_SPECIFICATION,
	A0_INTERNAL_ACL,
	A1_EXTERNAL_ACL
}

abstract class InternalDomainObject extends DomainObject{}

@Ecore(constraints="UniqueOperationNames")
abstract class Interface extends DomainElement, DiagnosticSupported {
    contains Operation[] ownedOperations opposite ^interface

    op boolean UniqueOperationNames(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val names = ownedOperations.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Operations of interface '" + name + "' must have unique " +
            "names; duplicated: " + duplicates + ".")
    }
}

abstract class DefinesIdentityObject {
	Boolean definesIdentity = 'false'
}

@Ecore(constraints="UniqueOperationNames UniquePropertyNames SingleInvariantOperation")
abstract class DomainObject extends Type, DomainElement, DiagnosticSupported {
    contains Property[] ownedProperties opposite domainObject
    contains Operation[] ownedOperations opposite domainObject

    op boolean UniqueOperationNames(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val names = ownedOperations.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
            "Operations of '" + name + "' must have unique names; " +
            "duplicated: " + duplicates + ".")
    }
    
    op boolean UniquePropertyNames(EDiagnosticChain diagnostics,
                               EMap<Object, Object> context) {
	    val names = ownedProperties.map[name].filterNull.toList
	    if (names.size === names.toSet.size) return true
	
	    val duplicates = names.filter[n | names.filter[it == n].size > 1]
	                          .toSet.join(", ")
	    return report(diagnostics,
	        "Properties of '" + name + "' must have unique names; duplicated: " +
	        duplicates + ".")
	}
	
	op boolean SingleInvariantOperation(EDiagnosticChain diagnostics,
                               EMap<Object, Object> context){
        val invOps = ownedOperations.filter(SpecOperation).filter[o | o.isInvariant]
    	val count = invOps.size
        if (count <= 1) return true
        
        val invOpNames = invOps.map[name].join(", ")
       	return report(diagnostics,
	        "Domain Object '" + name + "' can have at max one Invariant Operation, but " + count +" defined: " + invOpNames)            	
   	}
}

abstract class SharedDomainObject extends DomainObject{}

abstract class PrimitiveType extends DataType{}

class StringType extends PrimitiveType{}

class BooleanType extends PrimitiveType{}

class IntegerType extends PrimitiveType{}

class RealType extends PrimitiveType{}

abstract class Type extends NamedElement{}

class Enumeration extends DataType, DomainElement{
	contains EnumerationLiteral[] ownedLiterals
}

abstract class DataType extends Type{}

class EnumerationLiteral extends NamedElement{}

abstract class Literal extends ValueSpecification{}

class LiteralNull extends Literal{}

class LiteralString extends Literal{
	String value
	
	// 1. Derived Feature: Gets the length of the string
	derived Integer length get{
		if (value === null) return 0
		return value.length()
	}
	
	// 2. Basic Operation: Checks if it contains a substring
	op Boolean ^contains(String substring) {
		if (value === null || substring === null) return false
		return value.contains(substring)
	}
}

class LiteralInteger extends Literal
{
	Integer value
}

class LiteralBoolean extends Literal
{
	Boolean value
}

class LiteralReal extends Literal
{
	Double value
}

class DomainEvent extends NamedElement, SharedDomainObject{}

@Ecore(constraints="MatchedParameterMappings")
class Activity extends NamedElement, Behavior,DiagnosticSupported
{
	Boolean toTransform = 'true'
	contains Parameter[] ownedParameters opposite activity
	contains ParameterMapping[] parameterMappings opposite activity
	contains ActivityGroup[0..1] root opposite activity
	contains DomainNode[] ownedDomainNodes // Only used during transformation to derive the most influential impact
	contains DomainNodeOperationMapping[] processedDomainNodeMappings
	
	op boolean MatchedParameterMappings(EDiagnosticChain diagnostics,
                                        EMap<Object, Object> context) {
        if (parameterMappings.empty) return true

        val operation = specification
        if (operation === null){
            return report(diagnostics, "Activity '" + name +
                "' declares parameter mappings but specifies no operation.")
		}
		
        val opParams = operation.ownedParameters
        if (parameterMappings.size !== ownedParameters.size ||
            parameterMappings.size !== opParams.size){
            return report(diagnostics, "Activity '" + name + "' declares " +
                parameterMappings.size + " parameter mappings for " +
                ownedParameters.size + " activity parameters and " +
                opParams.size + " operation parameters; all three must " +
                "be equal.")
		}
		
        val mappedOpParams = parameterMappings
            .map[operationParameter].filterNull.toList
        val mappedActParams = parameterMappings
            .map[activityParameter].filterNull.toList

        var isValid = true

        if (mappedOpParams.size !== mappedOpParams.toSet.size ||
            !mappedOpParams.containsAll(opParams))
            isValid = report(diagnostics, "Each operation parameter of '" +
                operation.name + "' must be covered by exactly one " +
                "mapping in activity '" + name + "'.")

        if (mappedActParams.size !== mappedActParams.toSet.size ||
            !mappedActParams.containsAll(ownedParameters))
            isValid = report(diagnostics, "Each parameter of activity '" +
                name + "' must be covered by exactly one mapping.")

        return isValid
    }
	
}

class Scope{
	refers Scope[0..1] parent opposite children
	refers Scope[0..*] children opposite parent 
	refers Variable[] inheritedVariables opposite accessibleScopes
	contains Variable[] ownedVariables opposite scope
	container ActivityGroup group opposite scope
}

class Identifier extends NamedElement{}

