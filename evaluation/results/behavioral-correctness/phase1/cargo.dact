<?xml version="1.0" encoding="UTF-8"?>
<dact:Root xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dact="http://www.example.org/xcore/dact">
  <ddd>
    <boundedContexts name="Cargo">
      <ownedElements xsi:type="dact:AggregateRoot" name="Cargo">
        <ownedProperties definesIdentity="true" name="trackingId" type="//@primitivesTypes.2" lowerBound="1"/>
        <ownedProperties name="history" type="//@ddd/@boundedContexts.0/@ownedElements.1" isComposite="true"/>
        <ownedProperties name="status" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1"/>
        <ownedProperties name="role" type="//@ddd/@sharedDomainObjects.0" lowerBound="1"/>
        <ownedProperties name="goal" type="//@ddd/@boundedContexts.0/@ownedElements.4" lowerBound="1"/>
        <ownedProperties name="itinerary" type="//@ddd/@sharedDomainObjects.1" upperBound="-1"/>
        <ownedOperations xsi:type="dact:SpecOperation" name="isValid" type="D5_SPECIFICATION" isInvariant="true">
          <ownedParameters name="result" type="//@primitivesTypes.1" lowerBound="1" direction="OUT"/>
          <ownedParameters name="self" type="//@ddd/@boundedContexts.0/@ownedElements.0" lowerBound="1"/>
          <ownedRules name="Once ready, cargo must always be routed" rawString="((((self.status == TransportStatus::UNRECEIVED) || (self.status == TransportStatus::RECEIVED)) || (self.status == TransportStatus::MISHANDLED)) || (self.itinerary != NULL))">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Or"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Or"/>
                  <leftExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="self.status"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNRECEIVED"/>
                    </rightExpr>
                  </leftExpr>
                  <rightExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="self.status"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::RECEIVED"/>
                    </rightExpr>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::MISHANDLED"/>
                  </rightExpr>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.itinerary"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:LiteralNull"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
        </ownedOperations>
        <ownedOperations xsi:type="dact:SpecOperation" name="validateEvent" type="D5_SPECIFICATION">
          <ownedParameters name="result" type="//@primitivesTypes.1" lowerBound="1" direction="OUT"/>
          <ownedParameters name="event" type="//@ddd/@boundedContexts.0/@ownedElements.5" lowerBound="1"/>
          <ownedParameters name="self" type="//@ddd/@boundedContexts.0/@ownedElements.0" lowerBound="1"/>
          <ownedRules name="Current is UNRECEIVED. Only allow RECEIVE event" rawString="self.status != TransportStatus::UNRECEIVED || self.status == TransportStatus::UNRECEIVED &amp;&amp; event.type == HandlingEventType::RECEIVE">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNRECEIVED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNRECEIVED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::RECEIVE"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is RECEIVED. Do not allow any futher event until the cargo is ROUTED" rawString="((self.status != TransportStatus::RECEIVED) || ((self.status == TransportStatus::RECEIVED) &amp;&amp; false))">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::RECEIVED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::RECEIVED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:LiteralBoolean"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is READY. Only allow LOAD event" rawString="self.status != TransportStatus::READY || self.status == TransportStatus::READY &amp;&amp; event.type == HandlingEventType::LOAD">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::READY"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::READY"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::LOAD"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is LOADED. Only allow TRANSPORT event if the movement is valid" rawString="self.status != TransportStatus::LOADED || (self.status == TransportStatus::LOADED &amp;&amp; event.type == HandlingEventType::TRANSPORT)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::LOADED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::LOADED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::TRANSPORT"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is ON_PATH. Only allow UNLOAD event at port in the itinerary" rawString="self.status != TransportStatus::ON_PATH || (self.status == TransportStatus::ON_PATH &amp;&amp; event.type == HandlingEventType::UNLOAD &amp;&amp; event.port in self.itinerary)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::ON_PATH"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:And"/>
                  <leftExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="self.status"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::ON_PATH"/>
                    </rightExpr>
                  </leftExpr>
                  <rightExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="event.type"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::UNLOAD"/>
                    </rightExpr>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:In"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.port"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.itinerary"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is UNLOADED. Only allow LOAD event if port is not the destination" rawString="((self.status != TransportStatus::UNLOADED) || (((self.status == TransportStatus::UNLOADED) &amp;&amp; (event.type == HandlingEventType::LOAD)) &amp;&amp; (event.port != self.goal.delivery.destination)))">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNLOADED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:And"/>
                  <leftExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="self.status"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNLOADED"/>
                    </rightExpr>
                  </leftExpr>
                  <rightExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="event.type"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::LOAD"/>
                    </rightExpr>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Ne"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.port"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.goal.delivery.destination"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is UNLOADED. Only allow CUSTOMS event if port is the destination" rawString="((self.status != TransportStatus::UNLOADED) || (((self.status == TransportStatus::UNLOADED) &amp;&amp; (event.type == HandlingEventType::CUSTOMS)) &amp;&amp; (event.port == self.goal.delivery.destination)))">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNLOADED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:And"/>
                  <leftExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="self.status"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::UNLOADED"/>
                    </rightExpr>
                  </leftExpr>
                  <rightExpr xsi:type="dact:BinaryExpression">
                    <operator xsi:type="dact:Eq"/>
                    <leftExpr xsi:type="dact:UnaryExpression">
                      <identifier name="event.type"/>
                    </leftExpr>
                    <rightExpr xsi:type="dact:UnaryExpression">
                      <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::CUSTOMS"/>
                    </rightExpr>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.port"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.goal.delivery.destination"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is IN_CUSTOMS. Only allow CLEAR event " rawString="self.status != TransportStatus::IN_CUSTOMS || (self.status == TransportStatus::IN_CUSTOMS &amp;&amp; event.type == HandlingEventType::CLEAR)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::IN_CUSTOMS"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::IN_CUSTOMS"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::CLEAR"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is CLEARED. Only allow DELIVER event " rawString="self.status != TransportStatus::CLEARED || (self.status == TransportStatus::CLEARED &amp;&amp; event.type == HandlingEventType::DELIVER)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::CLEARED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::CLEARED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::DELIVER"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is DELIVERED. No event is allowed" rawString="self.status != TransportStatus::DELIVERED || (self.status == TransportStatus::DELIVERED &amp;&amp; false)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::DELIVERED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::DELIVERED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:LiteralBoolean"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is MISHANDLED. No event is allowed" rawString="self.status != TransportStatus::MISHANDLED || (self.status == TransportStatus::MISHANDLED &amp;&amp; false)">
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::MISHANDLED"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::MISHANDLED"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression">
                  <value xsi:type="dact:LiteralBoolean"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
        </ownedOperations>
        <ownedOperations name="Cargo" type="D0_CONSTRUCTOR">
          <ownedParameters name="history" type="//@ddd/@boundedContexts.0/@ownedElements.1"/>
          <ownedParameters name="status" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1"/>
          <ownedParameters name="role" type="//@ddd/@sharedDomainObjects.0" lowerBound="1"/>
          <ownedParameters name="goal" type="//@ddd/@boundedContexts.0/@ownedElements.4" lowerBound="1"/>
          <ownedParameters name="self" type="//@ddd/@boundedContexts.0/@ownedElements.0" lowerBound="1" direction="OUT"/>
        </ownedOperations>
        <ownedOperations name="setStatusByEvent" type="D2_COMPOUND_MUTATOR" behavior="//@activity/@activities.10">
          <ownedParameters name="event" type="//@ddd/@boundedContexts.0/@ownedElements.5" lowerBound="1"/>
          <ownedParameters name="self" type="//@ddd/@boundedContexts.0/@ownedElements.0" lowerBound="1"/>
        </ownedOperations>
      </ownedElements>
      <ownedElements xsi:type="dact:Entity" name="DeliveryHistory">
        <ownedProperties definesIdentity="true" name="deliveryHistoryId" type="//@primitivesTypes.0" lowerBound="1"/>
        <ownedProperties name="events" type="//@ddd/@boundedContexts.0/@ownedElements.5" upperBound="-1" isComposite="true"/>
        <ownedProperties name="lastValidEvent" type="//@ddd/@boundedContexts.0/@ownedElements.5"/>
      </ownedElements>
      <ownedElements xsi:type="dact:Enumeration" name="TransportStatus">
        <ownedLiterals name="UNRECEIVED"/>
        <ownedLiterals name="RECEIVED"/>
        <ownedLiterals name="READY"/>
        <ownedLiterals name="LOADED"/>
        <ownedLiterals name="ON_PATH"/>
        <ownedLiterals name="UNLOADED"/>
        <ownedLiterals name="IN_CUSTOMS"/>
        <ownedLiterals name="CLEARED"/>
        <ownedLiterals name="DELIVERED"/>
        <ownedLiterals name="MISHANDLED"/>
      </ownedElements>
      <ownedElements xsi:type="dact:Service" name="CargoService">
        <ownedOperations name="bookACargo" toExpose="true" behavior="//@activity/@activities.1">
          <ownedParameters name="customerId" type="//@primitivesTypes.2" lowerBound="1"/>
          <ownedParameters name="srcPort" type="//@primitivesTypes.2" lowerBound="1"/>
          <ownedParameters name="destPort" type="//@primitivesTypes.2" lowerBound="1"/>
          <ownedParameters name="newCargo" type="//@ddd/@boundedContexts.0/@ownedElements.0" direction="OUT"/>
          <ownedParameters name="deadline" type="//@primitivesTypes.2" lowerBound="1"/>
        </ownedOperations>
