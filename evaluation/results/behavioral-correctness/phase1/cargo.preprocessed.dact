              <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression" upperBound="-1">
                  <identifier name="self.itinerary"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression" lowerBound="1">
                  <value xsi:type="dact:LiteralNull"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
        </ownedOperations>
        <ownedOperations xsi:type="dact:SpecOperation" name="validateEvent" type="D5_SPECIFICATION">
          <ownedParameters name="result" type="//@primitivesTypes.1" lowerBound="1" direction="OUT"/>
          <ownedParameters name="event" type="//@ddd/@boundedContexts.0/@ownedElements.5" lowerBound="1"/>
          <ownedParameters name="self" type="//@ddd/@boundedContexts.0/@ownedElements.0" lowerBound="1"/>
          <ownedRules name="Current is UNRECEIVED. Only allow RECEIVE event" rawString="self.status != TransportStatus::UNRECEIVED || self.status == TransportStatus::UNRECEIVED &amp;&amp; event.type == HandlingEventType::RECEIVE">
            <expr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::Unreceived"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                    <identifier name="self.status"/>
