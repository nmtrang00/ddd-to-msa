                <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.6" lowerBound="1">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.6" lowerBound="1">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::Receive"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is RECEIVED. Do not allow any futher event until the cargo is ROUTED" rawString="((self.status != TransportStatus::RECEIVED) || ((self.status == TransportStatus::RECEIVED) &amp;&amp; false))">
            <expr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::Received"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::Received"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <value xsi:type="dact:LiteralBoolean"/>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is READY. Only allow LOAD event" rawString="self.status != TransportStatus::READY || self.status == TransportStatus::READY &amp;&amp; event.type == HandlingEventType::LOAD">
            <expr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <identifier name="self.status"/>
                </leftExpr>
                <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::Ready"/>
                </rightExpr>
              </leftExpr>
              <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:And"/>
                <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                    <identifier name="self.status"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                    <value xsi:type="dact:EnumerationLiteral" name="TransportStatus::Ready"/>
                  </rightExpr>
                </leftExpr>
                <rightExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                  <operator xsi:type="dact:Eq"/>
                  <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.6" lowerBound="1">
                    <identifier name="event.type"/>
                  </leftExpr>
                  <rightExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.6" lowerBound="1">
                    <value xsi:type="dact:EnumerationLiteral" name="HandlingEventType::Load"/>
                  </rightExpr>
                </rightExpr>
              </rightExpr>
            </expr>
          </ownedRules>
          <ownedRules name="Current is LOADED. Only allow TRANSPORT event if the movement is valid" rawString="self.status != TransportStatus::LOADED || (self.status == TransportStatus::LOADED &amp;&amp; event.type == HandlingEventType::TRANSPORT)">
            <expr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
              <operator xsi:type="dact:Or"/>
              <leftExpr xsi:type="dact:BinaryExpression" type="//@primitivesTypes.1" lowerBound="1">
                <operator xsi:type="dact:Ne"/>
                <leftExpr xsi:type="dact:UnaryExpression" type="//@ddd/@boundedContexts.0/@ownedElements.2" lowerBound="1">
                  <identifier name="self.status"/>
