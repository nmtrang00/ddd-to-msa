      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="Location with given port code cannot be resolved"/>
      </dataFields>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="CargoIsHandled">
      <features>RUNTIME_EXCEPTION</features>
      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="A cargo with at least a handling event cannot be deleted from the system."/>
      </dataFields>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="ExistsByCustomerIdResponse">
