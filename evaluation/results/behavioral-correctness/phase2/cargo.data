    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="CustomerNotFound">
      <features>RUNTIME_EXCEPTION</features>
      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="Customer with given customerId is not found"/>
      </dataFields>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="RouteMismatch">
      <features>RUNTIME_EXCEPTION</features>
      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="Source and/or destination of the route does not match with the delivery specification"/>
      </dataFields>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="CargoAlreadyRouted">
      <features>RUNTIME_EXCEPTION</features>
      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="Cargo with given tracking Id is already routed. Cannot be re-routed."/>
      </dataFields>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="CargoNotFound">
      <features>NOTFOUND_EXCEPTION</features>
      <dataFields name="description" lowerBound="1" upperBound="1">
        <primitiveType xsi:type="data:PrimitiveString"/>
        <initializationValue stringValue="Cargo with given tracking Id is not found"/>
      </dataFields>
      <dataFields name="entity" lowerBound="1" upperBound="1"/>
    </complexTypes>
    <complexTypes xsi:type="data:DataStructure" name="LocationNotFound">
