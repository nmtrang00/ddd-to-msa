        <ownedEdges edgeName="ActivityEdge1" source="//@activity/@activities.0/@root/@ownedNodes.0" target="//@activity/@activities.0/@root/@ownedNodes.2"/>
        <ownedEdges edgeName="ActivityEdge3" source="//@activity/@activities.0/@root/@ownedNodes.3" target="//@activity/@activities.0/@root/@ownedNodes.1"/>
