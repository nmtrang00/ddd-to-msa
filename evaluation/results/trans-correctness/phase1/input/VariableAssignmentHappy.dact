<?xml version="1.0" encoding="UTF-8"?>
<dact:Root xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dact="http://www.example.org/xcore/dact">
  <ddd/>
  <activity>
    <activities name="TestActivity">
      <root name="Root">
        <ownedNodes xsi:type="dact:InitialNode" name="InitialNode1" sEdge="//@activity/@activities.0/@root/@ownedEdges.0"/>
        <ownedNodes xsi:type="dact:ActivityFinalNode" name="ActivityFinalNode4" tEdge="//@activity/@activities.0/@root/@ownedEdges.2">
          <variablesToReturn name="x"/>
        </ownedNodes>
        <ownedNodes xsi:type="dact:VariableDeclarationAction" name="VariableDeclarationAction2" sEdge="//@activity/@activities.0/@root/@ownedEdges.1" tEdge="//@activity/@activities.0/@root/@ownedEdges.0" type="//@primitivesTypes.3" lowerBound="1">
          <declaration>
            <identifier name="x"/>
            <expr xsi:type="dact:UnaryExpression">
              <value xsi:type="dact:LiteralInteger" value="0"/>
            </expr>
          </declaration>
        </ownedNodes>
        <ownedNodes xsi:type="dact:VariableAssignmentAction" name="VariableAssignmentAction3" sEdge="//@activity/@activities.0/@root/@ownedEdges.2" tEdge="//@activity/@activities.0/@root/@ownedEdges.1">
          <assignment>
            <identifier name="x"/>
            <expr xsi:type="dact:BinaryExpression">
              <operator xsi:type="dact:Plus"/>
              <leftExpr xsi:type="dact:UnaryExpression">
                <identifier name="x"/>
              </leftExpr>
              <rightExpr xsi:type="dact:UnaryExpression">
                <value xsi:type="dact:LiteralReal" value="1.5"/>
              </rightExpr>
            </expr>
          </assignment>
        </ownedNodes>
        <ownedEdges edgeName="ActivityEdge1" source="//@activity/@activities.0/@root/@ownedNodes.0" target="//@activity/@activities.0/@root/@ownedNodes.2"/>
        <ownedEdges edgeName="ActivityEdge2" source="//@activity/@activities.0/@root/@ownedNodes.2" target="//@activity/@activities.0/@root/@ownedNodes.3"/>
        <ownedEdges edgeName="ActivityEdge3" source="//@activity/@activities.0/@root/@ownedNodes.3" target="//@activity/@activities.0/@root/@ownedNodes.1"/>
        <scope/>
      </root>
    </activities>
  </activity>
  <primitivesTypes xsi:type="dact:StringType" name="String"/>
  <primitivesTypes xsi:type="dact:BooleanType" name="Boolean"/>
  <primitivesTypes xsi:type="dact:IntegerType" name="Integer"/>
  <primitivesTypes xsi:type="dact:RealType" name="Real"/>
</dact:Root>
