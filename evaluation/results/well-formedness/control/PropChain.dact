<?xml version="1.0" encoding="UTF-8"?>
<dact:Root xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dact="http://www.example.org/xcore/dact">
  <ddd>
    <boundedContexts name="Customer">
      <ownedElements xsi:type="dact:Entity" name="Customer">
        <ownedProperties name="profile" type="//@ddd/@boundedContexts.0/@ownedElements.1"/>
        <ownedOperations xsi:type="dact:SpecOperation">
          <ownedRules>
            <expr xsi:type="dact:UnaryExpression">
              <identifier name="self.profile.name1"/>
            </expr>
          </ownedRules>
        </ownedOperations>
      </ownedElements>
      <ownedElements xsi:type="dact:Entity" name="UserProfile">
        <ownedProperties name="name" type="//@primitivesTypes.0"/>
      </ownedElements>
    </boundedContexts>
  </ddd>
  <activity/>
  <primitivesTypes xsi:type="dact:StringType" name="String"/>
  <primitivesTypes xsi:type="dact:BooleanType" name="Boolean"/>
  <primitivesTypes xsi:type="dact:IntegerType" name="Integer"/>
  <primitivesTypes xsi:type="dact:RealType" name="Real"/>
</dact:Root>
