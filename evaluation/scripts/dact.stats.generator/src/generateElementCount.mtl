[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateElementCount(
	'http://www.example.org/xcore/dact'
)/]


[comment @main/]
[template public generateElementCount(aRoot : dact::Root)]
[file ('element_count.csv', overwrite, 'UTF-8')]
  "Model Element (EClass)","Count"
  Root,1
[for (cls | aRoot.eAllContents()->collect(e | e.eClass())->asOrderedSet()->sortedBy(c | c.name))]
  [cls.name/],[aRoot.eAllContents()->select(e | e.eClass() = cls)->size()/]
[/for]

[/file]
[/template]
