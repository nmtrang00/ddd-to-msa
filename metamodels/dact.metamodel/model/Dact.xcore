@Ecore(nsURI="http://www.example.org/xcore/dact")
@GenModel(
    modelDirectory="/dact.metamodel/src-gen",
    editDirectory="/dact.metamodel.edit/src-gen",
    editorDirectory="/dact.metamodel.editor/src-gen",
    editPluginID="dact.metamodel.edit",
    editorPluginID="dact.metamodel.editor"
)
package dact
import org.eclipse.emf.common.util.BasicDiagnostic
import org.eclipse.emf.common.util.Diagnostic
import org.eclipse.emf.ecore.EDiagnosticChain
import org.eclipse.emf.ecore.EMap

abstract class TransformationOnly{}

abstract class DiagnosticSupported {
    op boolean report(EDiagnosticChain diagnostics,String errName, String message) {
    if (diagnostics !== null) {
        diagnostics.add(new BasicDiagnostic(Diagnostic.ERROR,
            "http://www.example.org/xcore/dact", 0, errName + ": " + message, #[this]))
    }
    return false
    }
    
    op boolean warn(EDiagnosticChain diagnostics,String warningName, String message) {
        if (diagnostics !== null) {
            diagnostics.add(new BasicDiagnostic(Diagnostic.WARNING,
                "http://www.example.org/xcore/dact", 0, warningName +": " + message, #[this]))
        }
        return true
    }
} 

@Ecore(constraints="UniquePrimitiveType")
class Root extends  DiagnosticSupported {
    contains DddModel[0..1] ddd
    contains ActivityModel[0..1] activity
    contains PrimitiveType[] primitivesTypes
    
    op boolean UniquePrimitiveType(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
        val typesList = primitivesTypes.map[it?.eClass].filterNull.toList
        val isUnique = typesList.size === typesList.toSet.size
        
        if (!isUnique && diagnostics !== null) {
            report(diagnostics, 
            	"UniquePrimitiveType",
            	"Duplicate primitive types detected.")
        }
        return isUnique
    }
}

abstract class NamedElement{
	String name
}

@Ecore(constraints="NoDefaultForVariable")
abstract class TypedMultiplicityElement extends NamedElement, DiagnosticSupported{
	contains ValueSpecification[0..1] ^default
	refers Type ^type
	Integer upperBound = '1'
	Integer lowerBound = '0'
	
	op boolean NoDefaultForVariable(EDiagnosticChain diagnostics,
                                         EMap<Object, Object> context) {
    	if (this instanceof Variable){
    		if (this.^default !== null){
    			return warn(diagnostics, 
    			"NoDefaultForVariable",
    			"Default value of variable must be defined within the activity flow. This will be ignored.")
    		}
    	}   
    	
    	return true                                 	
    }
    
    op boolean isSingle() {
        return (this.lowerBound >= 0 && this.lowerBound <= 1) && this.upperBound == 1;
    }
    
    op boolean isCollection() {
        return (this.upperBound < 0 || this.upperBound > 1);
    }
}

abstract class Model{}

@Ecore(constraints="UniqueBoundedContextNames UniqueSharedDomainObjectNames")
class DddModel extends Model, DiagnosticSupported {
    contains unordered BoundedContext[] boundedContexts
    contains unordered SharedDomainObject[] sharedDomainObjects

    op boolean UniqueBoundedContextNames(EDiagnosticChain diagnostics,
                                         EMap<Object, Object> context) {
        val names = boundedContexts.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueBoundedContextNames",
            "Bounded context names must be unique; duplicated: " +
            duplicates + ".")
    }

    op boolean UniqueSharedDomainObjectNames(EDiagnosticChain diagnostics,
                                             EMap<Object, Object> context) {
        val names = sharedDomainObjects.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueSharedDomainObjectNames",
            "Shared domain object names must be unique; duplicated: " +
            duplicates + ".")
    }
}

@Ecore(constraints="UniqueActivityNames")
class ActivityModel extends Model, DiagnosticSupported {
    contains Activity[] activities

    op boolean UniqueActivityNames(EDiagnosticChain diagnostics,
                                   EMap<Object, Object> context) {
        val names = activities.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueActivityNames",
            "Activity names must be unique; duplicated: " + duplicates + ".")
    }
}

class DomainNodeOperationMapping extends TransformationOnly{
	Boolean usedByExternalContext
	refers DomainNode domainNode
	refers Operation operation
}

@Ecore(constraints="UniqueDomainElementNames")
class BoundedContext extends NamedElement,DiagnosticSupported{
	Boolean isExternal = 'false'
	contains unordered DomainElement[] ownedElements opposite context
	
	op boolean UniqueDomainElementNames(EDiagnosticChain diagnostics,
                                   EMap<Object, Object> context) {
        val names = ownedElements.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueDomainElementNames",
            "Domain element names must be unique; duplicated: " + duplicates + ".")
    }
}

abstract class DomainElement extends NamedElement
{
	container BoundedContext context opposite ownedElements
}

class Entity extends InternalDomainObject {
    refers Repository repository opposite entity
}

class ValueObject extends InternalDomainObject{}

class SharedValueObject extends SharedDomainObject{}

class AggregateRoot extends Entity{
}

class Repository extends Interface{
	refers Entity entity opposite repository
}

class Service extends Interface{}

@Ecore(constraints="MandatoryType CompositeRequiresEntity AggregateIsNotComposed PrimitivePropertyRequiresName SharedObjectTypeRestriction")
class Property extends DefinesIdentityObject, TypedMultiplicityElement,DiagnosticSupported{
	Boolean isComposite = 'false'
	
	container DomainObject domainObject opposite ownedProperties

	op boolean MandatoryType(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
        val hasType = this.^type !== null

        if (!hasType) {
            report(diagnostics,
            	"MandatoryType",
                "Property '" + name + "' of '" + domainObject?.name +
                "' must declare a type.")
        }
        return hasType
    }

    op boolean CompositeRequiresEntity(EDiagnosticChain diagnostics,
                                             EMap<Object, Object> context) {
        val isValid = (!isComposite || (this.domainObject instanceof Entity && this.^type instanceof Entity))

        if (!isValid) {
            report(diagnostics,
            	"CompositeRequiresEntity",
                "Property '" + name + "' cannot be composite: composition requires " +
					"both the owning element and the declared type to be entities."
            )
        }
        return isValid
    }
    
    op boolean AggregateIsNotComposed(EDiagnosticChain diagnostics,
                            EMap<Object, Object> context) {
	    val isValid = !isComposite || !(this.^type instanceof AggregateRoot)
	
	    if (!isValid) {
	        report(diagnostics,
	        	"AggregateIsNotComposed",
	            "Property '" + name + "' cannot compose the aggregate root '" +
					this.^type?.name + "': aggregate roots are referenced, not owned."
	         )
	    }
	    return isValid
	}
    
    op boolean PrimitivePropertyRequiresName(EDiagnosticChain diagnostics,
                                         EMap<Object, Object> context) {
	    val isValid = !(this.^type instanceof PrimitiveType) ||
	                  !(name === null || name.trim.empty)
	
	    if (!isValid && diagnostics !== null) {
	        report(diagnostics,
	        	"PrimitivePropertyRequiresName",
	            "A property of primitive type '" + this.^type?.name + "' in '" +
	            domainObject?.name + "' must declare a name, since no " +
	            "meaningful name can be derived from a primitive type.")
	    }
	    return isValid
	}
	
	op boolean SharedObjectTypeRestriction(EDiagnosticChain diagnostics,
                                       EMap<Object, Object> context) {
    if (!(this.domainObject instanceof SharedDomainObject)) return true
    if (this.^type === null) return true

    val isValid = this.^type instanceof PrimitiveType
               || this.^type instanceof Enumeration
               || this.^type instanceof SharedDomainObject

    if (!isValid) {
        return report(diagnostics,
        	"SharedObjectTypeRestriction",
            "Property '" + name + "' of shared domain object '" +
            domainObject.name + "' is typed by '" + ^type.name +
            "', which is internal to a bounded context. A shared domain " +
            "object may only reference primitive types, enumerations, or " +
            "other shared domain objects.")
    }
    return true
}
}

@Ecore(constraints="MatchedDomainOperationType MatchedRepositoryOperationType MatchedServiceOperationType NoBehaviorSpecification ConstructorMatchesProperties")
class Operation extends NamedElement, DefinesIdentityObject,DiagnosticSupported{
	Boolean toExpose = 'false'
	OperationType[1..1] ^type
	
	refers Behavior behavior opposite specification
	
	contains  unordered Parameter[] ownedParameters opposite operation
	container Interface ^interface opposite ownedOperations
	container DomainObject domainObject opposite ownedOperations
	
	op boolean MatchedDomainOperationType(EDiagnosticChain diagnostics,
	                                        EMap<Object, Object> context) {
	    val domainTypes = #[OperationType::D0_CONSTRUCTOR,
                        OperationType::D2_COMPOUND_MUTATOR,
                        OperationType::D4_COMPOUND_ACCESSOR,
                        OperationType::D5_SPECIFICATION]
	    if (domainObject === null) return true

	    if (!domainTypes.contains(^type)) {
	        return report(diagnostics,
	        	"MatchedDomainOperationType",
	            "Operation '" + name + "' is owned by domain object '" +
	            domainObject.name + "', so its type must be one of the domain " +
	            "operation types, but is '" + ^type + "'.")
	    }
	    return true
	
	}
	
	op boolean MatchedRepositoryOperationType(EDiagnosticChain diagnostics,
                                          EMap<Object, Object> context) {
	    if (!(^interface instanceof Repository)) return true
	
	    val repositoryTypes = #[OperationType::R0_REPOSITORY_CREATE,
	                            OperationType::R1_REPOSITORY_READ,
	                            OperationType::R2_REPOSITORY_UPDATE,
	                            OperationType::R3_REPOSITORY_DELETE,
	                            OperationType::R4_REPOSITORY_EXIST]
	
	    if (!repositoryTypes.contains(^type)) {
	        return report(diagnostics,
	        	"MatchedRepositoryOperationType",
	            "Operation '" + name + "' is owned by repository '" +
	            ^interface.name + "', so its type must be one of the repository " +
	            "operation types, but is '" + ^type + "'.")
	    }
	    return true
	}
	
	op boolean MatchedServiceOperationType(EDiagnosticChain diagnostics,
	                                       EMap<Object, Object> context) {
	    if (!(^interface instanceof Service)) return true
	
	    val serviceTypes = #[OperationType::S0_DOMAIN_SERVICE]
	
	    if (!serviceTypes.contains(^type)) {
	        return report(diagnostics,
	        	"MatchedServiceOperationType",
	            "Operation '" + name + "' is owned by service '" +
	            ^interface.name + "', so its type must be a domain or " +
	            "application service operation, but is '" + ^type + "'.")
	    }
	    return true
	}
	
	op boolean NoBehaviorSpecification(EDiagnosticChain diagnostics,
                             EMap<Object, Object> context) {
        if (this.^type === OperationType.D0_CONSTRUCTOR) return true
			
	    val hasRules = this instanceof SpecOperation
	                && !(this as SpecOperation).ownedRules.empty
	
	    if (behavior !== null || hasRules) return true
	
	    return warn(diagnostics,
	    	"NoBehaviorSpecification",
	        "Operation '" + name + "' defines neither a behavior nor a " +
	        "specification rule; a default body will be generated.")
	}

	op boolean ConstructorMatchesProperties(EDiagnosticChain diagnostics,
	                                        EMap<Object, Object> context) {
	    if (^type !== OperationType::D0_CONSTRUCTOR) return true
	
	    val properties = domainObject.ownedProperties
	    var isValid = true
	
	    for (param : ownedParameters.filter[direction == ParameterDirection::IN]) {
	        val property = properties.findFirst[it.name == param.name]
	
	        if (property === null) {
	            isValid = report(diagnostics,
	            	"ConstructorMatchesProperties",
	                "Parameter '" + param.name + "' of constructor '" + name +
	                "' does not correspond to any property of '" +
	                domainObject.name + "'.")
	        } else if (param.^type !== property.^type
	                || param.lowerBound !== property.lowerBound
	                || param.upperBound !== property.upperBound) {
	            isValid = report(diagnostics,
	            	"ConstructorMatchesProperties",
	                "Parameter '" + param.name + "' of constructor '" + name +
	                "' does not match property '" + property.name +
	                "' in type or multiplicity.")
	        }
	    }
	    return isValid
	}
}

@Ecore(constraints="BehaviorXorSpecification OwnedByDomainObjectOnly UniqueRuleNames SingleBoolOutParameter")
class SpecOperation extends Operation,DiagnosticSupported{
	Boolean isInvariant = 'false'
	
	contains SpecRule[0..*] ownedRules opposite operation // Multiple expression joined by AND

	op boolean BehaviorXorSpecification(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
	    val hasBehavior = behavior !== null
	    val hasSpec = !ownedRules.empty
	
	    if (hasBehavior && hasSpec) {
	        return report(diagnostics,
	        	"BehaviorXorSpecification",
	            "Operation '" + name + "' defines both a behavior and a " +
	            "specification; only one is allowed.")
	    }
	
	    return true
	}
	
    op boolean OwnedByDomainObjectOnly(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context){
        if (domainObject !== null && interface === null) return true
        
        return report(diagnostics,
        		"OwnedByDomainObjectOnly",
	            "Specification Validation Operation '" + name + 
	            "' must only be defined within Domain Object.")  
    }
    
    op boolean UniqueRuleNames(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val names = ownedRules.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueRuleNames",
            "Rules of specification operation '" + name + "' must have unique " +
            "names; duplicated: " + duplicates + ".")
    }
    
    op boolean SingleBoolOutParameter(EDiagnosticChain diagnostics,
                                  EMap<Object, Object> context) {
	
	    val outParams = ownedParameters.filter[direction == ParameterDirection::OUT]
	    if (outParams.size !== 1) {
	        return report(diagnostics,
	        	"SingleBoolOutParameter",
	            "Specification operation '" + name + "' must declare exactly " +
	            "one outgoing parameter of type Boolean, but declares " +
	            outParams.size + ".")
	    }
	
	    val outParam = outParams.head
	    if (!(outParam.^type instanceof BooleanType)) {
	        return report(diagnostics,
	        	"SingleBoolOutParameter",
	            "The outgoing parameter of specification operation '" + name +
	            "' must be of type Boolean, but is of type '" +
	            outParam.^type?.name + "'.")
	    }
	
	    if (outParam.lowerBound !== 1 || outParam.upperBound !== 1) {
	        return report(diagnostics,
	        	"SingleBoolOutParameter",
	            "The outgoing parameter of specification operation '" + name +
	            "' must be single-valued.")
	    }
	
	    return true
	}
}

class SpecRule extends NamedElement {
	String rawString
	contains unordered Expression expr
	container SpecOperation operation opposite ownedRules
}

enum OperationType {
	S0_DOMAIN_SERVICE,
	R0_REPOSITORY_CREATE,
	R1_REPOSITORY_READ,
	R2_REPOSITORY_UPDATE,
	R3_REPOSITORY_DELETE,
	R4_REPOSITORY_EXIST,
	D0_CONSTRUCTOR,
	D2_COMPOUND_MUTATOR,
	D4_COMPOUND_ACCESSOR,
	D5_SPECIFICATION
}

abstract class InternalDomainObject extends DomainObject{}

@Ecore(constraints="UniqueOperationNames")
abstract class Interface extends DomainElement, DiagnosticSupported {
    contains unordered Operation[] ownedOperations opposite ^interface

    op boolean UniqueOperationNames(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val names = ownedOperations.map[name].filterNull.toList
        if (names.size === names.toSet.size) return true

        val duplicates = names.filter[n | names.filter[it == n].size > 1]
                              .toSet.join(", ")
        return report(diagnostics,
        	"UniqueOperationNames",
            "Operations of interface '" + name + "' must have unique " +
            "names; duplicated: " + duplicates + ".")
    }
}

@Ecore(constraints="SingleValuedPrimitiveProperty")
abstract class DefinesIdentityObject extends DiagnosticSupported {
	boolean definesIdentity = 'false'
	
	op boolean SingleValuedPrimitiveProperty(EDiagnosticChain diagnostics,
                                             EMap<Object, Object> context) {
        if (!(this instanceof Property)) return true

        val property = this as Property

        // The rule only constrains identity-defining properties.
        if (!property.definesIdentity) return true

        // A missing type is reported by MandatoryType; do not report it twice.
        if (property.^type === null) return true

        val singleValued = property.upperBound == 1
        val primitiveTyped = (property.^type instanceof IntegerType) || (property.^type instanceof StringType);

        if (singleValued && primitiveTyped) return true

		return report(diagnostics,
			"SingleValuedPrimitiveProperty",
			"Identity-defining property '" + property.name +
                    "' must be single-valued and of a integer or string type."
		);
    }
}

@Ecore(constraints="UniqueOperationNames UniquePropertyNames SingleInvariantOperation")
abstract class DomainObject extends Type, DomainElement, DiagnosticSupported {
    contains unordered Property[] ownedProperties opposite domainObject
    contains unordered Operation[] ownedOperations opposite domainObject
	contains Scope scope opposite domainObject
	
    op boolean UniqueOperationNames(EDiagnosticChain diagnostics,
                                EMap<Object, Object> context) {
	    // Identify constructor names that appear more than once (overloaded constructors)
	    val constructors = ownedOperations.filterNull.filter[o | o.^type == OperationType::D0_CONSTRUCTOR].toList
	    val overloadedCtorNames = constructors.map[name].filterNull
	        .filter[n | constructors.filter[it.name == n].size > 1]
	        .toSet
	
	    // Standard operations and single constructors use 'name'.
	    // Overloaded constructors use 'name/inParamCount'.
	    val signatures = ownedOperations.filterNull.map[o |
	        if (o.^type == OperationType::D0_CONSTRUCTOR && overloadedCtorNames.contains(o.name))
	            o.name + "/" + o.ownedParameters.filter[direction == ParameterDirection::IN].size
	        else
	            o.name
	    ].filterNull.toList
	
	    if (signatures.size === signatures.toSet.size) return true
	
	    val duplicates = signatures.filter[s | signatures.filter[it == s].size > 1]
	                               .toSet.map[it.split("/").head].toSet.join(", ")
	    return report(diagnostics,
	        "UniqueOperationNames",
	        "Operations of '" + name + "' must be uniquely identified; " +
	        "duplicated: " + duplicates + ".")
	}
    
    op boolean UniquePropertyNames(EDiagnosticChain diagnostics,
                               EMap<Object, Object> context) {
	    val names = ownedProperties.map[name].filterNull.toList
	    if (names.size === names.toSet.size) return true
	
	    val duplicates = names.filter[n | names.filter[it == n].size > 1]
	                          .toSet.join(", ")
	    return report(diagnostics,
	    	"UniquePropertyNames",
	        "Properties of '" + name + "' must have unique names; duplicated: " +
	        duplicates + ".")
	}
	
	op boolean SingleInvariantOperation(EDiagnosticChain diagnostics,
                               EMap<Object, Object> context){
        val invOps = ownedOperations.filter(SpecOperation).filter[o | o.isInvariant]
    	val count = invOps.size
        if (count <= 1) return true
        
        val invOpNames = invOps.map[name].join(", ")
       	return report(diagnostics,
       		"SingleInvariantOperation",
	        "Domain Object '" + name + "' can have at max one Invariant Operation, but " + count +" defined: " + invOpNames)            	
   	}
}

abstract class SharedDomainObject extends DomainObject{
	refers AggregateRoot abstractedRoot
}

abstract class PrimitiveType extends DataType{}

class StringType extends PrimitiveType{}

class BooleanType extends PrimitiveType{}

class IntegerType extends PrimitiveType{}

class RealType extends PrimitiveType{}

abstract class Type extends NamedElement{}

class Enumeration extends DataType, DomainElement{
	contains EnumerationLiteral[] ownedLiterals
}

abstract class DataType extends Type{}

class EnumerationLiteral extends NamedElement, ValueSpecification{}

abstract class Literal extends ValueSpecification{}

class LiteralNull extends Literal{}

class LiteralString extends Literal{
	String value
	
	// 1. Derived Feature: Gets the length of the string
	derived Integer length get{
		if (value === null) return 0
		return value.length()
	}
	
	// 2. Basic Operation: Checks if it contains a substring
	op Boolean ^contains(String substring) {
		if (value === null || substring === null) return false
		return value.contains(substring)
	}
}

class LiteralInteger extends Literal
{
	Integer value
}

class LiteralBoolean extends Literal
{
	boolean value
}

class LiteralReal extends Literal
{
	Double value
}

class DomainEvent extends NamedElement, SharedDomainObject{}

@Ecore(constraints="MappingsOnlyWithSpecification MatchedParameterMappingsCount EachParameterIsMapped")
class Activity extends NamedElement, Behavior,DiagnosticSupported
{
	Boolean toTransform = 'true'
	contains unordered Parameter[] ownedParameters opposite activity
	contains unordered ParameterMapping[] parameterMappings opposite activity
	contains ActivityGroup[0..1] root opposite activity
	contains DomainNode[] ownedDomainNodes // Only used during transformation to derive the most influential impact
	contains unordered DomainNodeOperationMapping[] processedDomainNodeMappings
    
    op boolean MappingsOnlyWithSpecification(EDiagnosticChain diagnostics,
                                        EMap<Object, Object> context){
    	if  (specification === null && !(parameterMappings.empty)) {
            return report(diagnostics,
            	"MappingsOnlyWithSpecification",
            	 "Activity '" + name +
                "' declares parameter mappings but specifies no operation.")
		}
		return true
    }
    
    op boolean MatchedParameterMappingsCount(EDiagnosticChain diagnostics,
                                        EMap<Object, Object> context) {
        if  (specification === null) return true
        
        val opParams = specification.ownedParameters
        if (parameterMappings.size !== ownedParameters.size ||
            parameterMappings.size !== opParams.size){
            return report(diagnostics,
            	"MatchedParameterMappingsCount",
            	 "Activity '" + name + "' declares " +
                parameterMappings.size + " parameter mappings for " +
                ownedParameters.size + " activity parameters and " +
                opParams.size + " operation parameters; all three must " +
                "be equal.")
		}
		
		return true
	}
	
	op boolean EachParameterIsMapped(EDiagnosticChain diagnostics,
                                        EMap<Object, Object> context) {
        if  (specification === null) return true
        
		val opParams = specification.ownedParameters
		
        val mappedOpParams = parameterMappings
            .map[operationParameter].filterNull.toList
        val mappedActParams = parameterMappings
            .map[activityParameter].filterNull.toList

        var isValid = true

        if (mappedOpParams.size !== mappedOpParams.toSet.size ||
            !mappedOpParams.containsAll(opParams))
            isValid = report(diagnostics, 
            	"EachParameterIsMapped",
            	"Each operation parameter of '" +
                specification.name + "' must be covered by exactly one " +
                "mapping in activity '" + name + "'.")

        if (mappedActParams.size !== mappedActParams.toSet.size ||
            !mappedActParams.containsAll(ownedParameters))
            isValid = report(diagnostics, 
            	"EachParameterIsMapped",
            	"Each parameter of activity '" +
                name + "' must be covered by exactly one mapping.")

        return isValid
    }
	
}

class Scope{
    derived String name get {
    	if (domainObject !== null) return domainObject.name;
    	if (group !== null) return group.name;
    	return "?";
    }
	refers Scope[0..1] parent opposite children
	refers unordered Scope[0..*] children opposite parent 
	refers unordered Variable[] inheritedVariables opposite accessibleScopes
	contains unordered Variable[] ownedVariables opposite scope
	container ActivityGroup group opposite scope
	container DomainObject domainObject opposite scope
}

class Identifier extends NamedElement{
	Integer index
}

@Ecore(constraints="SingleInitialNode SingleFinalNode NonEmptyGroup")
class ActivityGroup extends NamedElement, DiagnosticSupported{
	contains unordered ActivityNode[0..*] ownedNodes opposite group
	contains unordered ActivityEdge[0..*] ownedEdges opposite group
	contains Scope scope opposite group
	
	container Activity[0..1] activity opposite root
	container StructuredActivityNode[0..1] structuredActivityNode opposite body
	container ConditionalNode[0..1] conditionalNode opposite elseBody

	op boolean SingleInitialNode(EDiagnosticChain diagnostics,
                                 EMap<Object, Object> context) {
        if (ownedNodes.size() === 0) return true
                                 	
        val count = ownedNodes.filter(InitialNode).size
        if (count === 1) return true

        return report(diagnostics,
        	"SingleInitialNode",
            "Activity group '" + name + "' contains " + count +
            " initial nodes; exactly one is required.")
    }

    op boolean SingleFinalNode(EDiagnosticChain diagnostics,
                                 EMap<Object, Object> context) {
        if (ownedNodes.size() === 0) return true
                                 	
        val count = ownedNodes.filter(FinalNode).size
        if (count === 1) return true

        return report(diagnostics,
        	"SingleFinalNode",
             "Activity group '" + name + "' contains " + count +
            " final nodes; exactly one is required.")
    }

    op boolean NonEmptyGroup(EDiagnosticChain diagnostics,
                             EMap<Object, Object> context) {
        val hasContent = ownedNodes.exists[
            !(it instanceof InitialNode) && !(it instanceof FinalNode)]
        if (hasContent) return true

        return warn(diagnostics,
        	"NonEmptyGroup",
            "Activity group '" + name + "' contains no nodes.")
    }
}

class Variable extends TransformationOnly, TypedMultiplicityElement{
	refers unordered Scope[] accessibleScopes opposite inheritedVariables
	container Scope scope opposite ownedVariables
}

class InstanceValue extends ValueSpecification
{
	refers DomainObject isInstanceOf
	contains unordered InstanceProperty[] ownedProperties
}

class InstanceProperty extends NamedElement{
	refers Property isInstanceOf
	contains unordered ValueSpecification[] value
}

abstract class ValueSpecification{}

abstract class ActivityNode extends NamedElement{
	refers ActivityEdge sEdge opposite source
	refers ActivityEdge tEdge opposite target
	container ActivityGroup group opposite ownedNodes
}

@Ecore(constraints="NoSelfLoop NoEdgeIntoInitialNode NoEdgeOutOfFinalNode EndpointsInSameGroup")
class ActivityEdge extends DiagnosticSupported {
    derived String name get {
        return (this.source?.name ?: "?") + "->" + (this.target?.name ?: "?");
    }
    
   	String edgeName 
    refers ActivityNode[1..1] source opposite sEdge
    refers ActivityNode[1..1] target opposite tEdge

    container ActivityGroup group opposite ownedEdges

	op boolean NoSelfLoop(EDiagnosticChain diagnostics,
                      EMap<Object, Object> context) {
	    if (source === null || target === null) return true
	
	    if (source === target) {
	        return report(diagnostics,
	        	"NoSelfLoop",
	            "Edge '" + name + "' in group '" + group?.name +
	            "' connects node '" + source.name + "' to itself.")
	    }
	    return true
	}
	
    op boolean NoEdgeIntoInitialNode(EDiagnosticChain diagnostics,
                                     EMap<Object, Object> context) {
        val isValid = !(target instanceof InitialNode)

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
            	"NoEdgeIntoInitialNode",
                "Edge '" + name + "' targets the initial node of group '" +
                group?.name + "': an initial node cannot have incoming edges.")
        }
        return isValid
    }

    op boolean NoEdgeOutOfFinalNode(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val isValid = !(source instanceof FinalNode)

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
            	"NoEdgeOutOfFinalNode",
                "Edge '" + name + "' originates from a final node in group '" +
                group?.name + "': a final node cannot have outgoing edges.")
        }
        return isValid
    }
   
   	op boolean EndpointsInSameGroup(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        if (source === null || target === null) {
            return report(diagnostics,
            	"EndpointsInSameGroup",
                "Edge '" + name + "' in group '" + group?.name +
                "' must declare both a source and a target node.")
        }

        if (source.group !== group || target.group !== group) {
            return report(diagnostics,
            	"EndpointsInSameGroup",
                "Edge '" + name + "' connects nodes outside its own group '" +
                group?.name + "': an edge may only connect nodes contained " +
                "in the same activity group.")
        }

        return true
    }
}

class InitialNode extends ControlNode{
	derived String tName get{
		return this.group.name + "-InitNode";
	}
	
}

abstract class ControlNode extends ActivityNode{}

abstract class ExecutableNode extends ActivityNode{}

abstract class FinalNode extends ControlNode{
	contains Identifier[] variablesToReturn
}

class ActivityFinalNode extends FinalNode{}

class FlowFinalNode extends FinalNode{}

abstract class StructuredActivityNode extends ControlNode{
	contains Expression test
	contains ActivityGroup body opposite structuredActivityNode
}

class ConditionalNode extends StructuredActivityNode{
	contains ActivityGroup elseBody opposite conditionalNode
}

class LoopNode extends StructuredActivityNode{
	contains ActivityGroup setup
}

abstract class Behavior{
	refers Operation specification opposite behavior
}

class CallOperationAction extends ExecutableNode{
	Boolean toDeclareResult = 'false'
	refers Operation[1..1] operation
	contains  unordered ParameterMapping[] parameterMappings opposite action
}

class VariableDeclarationAction extends ExecutableNode{
	refers Type ^type
	Integer upperBound = '1'
	Integer lowerBound = '0'
	contains VariableAssignment declaration
}

class VariableAssignment extends Expression{
	contains Identifier identifier
	contains Expression[0..1] expr
}

class RaiseExceptionAction extends ExecutableNode{
	String description
}

class RaiseEntityNotFoundExceptionAction extends RaiseExceptionAction{
	refers Entity entity
}

class SendSignalAction extends SignalAction{}

class ReceiveSignalAction extends SignalAction{}

class VariableAssignmentAction extends ExecutableNode{
	contains VariableAssignment assignment
}

class ParallelNode extends ControlNode{
	contains unordered ParallelFlow[] flows opposite parallelNode
}

class ParallelFlow extends ActivityGroup{
	boolean isPrimary = 'false' 
	container ParallelNode[1..1] parallelNode opposite flows
}

@Ecore(constraints="RequiresMainExpression SelfAnchoredBinaryExpression")
abstract class DomainNode extends ExecutableNode, DiagnosticSupported{
	refers AggregateRoot[1..1] aggregate
	contains Identifier[0..1] result
	
	refers Entity[0..1] entity 
	contains Expression[] mainExpr
	refers Property[] propertyChain // Derived from the above mutationExpression or entity 
	
	op boolean RequiresMainExpression(EDiagnosticChain diagnostics,
                                      EMap<Object, Object> context) {
        // In case empty for DomainFindAction (but not ExistFindAction) -> Get All 
        val isValid = (this instanceof DomainFindAction && !(this instanceof DomainExistAction)) || !mainExpr.empty

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
            	"RequiresMainExpression",
                "Domain node '" + name + "' must declare at least one main " +
                "expression to identify the target aggregate or the value " +
                "to be written.")
        }
        return isValid
    }
    
	op boolean SelfAnchoredBinaryExpression(EDiagnosticChain diagnostics,
	                                        EMap<Object, Object> context) {
	    var isValid = true
	
	    val allowsAssignment = this instanceof DomainCreateAction || this instanceof DomainUpdateAction
	
	    for (expr : mainExpr) {
			var Identifier identifier = null
	        if (expr instanceof BinaryExpression) {
	            if (!(expr.leftExpr instanceof UnaryExpression)) {
	                isValid = report(diagnostics,
	                    "SelfAnchoredBinaryExpression",
	                    "The left operand of expression '" + expr?.name +
	                    "' must be a unary expression.")
	            } else {
	            	
	                identifier = (expr.leftExpr as UnaryExpression).identifier
	            }
	        } else if (allowsAssignment && expr instanceof VariableAssignment) {
	            identifier = (expr as VariableAssignment).identifier
	        } else {
	            isValid = report(diagnostics,
	                "SelfAnchoredBinaryExpression",
	                "Expression '" + expr?.name + "' of node '" + name +
	                "' must be a binary expression" +
	                (if (allowsAssignment) " or an assignment." else "."))
	        }
	
	        if (identifier === null || !identifier.name.startsWith("self")) {
                isValid = report(diagnostics,
                    "SelfAnchoredBinaryExpression",
                    "The left operand of expression '" + expr?.name +
                    "' must be an identifier anchored at 'self'.")
	        }
	    }
	    return isValid
	}
	
}

class DomainExistAction extends DomainFindAction{}

class DomainFindAction extends DomainNode{
	// Format: Current support only Eq + AND logic: self.propertyPath (Should be of primitiveType) = identifier/literal
}

class DomainCreateAction extends DomainNode{
	
	// Format: self.entityPath = identifier -> followed by required Id-> 
	// Each time enter a one to many relationship must specify id of child
}

class DomainUpdateAction extends DomainCreateAction{
	// Format: self.propertyPath (Should be of primitiveType) = identifier/literal
}

class DomainDeleteAction extends DomainNode{
	// Format: self.propertyPath (ID only) = identifier/literal
}

@Ecore(constraints="ExclusiveEventSource")
abstract class SignalAction extends ExecutableNode, DiagnosticSupported{
	refers DomainEvent[1..1] event
	
	refers Variable variable
	contains Identifier identifier
	contains ValueSpecification value
	
	op boolean ExclusiveEventSource(EDiagnosticChain diagnostics,
                                    EMap<Object, Object> context) {
        val sources = #[identifier, value].filterNull.size
        val isValid = sources === 1

        if (!isValid && diagnostics !== null) {
            val message = if (sources === 0)
                    "Signal action '" + name + "' must supply the value of " +
                    "event '" + event?.name + "' through either an " +
                    "identifier or a value specification."
                else
                    "Signal action '" + name + "' supplies the value of " +
                    "event '" + event?.name + "' through both an identifier " +
                    "and a value specification; only one is allowed."

            report(diagnostics,"ExclusiveEventSource", message)
        }
        return isValid
    }
}

class Parameter extends TypedMultiplicityElement {
	ParameterDirection direction = 'IN' 
	ParameterRole role = 'CORE'
	container Operation operation opposite ownedParameters
	container Activity activity opposite ownedParameters
}

enum ParameterDirection{
	IN
	OUT
}

enum ParameterRole{
	CORE,
	SUPPORTING
}

@Ecore(constraints="ConformingActivityOperationParameter ExclusiveMappingSource ValueOnlyInAction")
class ParameterMapping extends DiagnosticSupported{
	ParameterMappingType ^type
	refers Parameter[1..1] operationParameter
	
	// Map Variable to Operation Param
	contains Identifier[0..1] identifier // Originally defined in the model
	refers Variable[0..1] variable // Later derived in the transformation
	
	// Map Activity Param to Operation Param
	refers Parameter[0..1] activityParameter
	
	// Map Value directly to the Operation Param -> Allow to use for ACTION param mapping only !!!
	contains ValueSpecification[0..1] value
	
	container CallOperationAction[0..1] action opposite parameterMappings
	container Activity[0..1] activity opposite parameterMappings
	
	op boolean ConformingActivityOperationParameter(EDiagnosticChain diagnostics,
                                        EMap<Object, Object> context) {
        if (activityParameter === null || operationParameter === null)
            return true

        val sameType = activityParameter.^type === operationParameter.^type
        val sameLower =
            activityParameter.lowerBound === operationParameter.lowerBound
        val sameUpper =
            activityParameter.upperBound === operationParameter.upperBound
        var sameDirection =
        	activityParameter.direction === operationParameter.direction
        	
        val isValid = sameType && sameLower && sameUpper && sameDirection

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
            	"ConformingActivityOperationParameter",
                "Activity parameter '" + activityParameter.name +
                "' does not conform to operation parameter '" +
                operationParameter.name +
                "': type and multiplicity must be identical."
             )
        }
        return isValid
    }
    
    op boolean ExclusiveMappingSource(EDiagnosticChain diagnostics,
                                      EMap<Object, Object> context) {
        val sources = #[identifier, activityParameter, value]
        val count = sources.filterNull.size
        val isValid = count === 1

        if (!isValid && diagnostics !== null) {
            val message = if (count === 0)
                    "Parameter mapping for '" + operationParameter?.name +
                    "' must define exactly one source: an identifier, a " +
                    "variable, an activity parameter, or a value."
                else
                    "Parameter mapping for '" + operationParameter?.name +
                    "' defines " + count + " sources; exactly one is allowed."

            report(diagnostics, "ExclusiveMappingSource", message)
        }
        return isValid
    }

    op boolean ValueOnlyInAction(EDiagnosticChain diagnostics,
                                 EMap<Object, Object> context) {
        val isValid = value === null || action !== null

        if (!isValid && diagnostics !== null) {
            report(diagnostics,
            	"ValueOnlyInAction",
                "Parameter mapping for '" + operationParameter?.name +
                "' may only map a literal value within a call operation " +
                "action.")
        }
        return isValid
    }
}

enum ParameterMappingType{
	ACTION_IN
	ACTION_OUT
	ACTIVITY_IN
	ACTIVITY_OUT
}

abstract class Expression extends NamedElement, TypedMultiplicityElement{
}

class UnaryExpression extends Expression {
	refers EnumerationLiteral enumValue
	contains ValueSpecification[0..1] value
	contains Identifier[0..1] identifier
}

class BinaryExpression extends Expression
{
	contains Operator operator
	contains Expression leftExpr
	contains Expression rightExpr
}

class NotExpression extends Expression
{
	contains Expression expr
}

abstract class Operator{}

abstract class IntegerOperator extends Operator{}

class Divide extends IntegerOperator{}

class Times extends IntegerOperator{}

class Plus extends IntegerOperator{}

class Minus extends IntegerOperator{}

abstract class LogicalOperator extends Operator{}

class Gt extends LogicalOperator{}

class Lt extends LogicalOperator{}

class Ge extends LogicalOperator{}

class Le extends LogicalOperator{}

class Eq extends LogicalOperator{}

class Ne extends LogicalOperator{}

class And extends LogicalOperator{}

class Or extends LogicalOperator{}

class In extends LogicalOperator{}
