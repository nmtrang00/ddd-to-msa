      <defaultLayer name="Default">
        <edgeMappings name="CompositionEdge" preconditionExpression="aql:self.isComposite" synchronizationLock="true" sourceMapping="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']" targetMapping="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']" targetFinderExpression="aql:self.type" sourceFinderExpression="aql:self.domainObject" domainClass="dact::Property" useDomainElement="true">
