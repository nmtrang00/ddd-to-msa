                  <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="var:target"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="New Abstraction Edge" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@edgeMappings[name='Abstraction']">
