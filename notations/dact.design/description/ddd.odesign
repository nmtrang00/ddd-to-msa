          <ownedTools xsi:type="tool:ContainerCreationDescription" name="Enumeration Literal" forceRefresh="true" containerMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='EnumerationNode']/@subContainerMappings[name='EnumerationLiterals']">
