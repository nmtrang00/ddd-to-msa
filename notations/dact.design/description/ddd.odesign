          <ownedTools xsi:type="tool:ContainerCreationDescription" name="Specification Operation" forceRefresh="true" containerMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']/@subContainerMappings[name='DomainObjectOperations']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::SpecOperation" referenceName="ownedOperations" variableName="newOp">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'inv_'+container.ownedOperations->size()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="aql:dact::OperationType::D5_SPECIFICATION"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="isInvariant" valueExpression="aql:false"/>
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:newOp">
                    <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Parameter" referenceName="ownedParameters" variableName="newParam">
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="result"/>
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="direction" valueExpression="aql:dact::ParameterDirection::OUT"/>
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="lowerBound" valueExpression="1"/>
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="upperBound" valueExpression="1"/>
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="aql:self.findBooleanType()"/>
                    </subModelOperations>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="Constructor Operation" precondition="aql:container.oclIsKindOf(dact::DomainObject)" forceRefresh="true" containerMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='InternalDomainObjectNode']/@subContainerMappings[name='DomainObjectOperations'] //@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='SharedDomainObjectNode']/@subContainerMappings[name='SharedDomainObjectOperations'] //@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@containerMappings[name='BoundedContextNode']/@subContainerMappings[name='LocalizedSharedDomainObjectNode']/@subContainerMappings[name='SharedDomainObjectOperations']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:container.createConstuctorOp()"/>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <toolSections name="Edge">
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="New Reference Edge" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@edgeMappings[name='ReferenceEdge']">
            <sourceVariable name="source"/>
