          <ownedTools xsi:type="tool:EdgeCreationDescription" name="New Composition Edge" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@edgeMappings[name='CompositionEdge']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Property" referenceName="ownedProperties">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="var:target"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="isComposite" valueExpression="true"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="New Repository Manages Edge" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='Domain']/@ownedRepresentations[name='DDD%20Diagram']/@defaultLayer/@edgeMappings[name='RepositoryManagesEdge']">
