    <ownedJavaExtensions qualifiedClassName="dact.design.Services"/>
    <ownedJavaExtensions qualifiedClassName="dact.design.OperationServices"/>
    <ownedJavaExtensions qualifiedClassName="dact.design.DslHelper"/>
  </ownedViewpoints>
  <extensions xsi:type="properties:ViewExtensionDescription">
    <categories>
      <pages name="Operation Page" labelExpression="General" domainClass="dact::Operation" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.1"/>
      <pages name="Default" labelExpression="General" semanticCandidateExpression="var:self" preconditionExpression="aql:not self.oclIsKindOf(dact::Operation)">
        <extends href="platform:/plugin/org.eclipse.sirius.properties.defaultrules/model/properties.odesign#//@extensions.0/@categories.0/@pages.0"/>
      </pages>
      <pages name="Specification Rules Page" labelExpression="Specification Rules" domainClass="dact::SpecOperation" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.0"/>
      <pages name="Parameter Page" labelExpression="Parameters" domainClass="dact::Operation" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.2"/>
      <groups name="Specification Rules Group" labelExpression="Specification Rules" domainClass="dact::SpecOperation" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:DynamicMappingForDescription" name="SpecRuleLoop" iterator="rule" iterableExpression="aql:self.ownedRules" forceRefresh="true">
          <ifs name="Name" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Specification Rule" valueExpression="aql:rule.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:rule">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RawString" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="RawString" labelExpression="Rule Expression" helpExpression="Expression of the Rule" valueExpression="aql: if rule.expr != null then rule.expr.read() else '' endif">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:rule">
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:rule.updateSpecExpr(newValue)"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RemoveRule" predicateExpression="aql:true">
            <widget xsi:type="properties:ButtonDescription" name="RemoveRule" buttonLabelExpression="aql:'Remove &quot;' + rule.name +'&quot;'">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:rule">
                  <subModelOperations xsi:type="tool_1:RemoveElement"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
        <controls xsi:type="properties:ButtonDescription" name="New Rule" buttonLabelExpression="Add Rule">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::SpecRule" referenceName="ownedRules">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'rule'+self.eContainer().ownedRules->size()"/>
              </subModelOperations>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="Shared Operation Info Group" labelExpression="Properties" domainClass="dact::Operation" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of the Operation" valueExpression="aql:self.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:RadioDescription" name="Type" labelExpression="Type" helpExpression="Type of the Operation" valueExpression="aql:self.type.toString()" candidatesExpression="aql:dact::OperationType.eLiterals->collect(e | e.name)" candidateDisplayExpression="aql:candidate" numberOfColumns="4">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="aql:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:CheckboxDescription" name="IsInvariant" labelExpression="Is Invariant" helpExpression="Whether this spec is used as invariant operation" valueExpression="aql:self.isInvariant">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="isInvariant" valueExpression="aql:not self.isInvariant"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:CheckboxDescription" name="ToExpose" labelExpression="ToExpose" valueExpression="aql:self.toExpose">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="toExpose" valueExpression="aql:not self.toExpose"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
        <controls xsi:type="properties:SelectDescription" name="Activity" labelExpression="Activity" valueExpression="aql:self.behavior" candidatesExpression="aql:self.getAllAvailableActivities()" candidateDisplayExpression="aql:candidate.name">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="behavior" valueExpression="aql:newValue"/>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
      <groups name="Parameter Group" labelExpression="Parameters" domainClass="dact::Operation" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:DynamicMappingForDescription" name="Param Loop" iterator="param" iterableExpression="aql:self.ownedParameters" forceRefresh="true">
          <ifs name="Name" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="Name" labelExpression="Name" helpExpression="Name of Parameter" valueExpression="aql:param.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="Direction" predicateExpression="aql:true">
            <widget xsi:type="properties:SelectDescription" name="Direction" labelExpression="Direction" helpExpression="Direction of Parameter. IN = input, OUT = output. INOUT is currently not support" valueExpression="aql:param.direction.toString()" candidatesExpression="aql:dact::ParameterDirection.eLiterals->collect(e | e.name)" candidateDisplayExpression="aql:candidate">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="direction" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="Type" predicateExpression="aql:true">
            <widget xsi:type="properties:SelectDescription" name="Type" labelExpression="Type" helpExpression="Type of Parameter" valueExpression="aql:param.type" candidatesExpression="aql:param.getAvailableOpParamTypes()" candidateDisplayExpression="aql:'&lt;&lt;' + candidate.eClass().name + '>> ' + candidate.name">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="type" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="LowerBound" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="LowerBound" labelExpression="Lower Bound" helpExpression="Lower Bound of Parameter" valueExpression="aql:param.lowerBound">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="lowerBound" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="UpperBound" predicateExpression="aql:true">
            <widget xsi:type="properties:TextDescription" name="UpperBound" labelExpression="Upper Bound" helpExpression="Upper Bound of Parameter" valueExpression="aql:param.upperBound">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="upperBound" valueExpression="var:newValue"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
          <ifs name="RemoveParam" predicateExpression="aql:true">
            <widget xsi:type="properties:ButtonDescription" name="RemoveParam" buttonLabelExpression="aql:'Remove &quot;' + param.name +'&quot;'">
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:param">
                  <subModelOperations xsi:type="tool_1:RemoveElement"/>
                </firstModelOperations>
              </initialOperation>
            </widget>
          </ifs>
        </controls>
        <controls xsi:type="properties:ButtonDescription" name="New Parameter" buttonLabelExpression="Add Parameter">
          <initialOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="dact::Parameter" referenceName="ownedParameters">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'parameter'+self.eContainer().ownedParameters->size()"/>
              </subModelOperations>
            </firstModelOperations>
          </initialOperation>
        </controls>
      </groups>
    </categories>
  </extensions>
</description:Group>
