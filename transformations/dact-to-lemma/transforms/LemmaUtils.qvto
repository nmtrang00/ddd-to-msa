query BEHA::ActivityEdge::printInfo(ntabs : Integer): String {
    var source := if self.source.oclIsUndefined() then "'UndefinedSource'" else self.source.name endif;
    var target := if self.target.oclIsUndefined() then "'UndefinedTarget'" else self.target.name endif;
    
    var toReturn := "ActivityEdge: " + source + " ---> " + target;
    
    log(indent(ntabs) + "[`] " + toReturn);
    return toReturn; 
}

query BEHA::ParameterMapping::printInfo(ntabs: Integer): String {
    var src := self.operationParameter.toString();
    var tgt : String := "unmapped";
    
    if (not self.variable.oclIsUndefined()) then tgt := self.variable.name endif;
    if (not self.identifier.oclIsUndefined()) then tgt := self.identifier.name endif;
    if (not self.activityParameter.oclIsUndefined()) then tgt := self.activityParameter.name endif;
    if (not self.value.oclIsUndefined()) then tgt := self.value.toString() endif;
    
    var toReturn := self.type.toString() + " : " + src + " -> " + tgt;
    log(indent(ntabs) + "[+] ParameterMapping - " + toReturn);
    return toReturn;
}

query SERV::Microservice::printInfo(ntabs:Integer): String{
	var toPrint := indent(ntabs) + "[~] Microservice: " + self.buildQualifiedName("::");
    log(toPrint);
    return toPrint;
}

query SERV::Interface::printInfo(ntabs: Integer): String{
	var toPrint := indent(ntabs) + "[!] "+self.interfaceType.toString()+" Interface: " + self.buildQualifiedName("::");
    log(toPrint);
    return toPrint;
}

query SERV::Operation::printInfo(ntabs:Integer): String{
	var toPrint := indent(ntabs) + "[$] Operation: " + self.buildQualifiedName("::");
    log(toPrint);
    return toPrint;
}

query SERV::Parameter::printInfo(ntabs: Integer): String {
    var toPrint := indent(ntabs) + "[%] Parameter: " + self.buildQualifiedName("::");
    log(toPrint);
    return toPrint;
}


query SERV::Operation::isInboundHttp(): Boolean {
    var inboundTypes := Set{
        SERV::OperationType::I0_INBOUND_GET,
        SERV::OperationType::I1_INBOUND_PUT,
        SERV::OperationType::I2_INBOUND_POST,
        SERV::OperationType::I3_INBOUND_DELETE
    };

    return inboundTypes->includes(self.operationType);
}

query BEHA::Activity::getMicroservice(): SERV::Microservice {
	var spec := self.specification.oclAsType(BEHA::ImportedInterfaceOperation).operation;
	var interface := spec.interface;
	var microservice := interface.microservice;
	
	return microservice;
}

query DATA::DataStructure::getMicroservice(): SERV::Microservice{
	// Current 1 BoundedContext = 1 Context = 1 MS
	
	var context := self.context;
	var matchedMicroservice := SERV::Microservice.allInstances() -> selectOne (s|s.name = context.name);
	
	return  matchedMicroservice;
}

query BEHA::CallOperationAction::getMicroservice(): SERV::Microservice{
	var microservice : SERV::Microservice;
	
	if (self.importedOperation.oclIsKindOf(BEHA::ImportedInterfaceOperation)){
		var operation := self.importedOperation.oclAsType(BEHA::ImportedInterfaceOperation).operation;
		var interface := operation.interface;
		microservice := interface.microservice;
	}else if (self.importedOperation.oclIsKindOf(BEHA::ImportedDataOperation)){
		var operation := self.importedOperation.oclAsType(BEHA::ImportedDataOperation).operation;
		var dataStructure := operation.dataStructure;
		microservice := dataStructure.getMicroservice();
	};
	return microservice;	
}
query SERV::Microservice::getCorrespondingOutboundAdapterName(): String{
	return self.name + "OutboundAdapter"
}

query SERV::Microservice::getCorrespondingContext(): DATA::Context{
	return DATA::Context.allInstances() -> selectOne(c|c.name=self.name);
}

