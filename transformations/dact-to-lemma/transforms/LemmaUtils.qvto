//        log(indent(ntabs + 1) + "└── Edges:");
//        self.ownedEdges->forEach(edge) {
//            edge.printInfo(ntabs + 2);
//        };
//    } endif;

    return toPrint;
}

query BEHA::CallOperationAction::getQualifiedName(): String {
    if (self.importedOperation.oclIsKindOf(BEHA::ImportedInterfaceOperation)){
    	return self.importedOperation.oclAsType(BEHA::ImportedInterfaceOperation).operation.buildQualifiedName("::");
    }else{
    	return self.importedOperation.oclAsType(BEHA::ImportedDataOperation).operation.buildQualifiedName("::");
    }
}

query BEHA::ImportedOperation::printInfo(ntabs: Integer, specialTag: String): String {
    var opName : String;
    if (self.oclIsKindOf(BEHA::ImportedInterfaceOperation)) then {
        opName := self.oclAsType(BEHA::ImportedInterfaceOperation).operation.name;
    } else {
        opName := self.oclAsType(BEHA::ImportedDataOperation).operation.name;
    } endif;

    var toPrint := indent(ntabs) + "[$] " + specialTag + ": " + opName;
    log(toPrint);
    return toPrint;
}

