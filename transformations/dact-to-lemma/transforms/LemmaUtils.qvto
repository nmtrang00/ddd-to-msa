import DactUtils; // Reuses the shared 'indent(ntabs)' query function

library LemmaUtils;

modeltype DATA uses 'http://www.example.org/xcore/data' ;
modeltype SERV uses 'http://www.example.org/xcore/service' ;
modeltype BEHA uses 'http://www.example.org/xcore/behavior' ;

--------------------------------------------------------------------------------
-- 1. LEMMA NAMED ELEMENT PRINT INFO (Unified signature matching DactUtils)
--------------------------------------------------------------------------------

-- Helper to print info of a BEHA NamedElement without specialTag
query BEHA::NamedElement::printInfo(ntabs: Integer): String {
    return self.printInfo(ntabs, '');
}

-- Specialized printInfo query with specialTag and category markers
query BEHA::NamedElement::printInfo(ntabs: Integer, specialTag: String): String {
	
    -- 1. Extract Element Name
    var memberName : String;
    if (self.oclIsKindOf(BEHA::CallOperationAction)){
      memberName := self.oclAsType(BEHA::CallOperationAction).getQualifiedName();
    } else{
      memberName := if self.name.oclIsUndefined() or self.name = '' 
                               then '<Anonymous>' 
                               else self.name 
                               endif;
    };                           
    -- 2. Extract Metamodel Concrete Type
    var memberType : String := self.metaClassName();
    
    -- 3. Determine Category Marker
    var mark := switch {
        case (self.oclIsKindOf(BEHA::Activity)) "^";
        case (self.oclIsKindOf(BEHA::ActivityGroup)) "&";
        case (self.oclIsKindOf(BEHA::ActivityNode)) "*";
        case (self.oclIsKindOf(SERV::Parameter)) "%";
        case (self.oclIsKindOf(BEHA::Variable)) "#";
        else "?";
    };
    
    -- 4. Construct Output Log String
    var toPrint : String;
    if (specialTag <> '') then {
        toPrint := indent(ntabs) + 
            '[' + mark + '] ' + specialTag + ': ' + memberName + ' | Type: ' + memberType;
    } else {
        toPrint := indent(ntabs) + 
            '[' + mark + '] ' + memberType + ': ' + memberName;
    } endif;
    
    log(toPrint);
    return toPrint;
}

--------------------------------------------------------------------------------
-- 2. LEMMA SPECIFIC PRINT INFO OVERRIDES
--------------------------------------------------------------------------------

query BEHA::Activity::printInfoFull(ntabs : Integer) {
    self.printInfo(ntabs);

    if (not self.specification.oclIsUndefined()) then {
        self.specification.printInfo(ntabs + 1, "Specification");
    } endif;

    -- Owned Parameters
    self.ownedParameters->forEach(param) {
        param.printInfo(ntabs + 1);
    };

    -- Parameter Mappings
    self.parameterMappings->forEach(pm) {
        pm.printInfo(ntabs + 1);
    };

    -- Root Group
    if (not self.root.oclIsUndefined()) then {
        self.root.printInfo(ntabs + 1);
    } endif;
}

query BEHA::ActivityGroup::printInfo(ntabs : Integer): String {
    var groupName := if (not self.name.oclIsUndefined()) then self.name else "RootGroup" endif;
    var toPrint := indent(ntabs) + "[&] ActivityGroup: " + groupName;
    log(toPrint);

//    -- Nodes
