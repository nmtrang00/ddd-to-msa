import DactPreprocess;
import DactToLemmaData;
import DactToLemmaService;
import DactToLemmaBehavior;
import LemmaRefine;

modeltype DACT uses 'http://www.example.org/xcore/dact';
modeltype DATA uses 'http://www.example.org/xcore/data';
modeltype SERVICE uses 'http://www.example.org/xcore/service';
modeltype BEHA uses 'http://www.example.org/xcore/behavior';

transformation index(
	in dact : DACT, 
	out preprocessedDact: DACT, 
	out data : DATA, 
	out service: SERVICE,
	out behavior: BEHA,
	out refinedBehavior: BEHA
);
configuration property PROJECT_NAME : String;

main() {
	log("PROJECT " + PROJECT_NAME +": Start parsing");
	// Preprocess DACT
	var dactPreprocessTrans = new DactPreprocess(dact,preprocessedDact).transform();
	assert fatal (dactPreprocessTrans.failed() = false) 
        with log("Stopping pipeline due to error in DactPreprocessing");
        
	// Transform DACT to LEMMA Data
	var dactToLemmaData := new DactToLemmaData(preprocessedDact,data);
	dactToLemmaData.PROJECT_NAME := PROJECT_NAME;
	var dactToLemmaDataTrans := dactToLemmaData.transform();
	assert fatal (dactToLemmaDataTrans.failed() = false) 
        with log("Stopping pipeline due to error in DactToLemmaData");
        
	// Transform DACT to LEMMA Service
	var dactToLemmaService := new DactToLemmaService(preprocessedDact,data,service);
	dactToLemmaService.PROJECT_NAME := PROJECT_NAME;
	var dactToLemmaServiceTrans := dactToLemmaService.transform();
	assert fatal (dactToLemmaServiceTrans.failed() = false) 
        with log("Stopping pipeline due to error in DactToLemmaService");
        
	// Transform DACT to LEMMA Behavior
	var dactToLemmaBehavior := new DactToLemmaBehavior(preprocessedDact,data,service,behavior);
	dactToLemmaBehavior.PROJECT_NAME := PROJECT_NAME;
	var dactToLemmaBehaviorTrans := dactToLemmaBehavior.transform();
	assert fatal (dactToLemmaBehaviorTrans.failed() = false) 
        with log("Stopping pipeline due to error in DactToLemmaBehavior");
        
	// Refine LEMMA Behavior
	var lemmaRefine := new LemmaRefine(data,service,behavior,refinedBehavior);
	lemmaRefine.PROJECT_NAME := PROJECT_NAME;
	var lemmaRefineTrans := lemmaRefine.transform();
	assert fatal (lemmaRefineTrans.failed() = false) 
        with log("Stopping pipeline due to error in LemmaRefine");
	
	log("DONE!");
}