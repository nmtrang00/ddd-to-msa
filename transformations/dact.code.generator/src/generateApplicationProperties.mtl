[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generateApplicationProperties('http://www.example.org/xcore/service')/]

[import stringUtils/]

[comment @main/]
[template public generateApplicationProperties(serviceModel : service::ServiceModel)]
[let microservices : Sequence(service::Microservice) = serviceModel.microservices
]
[for (ms : service::Microservice| microservices->select(ms|ms.type = service::MicroserviceType::FUNCTIONAL))]
[ms.generateApplicationPropertiesPerService(microservices)/]
[/for]
[serviceModel.generateReadme(microservices)/]
[/let]
[/template]

[template public generateReadme(
	serviceModel: service::ServiceModel,
	microservices : Sequence(service::Microservice)
)]
[file ('README.md', overwrite, 'UTF-8')]
[for (ms: service::Microservice|microservices)]
[let msPort : Integer = ms.getPort(microservices),
  projectName : String = ms.name.toCamelCase()
]
  # '[projectName.toUpper()/]' Microservice
  ```bash
  cd [projectName/]-service
  
  # Test 
  mvn clean test -e
  
  # Deploy locally
  mvn clean spring-boot:run
  
  # Service API
  http://localhost:[msPort/]
  
  # Access swagger/swagger-ui.html
  http://localhost:[msPort/]/swagger-ui/index.html
  
  # Access H2 Database
  http://localhost:[msPort/]/h2-console
  ```
  
[/let]
[/for]
[/file]
[/template]

[template public generateApplicationPropertiesPerService(
  ms : service::Microservice,
  microservices : Sequence(service::Microservice)
)]
  	[let projectName : String = ms.name.toCamelCase()]
	[file (projectName+'-service/src/main/resources/application.properties', overwrite, 'UTF-8')]
	  spring.application.name=[projectName/]
	
	  # Enable H2 Console so you can view the DB in your browser
	  spring.h2.console.enabled=true
	  spring.h2.console.path=/h2-console
	
	  # Database Connection Settings
	  spring.datasource.url=jdbc:h2:mem:testdb
	  spring.datasource.driverClassName=org.h2.Driver
	  spring.datasource.username=sa
	  spring.datasource.password=123456
	
	  # Show SQL queries in the console log
	  spring.jpa.show-sql=true
	
	  # Services
	  server.port=${SERVER_PORT:[ms.getPort(microservices)/]}
	
	  # External Services Base URLs
	[for (otherMs | microservices -> reject(other|other = ms))]

	[let envVar : String = otherMs.name.toSnakeCase().toUpper(), 
     propKey : String = otherMs.name.toKebabCase(),
     targetPort: Integer = otherMs.getPort(microservices)]
	  services.[propKey/].url=${[envVar/]_URL:http://localhost:[targetPort/]}
	[/let]
	[/for]

	  # OpenAPI / Swagger UI Settings
	  springdoc.api-docs.path=/v3/api-docs
	  springdoc.swagger-ui.path=/swagger-ui.html
	  springdoc.swagger-ui.enabled=true
	  springdoc.api-docs.enabled=true
	  springdoc.group-configs['['/]0[']'/].group=default
	  springdoc.group-configs['['/]0[']'/].paths-to-match=/**
	  springdoc.group-configs['['/]0[']'/].packages-to-scan=com.example.[ms.name.toLower()/].controller

	[/file]
	[/let]
[/template]

[query public getPort(target: service::Microservice,microservices: Sequence(service::Microservice), ): Integer = 
	8080 + microservices->indexOf(target)/]
