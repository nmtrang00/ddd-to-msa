[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 * @author trangnguyen
 * @version 1.0.0
 * @since 1.0.0
 */]
[module generatePayloads('http://www.example.org/xcore/data',
'http://www.example.org/xcore/service'
)/]

[import stringUtils/]
[import lemmaDataUtils/]
[import lemmaServiceUtils/]


[comment @main/]
[template public generatePayloads(dataModel: data::DataModel, serviceModel: service::ServiceModel)]
[for (context : data::Context | dataModel.getInternalFunctionalContexts(serviceModel))]
  	[let serviceName : String = context.name.toCamelCase(), 
  		domainDir : String = serviceName+'-service/src/main/java/com/example/'+serviceName+'/payload/']
  	[comment Generate main payloads /]
    [for (complexType: data::ComplexType | context.complexTypes -> select(t|t.isPayload()))]
      	  [let filePath: String = domainDir + complexType.name.toUpperFirst()+'.java']
          [complexType.oclAsType(data::DataStructure).generatePayload(filePath, serviceName)/]
		  [/let]
	[/for]
	[comment Generate default message response template /]
	[let filePath: String = domainDir +'MessageResponse.java']
	[context.generateMessageResponse(filePath, serviceName)/]
	[/let]
	[/let]
[/for]
[/template]

[comment -- Specific template for Payload --/]
[template public generatePayload(p : data::DataStructure,filePath: String,serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].payload;
  
  //Autogenerated code for Payload: [p.name/]
[comment for (typeToImport | p.getDomainTypeToImports())/]
[comment currently import all fix to import only used type later /]
  import com.example.[serviceName/].domain.*;
[comment /for /]  
  import lombok.Data;
  import lombok.NoArgsConstructor;
  [if (p.dataFields -> size() > 0)]
    import lombok.AllArgsConstructor;
  [/if]
  [if (p.hasNotNullField())]
    import jakarta.validation.constraints.NotNull;
  [/if]
  [if (p.hasCollectionField())]
    import java.util.List;
  [/if]
  
  @Data
  @NoArgsConstructor
[if (p.dataFields -> size() > 0)]
  @AllArgsConstructor
[/if]
  public class [p.name/] {
[for (field: data::DataField | p.dataFields)]
[if (field.lowerBound > 0)]
    @NotNull(message="'[field.name.camelToSnake()/]' cannot be null")
[/if]
[if (field.primitiveType <> null)]
[comment Primitive Datafield/]
    public [field.primitiveType.toJavaType()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::Enumeration))]
    public [field.complexType.name.toUpperFirst()/] [field.name/];
[elseif (field.complexType.oclIsKindOf(data::CollectionType))]
[field.generateCollectionField()/]
[elseif (field.complexType.oclIsKindOf(data::DataStructure))]
[comment DataStructure Datafield/]
[field.generateDataStructureField()/]
[/if]
[/for]
  }
[/file]
[/template]

[template public generateCollectionField(field: data::DataField)]
[let ftype : data::CollectionType = field.complexType.oclAsType(data::CollectionType)]
[if (ftype.dataFields ->size() > 0)]
    public List<[ftype.dataFields->first().name.toUpperFirst()/]> [field.name/];
[else]
    public List<[ftype.primitiveType.toJavaType()/]> [field.name/];
[/if]
[/let]
[/template]

[template public generateDataStructureField(field: data::DataField)]
      public [field.complexType.name.toUpperFirst()/] [field.name/];
[/template]

[template public generateMessageResponse(context: data::Context , filePath: String, serviceName: String)]
[file (filePath, overwrite, 'UTF-8')]
  package com.example.[serviceName/].payload;

  import lombok.Data;
  import lombok.Getter;
  import lombok.Setter;

  @Setter
  @Getter
  @Data
  public class MessageResponse {
      String message;
      Boolean success;
      Object data;
      String error;
    
      public MessageResponse(String message, Boolean success, Object data) {
          this.message = message;
          this.success = success;
          this.data = data;
      }
      
      public MessageResponse(String message, Boolean success, String error) {
          this.message = message;
          this.success = success;
          this.error = error;
      }
  }
[/file]
[/template]
