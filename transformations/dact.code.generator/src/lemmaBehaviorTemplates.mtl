[comment encoding = UTF-8 /]
[module lemmaBehaviorTemplates(
	'http://www.example.org/xcore/data',
	'http://www.example.org/xcore/service',
	'http://www.example.org/xcore/behavior',
	'http://www.example.org/xcore/technology'
)/]

[import stringUtils/]
[import lemmaDataUtils/]
[import lemmaServiceUtils/]
[import lemmaExprTemplates/]
[import dact::code::generator::utils::BehaviorUtils /]

[template public generateDefaultBody(op: service::Operation)]
[let outParams: Sequence(data::Parameter) = op.getOutParams()]
[if (outParams -> size() > 0)]
  return null;
[/if]
[/let]
[/template]

[template public generateDefaultBody(op: data::DataOperation)]
[let outParams: Sequence(data::DataOperationParameter) = op.getOutParams()]
[if (outParams -> size() > 0)]
  return null;
[/if]
[/let]
[/template]

[template public generateMethodBody(activity : behavior::Activity)]
[let initNode : behavior::InitialNode = activity.root.ownedNodes->filter(behavior::InitialNode)->first()]
[if (initNode != null)]
  // InitialNode: [initNode.name/]
[initNode.sEdge.target.generateNode()/]
[/if]
[/let]
[/template]

[comment Handle Raise Exception Actions /]
[template public generateNode(node : behavior::RaiseExceptionAction)]
[let exception : data::DataStructure = node._exception.type.oclAsType(data::DataStructure)]
  // RaiseExceptionAction: [exception.name /]
  throw new [exception.generateType()/]();
[/let]
[/template]

[comment Fallback dispatch for generic nodes /]
[template public generateNode(node : behavior::ActivityNode)]
[comment Override this or handle unhandled node types /]
[/template]

[comment Handle Executable / CallOperationAction Nodes /]
[template public generateNode(node : behavior::CallOperationAction)]
  // CallOperationAction: [node.name/] 
[if (node.importedOperation.oclIsKindOf(behavior::ImportedInterfaceOperation))]
[let interfaceOp : service::Operation = node.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation]
[if (interfaceOp.operationType = service::OperationType::I0_INBOUND_GET)]
  [node.generateCallGetController()/]
[elseif (interfaceOp.operationType = service::OperationType::I1_INBOUND_PUT)]
  [node.generateCallPutController()/]
[elseif (interfaceOp.operationType = service::OperationType::I2_INBOUND_POST)]
  [node.generateCallPostController()/]
[elseif (interfaceOp.operationType = service::OperationType::I3_INBOUND_DELETE)]
  [node.generateCallDeleteController()/]
[else]
  [node.generateInternalOperation()/]
[/if]
[/let]
[else]
[let dataOp : data::DataOperation = node.importedOperation.oclAsType(behavior::ImportedDataOperation).operation]
[if (dataOp.operationType = data::OperationType::D0_CONSTRUCTOR)]
  [node.generateDataConstructor()/]
[else]
  [node.generateDataOperation()/]
[/if]
[/let]
[/if]

[if (node.sEdge != null)]
  //NEXT: [node.sEdge.name/]
[node.sEdge.target.generateNode()/]
[/if]
[/template]

[template public generateDataConstructor(node: behavior::CallOperationAction)]
[let inMappings: Sequence(behavior::ParameterMapping) = node.getInParamMappings(),
	outMapping: behavior::ParameterMapping = node.getOutParamMappings()->first(),
	op : data::DataOperation = node.importedOperation.oclAsType(behavior::ImportedDataOperation).operation,
	opName : String = op.name.toUpperFirst()
]
  [if (outMapping != null)][if (node.toDeclareResult)][outMapping.operationParameter.getType().generateType()/][/if] [outMapping.identifier.name/] = [/if]new [opName/]([op.generateConstructorInput(inMappings)/]);
[/let] 
[/template]

[template public generateDataOperation(node: behavior::CallOperationAction)]
[let inMappings: Sequence(behavior::ParameterMapping) = node.getInParamMappings(),
	outMapping: behavior::ParameterMapping = node.getOutParamMappings()->first(),
	op : data::DataOperation = node.importedOperation.oclAsType(behavior::ImportedDataOperation).operation,
	opName : String = op.name,
	selfMapping : behavior::ParameterMapping = op.getSelfMapping(inMappings)
]
  [if (outMapping != null)][if (node.toDeclareResult)][outMapping.operationParameter.getType().generateType()/][/if] [outMapping.identifier.name/] = [/if] [selfMapping.identifier.name/].[opName/]([op.generateDataOperationInput(inMappings)/]);
[/let] 
[/template]

[query public getSelfMapping(op: data::DataOperation, mappings: Sequence(behavior::ParameterMapping)): behavior::ParameterMapping =
  mappings
	-> select(mp|mp.operationParameter.oclAsType(behavior::ImportedDataParameter).parameter.name = 'self')
	-> first()
/]

[template public generateInternalOperation(node : behavior::CallOperationAction)]
[let inMappings: Sequence(behavior::ParameterMapping) = node.getInParamMappings(),
	outMapping: behavior::ParameterMapping = node.getOutParamMappings()->first(),
	op : service::Operation = node.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation,
	interface: service::Interface = op.interface,
	parentInterface : service::Interface = node.getParentInterface(),
	targetObject : String = if (interface = parentInterface or interface.name = parentInterface.name) then 'this' else interface.name.toLowerFirst() endif,
	opName : String = if (op.operationType = service::OperationType::R0_REPOSITORY_CREATE or op.operationType = service::OperationType::R2_REPOSITORY_UPDATE) then 'save' else op.name endif
]
  [if (outMapping != null)][if (node.toDeclareResult)][outMapping.operationParameter.getType().generateType()/] [/if][outMapping.identifier.name/] = [/if][targetObject/].[opName/]([op.generateOperationInput(inMappings)/]);
[/let]
[/template]

[query public getMappedName(m: behavior::ParameterMapping): String = 
	if m.identifier != null then m.identifier.name
	else m.activityParameter.name
	endif
/]

[query public generateOperationInput(op: service::Operation, mappings: Sequence(behavior::ParameterMapping)): String =
	mappings
	->sortedBy(mp | mp.operationParameter.oclAsType(behavior::ImportedInterfaceParameter).parameter.name)
	->collect(mp | mp.identifier.formatIdentifierName())
    ->sep(', ')
    ->toString()
/]

[query public generateConstructorInput(op: data::DataOperation, mappings: Sequence(behavior::ParameterMapping)): String =
	mappings
	->sortedBy(mp | mp.operationParameter.oclAsType(behavior::ImportedDataParameter).parameter.name)
    ->collect(mp | mp.identifier.formatIdentifierName())
    ->sep(', ')
    ->toString()
/]

[query public generateDataOperationInput(op: data::DataOperation, mappings: Sequence(behavior::ParameterMapping)): String =
    let dataStructure: data::DataStructure = op.dataStructure in
    mappings
      ->sortedBy(mp | mp.operationParameter.oclAsType(behavior::ImportedDataParameter).parameter.name)
      ->select(mp | mp.operationParameter.oclAsType(behavior::ImportedDataParameter).parameter.name != 'self')
	    ->collect(mp | mp.identifier.formatIdentifierName())
	    ->sep(', ')
	    ->toString()
/]

[query public generateDataOperationTarget(op: data::DataOperation, mappings:  Sequence(behavior::ParameterMapping)): String =
	let dataStructure: data::DataStructure = op.dataStructure in
	mappings ->select(mp | mp.operationParameter.getType() != dataStructure)
	-> collect(mp | mp.identifier.formatIdentifierName())
    ->sep(', ')
    ->toString()
/]

[comment Handle Variable Declaration Actions /]
[template public generateNode(node : behavior::VariableDeclarationAction)]
[let scope : behavior::Scope = node.group.scope]
  // Declaration: [node.name/] 
[if (node.importedType != null)]
  [node.importedType.type.generateType()/] [node.declaration.generateVariableAssignment(scope)/];
[else]
  [node.primitiveType.toJavaType()/] [node.declaration.generateVariableAssignment(scope)/];
[/if]
[if (node.sEdge != null)]
[node.sEdge.target.generateNode()/]
[/if]
[/let]
[/template]

[template public generateVariableAssignment(a : behavior::VariableAssignment,scope: behavior::Scope)][a.identifier.name/][if (a.expr != null)] = [a.expr.generateExpression()/][else][a.identifier.generateInitValue(scope)/][/if][/template]

[query public generateInitValue(i : behavior::Identifier,scope: behavior::Scope): String =
	let matchedVar : behavior::Variable = i.name.getMatchedVariableByName(scope) in
	if matchedVar != null then
		let varType : data::Type = matchedVar.importedType.type in
		if varType.oclIsKindOf(data::DataStructure) 
		then ' = new ' + varType.generateType()+ '()'
		else ''
		endif
	else null 
	endif
/]
[comment Handle Variable Assignment Actions /]
[template public generateNode(node : behavior::VariableAssignmentAction)]
[let scope: behavior::Scope = node.group.scope,
	varType : data::Type = node.assignment.identifier.getRootType(node.group.scope),
	expr : behavior::Expression = node.assignment.expr]
  // Assignment: [node.name/]
[if (node.assignment.identifier.name.contains('.') and varType != null and varType.oclIsKindOf(data::DataStructure) and not varType.isPayload())]
[node.generateNestedAssignment(
    node.assignment.identifier.name.replaceFirst('self.', 'this.'), 
    node.assignment.expr.generateExpression(), 
    varType.oclAsType(data::DataStructure))/]
[else]
[node.assignment.generateVariableAssignment(scope)/];
[/if]
[/let]

[if (node.sEdge != null)]
[node.sEdge.target.generateNode()/]
[/if]
[/template]

[comment Helper Query to fetch Class type dynamically /]
[query public getPropertyType(targetType : data::DataStructure, propertyName : String) : data::Type =
    let property : data::DataField = targetType.dataFields->select(f | f.name = propertyName)->first() in
    if property != null then
        property.getType()
    else
        null
    endif
/]

[comment Helper Template: Generates getter chain cleanly without duplicating the root variable /]
[template public generateGetterChain(node : behavior::VariableAssignmentAction, parts : Sequence(String))]
[parts->at(1)/][if (parts->size() >1)].[for (part| parts->subSequence(2,parts->size())) separator('.')]get[part.toUpperFirst()/]()[/for][/if]
[/template]

[comment Core Nested Assignment Generator /]
[template public generateNestedAssignment(node : behavior::VariableAssignmentAction, lhs : String, rhs : String, rootDataStructure : data::DataStructure)]
[let parts : Sequence(String) = lhs.tokenize('.'),
     targetProp : String = parts->last(),
     parentParts : Sequence(String) = parts->subSequence(1, parts->size() - 1)
]
[if (parentParts->size() > 1)]
[for (i : Integer | Sequence{2, parentParts->size()})]
  [let subParts : Sequence(String) = parentParts->subSequence(1, i - 1),
       propertyName : String = parentParts->at(i),
       currentType : data::DataStructure = rootDataStructure.getNestedTypeAt(parentParts, i),
       propertyField : data::DataField = if currentType != null then currentType.dataFields->select(f | f.name = propertyName)->first() else null endif,
       propertyType : data::Type = if propertyField != null then propertyField.getType() else null endif,
       typeName : String = if propertyType != null then propertyType.generateType() else 'Object' endif
  ]
    if ([node.generateGetterChain(subParts).toSingleLine()/].get[propertyName.toUpperFirst()/]() == null) {
        [node.generateGetterChain(subParts).toSingleLine()/].set[propertyName.toUpperFirst()/](new [typeName/]());
    }
  [/let]
[/for]
[/if]
  [if (node.assignment.expr.evaluatedType.type.oclIsKindOf(data::CollectionType) and node.assignment.expr.oclIsKindOf(behavior::BinaryExpression))]
  [rhs.toSingleLine()/];
  [else]
  [node.generateGetterChain(parentParts).toSingleLine()/].set[targetProp.toUpperFirst()/]([rhs.toSingleLine()/]);
  [/if]
[/let]
[/template]

[comment Helper Query: Returns the DataStructure containing the property at targetIndex /]
[query public getNestedTypeAt(targetType : data::DataStructure, parts : Sequence(String), targetIndex : Integer) : data::DataStructure =
    if targetIndex <= 1 or targetType == null then
        targetType
    else
        targetType.getNestedTypeAtRecursive(parts, 2, targetIndex)
    endif
/]

[query private getNestedTypeAtRecursive(currentType : data::DataStructure, parts : Sequence(String), currentIndex : Integer, targetIndex : Integer) : data::DataStructure =
    if currentType = null then
        null
    else 
        if currentIndex >= targetIndex then
            currentType
        else
            let propName : String = parts->at(currentIndex) in
            let prop : data::DataField = currentType.dataFields->select(f | f.name = propName)->first() in
            if prop <> null and prop.getType() <> null and prop.getType().oclIsKindOf(data::DataStructure) then
                prop.getType().oclAsType(data::DataStructure).getNestedTypeAtRecursive(parts, currentIndex + 1, targetIndex)
            else
                null
            endif
        endif
    endif
/]

[comment Handle Conditional Branching Nodes /]
[template public generateNode(node : behavior::ConditionalNode)]
[comment Case 1: Main body is missing/undefined, but elseBody is present -> invert test condition /]
[if (node.body = null and node.elseBody != null)]
  // ConditionalNode (inverted): [node.name/]
  if (!([node.test.generateExpression().toSingleLine()/])) {
      [let elseInit : behavior::InitialNode = node.elseBody.ownedNodes->filter(behavior::InitialNode)->first()]
      [if (elseInit != null)]
      [elseInit.sEdge.target.generateNode()/]
      [/if]
      [/let]
  }
  [comment Case 2: Main body exists /]
[elseif (node.body != null)]
  // ConditionalNode: [node.name/]
  if ([node.test.generateExpression().toSingleLine()/]) {
      [let bodyInit : behavior::InitialNode = node.body.ownedNodes->filter(behavior::InitialNode)->first()]
      [if (bodyInit != null)]
      [bodyInit.sEdge.target.generateNode()/]
      [/if]
      [/let]
  } 
  [if (node.elseBody != null)]else {
      [let elseInit : behavior::InitialNode = node.elseBody.ownedNodes->filter(behavior::InitialNode)->first()]
      [if (elseInit != null)]
      [elseInit.sEdge.target.generateNode()/]
      [/if]
      [/let]
  }[/if]
[/if]

[if (node.sEdge != null)]
[node.sEdge.target.generateNode()/]
[/if]
[/template]

[comment Handle Final Node (Termination of flow) /]
[template public generateNode(node : behavior::ActivityFinalNode)]
  return [for (v : behavior::Identifier | node.variablesToReturn) separator(', ')][v.name/][/for];
[/template]

[query public generateOutVariable(i: behavior::Identifier,scope: behavior::Scope): String= 
	let variable : behavior::Variable = i.name.getMatchedVariableByName(scope) in
	if  variable != null then 
		if variable.lowerBound = 0 and variable.importedType.type.oclIsKindOf(data::DataStructure) then
			'Optional.isNullable('+variable.name+')'
		else
			variable.name
		endif
	else 
		'void'
/]

[comment Helper Queries /]
[query public getName(p: behavior::ImportedParameter): String = 
	if (p.oclIsKindOf(behavior::ImportedDataParameter)) then 
		p.oclAsType(behavior::ImportedDataParameter).parameter.name
	else 
		p.oclAsType(behavior::ImportedInterfaceParameter).parameter.name
	endif
/]

[query public getType(p: behavior::ImportedParameter): data::Type = 
	if (p.oclIsKindOf(behavior::ImportedDataParameter)) then 
		if (p.oclAsType(behavior::ImportedDataParameter).parameter.complexType != null) then 
			p.oclAsType(behavior::ImportedDataParameter).parameter.complexType				
		else
			p.oclAsType(behavior::ImportedDataParameter).parameter.primitiveType
		endif
	else 
		if (p.oclAsType(behavior::ImportedInterfaceParameter).parameter.importedType != null) then 
			p.oclAsType(behavior::ImportedInterfaceParameter).parameter.importedType.type
		else 
			p.oclAsType(behavior::ImportedInterfaceParameter).parameter.primitiveType
		endif
	endif
/]

[query public getInParamMappings(action: behavior::CallOperationAction) : Sequence(behavior::ParameterMapping) =
action.parameterMappings
	-> select(mp | mp.type = behavior::ParameterMappingType::ACTION_IN)
/]


[query public getInParamMappingsByAdapterParamType(action: behavior::CallOperationAction, type :service::AdapterParameterType) : Sequence(behavior::ParameterMapping) =
action.parameterMappings
	-> select(mp | mp.type = behavior::ParameterMappingType::ACTION_IN and
		mp.operationParameter.oclAsType(behavior::ImportedInterfaceParameter).parameter.adapterParameterType = type
	)
/]

[query public getOutParamMappings(action: behavior::CallOperationAction) : Sequence(behavior::ParameterMapping) =
action.parameterMappings
	-> select(mp | mp.type = behavior::ParameterMappingType::ACTION_OUT)
/]

[query public getEndpoint(interface: service::Interface): String = 
  if not interface.endpoints->isEmpty() and not interface.endpoints->first().addresses->isEmpty() then
    interface.endpoints->first().addresses->first()
  else
    ''
  endif
/]

[query public getEndpoint(op: service::Operation): String = 
  if not op.endpoints->isEmpty() and not op.endpoints->first().addresses->isEmpty() then
    op.endpoints->first().addresses->first()
  else
    ''
  endif
/]

[comment ========================================== /]
[comment GET                                        /]
[comment ========================================== /]
[template public generateCallGetController(action: behavior::CallOperationAction)]
[let controllerOp : service::Operation = action.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation,
	controller : service::Interface = controllerOp.interface,
	remoteMs : service::Microservice = controller.microservice,
	controllerOutMp : behavior::ParameterMapping = action.getOutParamMappings()->first(),
	pathParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::PATH_PARAM),
	queryParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::QUERY_PARAM),
	responseType : data::Type = controllerOutMp.operationParameter.getType()
]
  org.springframework.web.util.UriComponentsBuilder builder = org.springframework.web.util.UriComponentsBuilder
      .fromUriString(this.[remoteMs.name.toLower()/]Url)
      .path("[controller.getEndpoint()/][controllerOp.getEndpoint()/]");

[for (qp : behavior::ParameterMapping | queryParams)]
  if ([qp.identifier.name/] != null) {
      builder.queryParam("[qp.operationParameter.getName()/]", [qp.identifier.name/]);
  }
[/for]

  java.net.URI targetUri = builder.buildAndExpand([for (pp : behavior::ParameterMapping | pathParams) separator(', ')][pp.identifier.name/][/for]).toUri();
  
  [responseType.generateType()/] [controllerOutMp.identifier.name/] = restTemplate.getForObject(
      targetUri,
      [responseType.generateType()/].class
  );
  log.info("Result retrieved successfully from '[remoteMs.name/]' service: {}", [controllerOutMp.identifier.name/]);
[/let]
[/template]

[comment ========================================== /]
[comment POST                                       /]
[comment ========================================== /]
[template public generateCallPostController(action: behavior::CallOperationAction)]
[let controllerOp : service::Operation = action.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation,
	controller : service::Interface = controllerOp.interface,
	remoteMs : service::Microservice = controller.microservice,
	controllerOutMp : behavior::ParameterMapping = action.getOutParamMappings()->first(),
	pathParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::PATH_PARAM),
	queryParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::QUERY_PARAM),
	bodyParam : behavior::ParameterMapping = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::REQUEST_BODY)->first(),
	responseType : data::Type = if (controllerOutMp != null) then controllerOutMp.operationParameter.getType() else null endif
]
  org.springframework.web.util.UriComponentsBuilder builder = org.springframework.web.util.UriComponentsBuilder
      .fromUriString(this.[remoteMs.name.toLower()/]Url)
      .path("[controller.getEndpoint()/][controllerOp.getEndpoint()/]");

[for (qp : behavior::ParameterMapping | queryParams)]
  if ([qp.identifier.name/] != null) {
      builder.queryParam("[qp.operationParameter.getName()/]", [qp.identifier.name/]);
  }
[/for]

  java.net.URI targetUri = builder.buildAndExpand([for (pp : behavior::ParameterMapping | pathParams) separator(', ')][pp.identifier.name/][/for]).toUri();

[if (controllerOutMp != null)]
  [responseType.generateType()/] [controllerOutMp.identifier.name/] = restTemplate.postForObject(
      targetUri,
      [if (bodyParam != null)][bodyParam.identifier.name/][else]null[/if],
      [responseType.generateType()/].class
  );
  log.info("Successfully executed POST to '[remoteMs.name/]' service, returned: {}", [controllerOutMp.identifier.name/]);
[else]
  restTemplate.postForLocation(
      targetUri,
      [if (bodyParam != null)][bodyParam.identifier.name/][else]null[/if]
  );
  log.info("Successfully executed POST to '[remoteMs.name/]' service");
[/if]
[/let]
[/template]

[comment ========================================== /]
[comment PUT                                        /]
[comment ========================================== /]
[template public generateCallPutController(action: behavior::CallOperationAction)]
[let controllerOp : service::Operation = action.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation,
	controller : service::Interface = controllerOp.interface,
	remoteMs : service::Microservice = controller.microservice,
	pathParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::PATH_PARAM),
	queryParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::QUERY_PARAM),
	bodyParam : behavior::ParameterMapping = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::REQUEST_BODY)->first()
]
  org.springframework.web.util.UriComponentsBuilder builder = org.springframework.web.util.UriComponentsBuilder
      .fromUriString(this.[remoteMs.name.toLower()/]Url)
      .path("[controller.getEndpoint()/][controllerOp.getEndpoint()/]");

[for (qp : behavior::ParameterMapping | queryParams)]
  if ([qp.identifier.name/] != null) {
      builder.queryParam("[qp.operationParameter.getName()/]", [qp.identifier.name/]);
  }
[/for]

  java.net.URI targetUri = builder.buildAndExpand([for (pp : behavior::ParameterMapping | pathParams) separator(', ')][pp.identifier.name/][/for]).toUri();

  restTemplate.put(
      targetUri,
      [if (bodyParam != null)][bodyParam.identifier.name/][else]null[/if]
  );
  log.info("Successfully updated record via PUT in '[remoteMs.name/]' service");
[/let]
[/template]

[comment ========================================== /]
[comment DELETE                                     /]
[comment ========================================== /]
[template public generateCallDeleteController(action: behavior::CallOperationAction)]
[let controllerOp : service::Operation = action.importedOperation.oclAsType(behavior::ImportedInterfaceOperation).operation,
	controller : service::Interface = controllerOp.interface,
	remoteMs : service::Microservice = controller.microservice,
	pathParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::PATH_PARAM),
	queryParams : Sequence(behavior::ParameterMapping) = action.getInParamMappingsByAdapterParamType(service::AdapterParameterType::QUERY_PARAM)
]
  org.springframework.web.util.UriComponentsBuilder builder = org.springframework.web.util.UriComponentsBuilder
      .fromUriString(this.[remoteMs.name.toLower()/]Url)
      .path("[controller.getEndpoint()/][controllerOp.getEndpoint()/]");

[for (qp : behavior::ParameterMapping | queryParams)]
  if ([qp.identifier.name/] != null) {
      builder.queryParam("[qp.operationParameter.getName()/]", [qp.identifier.name/]);
  }
[/for]

  java.net.URI targetUri = builder.buildAndExpand([for (pp : behavior::ParameterMapping | pathParams) separator(', ')][pp.identifier.name/][/for]).toUri();

  restTemplate.delete(targetUri);
  log.info("Successfully deleted resource in '[remoteMs.name/]' service");
[/let]
[/template]
